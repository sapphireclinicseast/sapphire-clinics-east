{
  "name": "nickel-native",
  "version": "1.0.0",
  "private": true,
  "description": "Native app shell (iOS + Android) for Nickel — wraps nickelcare.com via Capacitor.",
  "scripts": {
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#34618c' --iconBackgroundColorDark '#34618c' --splashBackgroundColor '#34618c' --splashBackgroundColorDark '#1e4b7d'",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "cap run ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
