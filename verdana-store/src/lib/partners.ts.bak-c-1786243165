// patientToys = discount % the clinic can pass to its patients (Toys only).
export interface Tier {
  key: 'PLATINUM' | 'GOLD' | 'SILVER'
  name: string
  annualFee: number
  clinicToys: number
  clinicBulky: number
  patientToys: number
}

