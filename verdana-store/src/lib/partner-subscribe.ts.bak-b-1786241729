// Activates a partner subscription once PayMongo confirms payment: generates the
// two discount codes (patient + clinic/consultant), one-year expiry, and flips the
// partner to active. Called from the PayMongo webhook. SERVER-ONLY.

import { readPartners, writePartners, TIERS, type Tier } from './partners'
import { addVouchers, codeExists, type Voucher } from './vouchers'
import { randomBytes } from 'crypto'

const ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789' // no ambiguous 0/O/1/I

function randCode(prefix: string): string {
  const b = randomBytes(6)
  let s = ''
  for (let i = 0; i < 6; i++) s += ALPHABET[b[i] % ALPHABET.length]
  return `${prefix}-${s}`
}

async function uniqueCode(prefix: string): Promise<string> {
  for (let i = 0; i < 25; i++) {
    const c = randCode(prefix)
    if (!(await codeExists(c))) return c
  }
  return randCode(`${prefix}X`)
}

export async function activatePartnerSubscription(
  partnerId: string,
  tierKey: Tier['key'],
  checkoutId: string,
): Promise<boolean> {
  const partners = await readPartners()
  const idx = partners.findIndex((p) => p.id === partnerId)
  if (idx === -1) {
    console.error('Partner subscription: partner not found', partnerId)
    return false
  }
  const p = partners[idx]

  // Idempotency: the same checkout won't double-activate / double-generate codes.
  if (p.paidAt && p.consultantCode && p.subscriptionStatus === 'active') {
    console.log('Partner subscription: already active, skipping', partnerId, checkoutId)
    return false
  }

  const tier = TIERS[tierKey]
  if (!tier) {
    console.error('Partner subscription: unknown tier', tierKey)
    return false
  }

  const patientCode = await uniqueCode('VERD-PAT')
  const clinicCode = await uniqueCode('VERD-CLI')

  const now = new Date()
  const exp = new Date(now)
  exp.setFullYear(exp.getFullYear() + 1)
  const expStr = exp.toISOString().slice(0, 10) // yyyy-mm-dd → codes auto-expire in 1 year

  const patientVoucher: Voucher = {
    code: patientCode, discountType: 'percent', discountValue: tier.patientToys, freeShipping: false,
    active: true, expiresAt: expStr, scope: 'patient', partnerId,
    categoryRates: { toys: tier.patientToys, bulky: 0 },
    description: `${tier.name} patient discount — ${p.institution}`,
  }
  const clinicVoucher: Voucher = {
    code: clinicCode, discountType: 'percent', discountValue: tier.clinicToys, freeShipping: false,
    active: true, expiresAt: expStr, scope: 'clinic', partnerId,
    categoryRates: { toys: tier.clinicToys, bulky: tier.clinicBulky },
    description: `${tier.name} clinic/consultant discount — ${p.institution}`,
  }
  await addVouchers([patientVoucher, clinicVoucher])

  partners[idx] = {
    ...p,
    tier: tierKey,
    subscriptionStatus: 'active',
    paidAt: now.toISOString(),
    expiresAt: exp.toISOString(),
    patientCode,
    consultantCode: clinicCode,
  }
  await writePartners(partners)
  console.log('Partner subscription activated:', partnerId, tierKey, patientCode, clinicCode)
  return true
}
