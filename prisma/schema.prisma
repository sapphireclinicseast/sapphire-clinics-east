generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MARKETING_ADMIN
  SBEA_ADMIN
  SBGH_ADMIN
  VERDANA_ADMIN
  SBEA_FRONT_DESK
  SBGH_FRONT_DESK
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum TemplateType {
  BIRTHDAY
  HOLIDAY
  GENERAL
}

enum PatientType {
  PEDIATRIC
  ADULT
}

enum Branch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  VERDANA_STORE
}

enum StaffDepartment {
  OT
  PT
  SLP
  SPED
  MD
  PSYCHOLOGY
  ORTHOSIS
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  passwordHash      String
  role              Role            @default(MARKETING_ADMIN)
  avatar            String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             ScheduledPost[]
  campaigns         EmailCampaign[]
  staff             Staff[]
}

model SocialAccount {
  id          String   @id @default(cuid())
  platform    Platform
  accessToken String
  accountId   String
  pageId      String?
  pageName    String?
  profileUrl  String?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduledPost {
  id          String     @id @default(cuid())
  content     String
  caption     String?
  imageUrl    String?
  mediaType   String?    // 'image' | 'video' — null treated as image
  platforms   Platform[]
  accountIds  String[]   @default([])
  scheduledAt DateTime
  status      PostStatus @default(DRAFT)
  errorMsg    String?
  publishedId String?
  userId      String
  createdBy   User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id         String       @id @default(cuid())
  type       TemplateType
  name       String
  config     Json
  previewUrl String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Patient {
  id          String      @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dob         DateTime?
  patientType PatientType
  branch      Branch?          // legacy single-branch (kept for backward compat)
  branches    Branch[]    @default([])  // multi-branch (primary)
  sex         String?
  civilStatus String?
  religion    String?
  nationality String?
  address     String?          // full address or barangay
  city        String?          // city/municipality (for map choropleth)
  diagnosis   String?
  notes       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  schedules           Schedule[]
  viberSubscriptions  ViberSubscription[]
  surveyAssignments   SurveyAssignment[]
}

// ── Viber Bot subscriptions ────────────────────────────────────────────────────
// Populated when a patient messages the clinic Viber bot and provides their phone.
// Used to send appointment reminders via Viber instead of SMS.
model ViberSubscription {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  viberUserId String   @unique          // Viber's internal user ID for this subscriber
  branch      String                    // "SBEA" | "SBGH"
  createdAt   DateTime @default(now())

  @@unique([patientId, branch])
}

model EmailCampaign {
  id             String    @id @default(cuid())
  subject        String
  body           String
  recipientGroup String
  status         String    @default("draft")
  recipientCount Int       @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  gmailAccountId String?
  userId         String
  createdBy      User      @relation(fields: [userId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BrandGuide {
  id         String    @id @default(cuid())
  name       String?   // e.g. "Sandbox Clinic", "Verdana Store"
  fileName   String
  fileUrl    String
  analyzedAt DateTime?
  styleJson  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model GmailAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  refreshToken String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CanvaAccount {
  id           String    @id @default(cuid())
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  canvaUserId  String?
  displayName  String?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Analytics {
  id          String   @id @default(cuid())
  platform    Platform
  date        DateTime
  reach       Int      @default(0)
  impressions Int      @default(0)
  engagement  Int      @default(0)
  followers   Int      @default(0)
  createdAt   DateTime @default(now())
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

model QueueAd {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String   // relative path under UPLOAD_DIR, e.g. "queue-ads/file.mp4"
  mimeType  String   // "video/mp4", "image/jpeg", etc.
  branch    String   @default("ALL")  // "ALL" | "SBEA" | "SBGH"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id          String          @id @default(cuid())
  firstName   String          // stored ALL CAPS
  lastName    String          // stored ALL CAPS
  email       String?
  phone       String?
  department  StaffDepartment
  branch      String          // "SBEA" | "SBGH"
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  schedules   Schedule[]
  surveyAssignments SurveyAssignment[]
  surveyResponses   SurveyResponse[]
  assessmentTargets AssessmentTarget[]
}

// ── Satisfaction Survey ──────────────────────────────────────────────────────

enum SurveyType {
  HR10  // Pedia Patient Satisfaction (age ≤ 17)
  HR11  // Adult Patient Satisfaction (age ≥ 18)
  HR12  // Admin/Front Desk Satisfaction
  HR16  // Group Therapy Satisfaction
}

enum SurveyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model SurveyAssignment {
  id          String       @id @default(cuid())
  staffId     String
  staff       Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    Schedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  patientId   String?
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  surveyType  SurveyType
  patientName String?
  patientAge  Int?
  branch      String       // "SBEA" | "SBGH"
  sessionType String?      // "individual" | "group"
  status      SurveyStatus @default(PENDING)
  assignedBy  String?
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  response    SurveyResponse?
}

model SurveyResponse {
  id              String           @id @default(cuid())
  assignmentId    String           @unique
  assignment      SurveyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  staffId         String
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  surveyType      SurveyType
  branch          String
  respondentName  String?
  respondentEmail String?
  respondentPhone String?
  responsesJson   Json
  submittedAt     DateTime         @default(now())
}

model AssessmentTarget {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  year        Int
  targetCount Int
  completed   Int    @default(0)

  @@unique([staffId, year])
}

model Schedule {
  id          String         @id @default(cuid())
  staffId     String
  staff       Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  date        DateTime
  startTime   String         // "08:00"
  endTime     String         // "09:00"
  duration    String         // "1h" | "1.5h" | "2h" | "custom"
  sessionType String
  status      ScheduleStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  surveyAssignments SurveyAssignment[]
}
