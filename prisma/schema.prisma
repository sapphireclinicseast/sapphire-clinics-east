generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}


// ── Follow-Up SMS Reminder ────────────────────────────────────────────────────
// Tracks SMS reminders sent from Patient Relationship → Follow Up tab.
// Uniqueness on (patientId, department) enforces one reminder per patient per
// department — so the UI can show a permanent "Sent" state after the first click.
model FollowUpReminder {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  department String   // "OT" | "PT" | "SLP" | "SPED" | "PSYCHOLOGY" | "MD"
  branch     String   // "SBEA" | "SBGH"
  message    String   // the actual SMS text sent
  sentBy     String?  // user id who clicked Send
  sentAt     DateTime @default(now())

  @@unique([patientId, department])
  @@index([patientId])
  @@index([sentAt])
}



// ── Patient Documents (Progress Reports, Initial Evaluations, etc.) ──────────
// Created by clinicians via teletherapy.sapphireclinicseast.org. The marketing
// hub front desk handles the lifecycle: Informed → Paid → Emailed.
enum PatientDocumentType {
  INITIAL_EVALUATION
  PROGRESS_REPORT
  OTHER_DOCUMENT
}

model PatientDocument {
  id                  String              @id @default(cuid())
  patientId           String
  patient             Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedById        String
  department          String
  documentType        PatientDocumentType
  fileName            String
  filePath            String
  mimeType            String
  description         String?
  scheduleId          String?
  // Psychology / MD reports are confidential by default — hidden from other
  // departments and the patient unless shared. Ignored for other departments.
  sharedWithOthers    Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  // Lifecycle timestamps
  informedFrontDeskAt DateTime?
  informedById        String?
  paidForAt           DateTime?
  paidById            String?
  emailedToPatientAt  DateTime?
  emailedById         String?
  // Legacy fields (used by teletherapy direct-send flow)
  sentToPatientAt     DateTime?
  sentToPatientBy     String?
  sentToPatientCc     String?

  @@index([patientId])
  @@index([patientId, department])
  @@index([documentType])
  @@index([createdAt])
  @@index([informedFrontDeskAt])
  @@index([emailedToPatientAt])
}


// ── Branch CC Emails ─────────────────────────────────────────────────────────
// Per-branch list of email addresses to CC when sending patient-facing emails
// (Progress Reports, Initial Evaluations, etc). Managed in Settings →
// Connected Accounts by the super admin (main@sapphireclinicseast.org).
// Schema mirrors the existing table created by the teletherapy app.
model BranchCCEmail {
  id          String   @id @default(cuid())
  branch      String   @unique  // 'SANDBOX_EAST' | 'SANDBOX_GREENHILLS' | 'VERDANA_STORE'
  email       String   // primary CC address (or comma-separated list)
  notes       String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

// ── HR Branch Registry (synced cache) ─────────────────────────────────────
// Local read-only cache of HR Platform's Branches Registry — HR Platform is
// the source of truth (see HR Platform's `modules/branches`). Populated via
// admin-triggered POST /api/branches/sync (full replace, same pattern as
// /api/staff/sync); read by unauthenticated GET /api/public/branches, which
// is what Class Portal and Client Portal hit through their booking-proxy
// relay. Do not edit rows here directly — edits belong in HR Platform.
model HrBranch {
  id                       String   @id // HR Platform's kebab-case branch id — the sync key
  shortCode                String
  aliases                  String[] @default([])
  // Per-system identity this branch maps to — null when it doesn't
  // participate in that system (e.g. Verdana has no ClassPortalBranch value).
  opsHubBranch             String?
  opsHubClassPortalBranch  String?
  acctHubBranch            String?
  acctHubServiceBranch     String?
  teletherapyBranch        String?
  name                     String
  brandName                String?
  tin                      String?
  address                  String?
  phone                    String?
  emailMain                String?
  emailHr                  String?
  emailAccounting          String?
  // Automation sender addresses — null means "fall back to emailHr, then
  // emailMain" (the consuming app's job, not the sync's). See HR Platform's
  // Branches Registry "Email Automation" section.
  emailPayslips            String?
  emailSchedules           String?
  emailSessionNotes        String?
  departmentsOffered       String[] @default([])
  operatingDays            String[] @default([])
  operatingHoursOpen       String?
  operatingHoursClose      String?
  active                   Boolean  @default(true)
  syncedAt                 DateTime @default(now())
}

enum Role {
  ADMIN
  MARKETING_ADMIN
  AHEA_ADMIN
  AHGH_ADMIN
  VERDANA_ADMIN
  AHEA_FRONT_DESK
  AHGH_FRONT_DESK
  // Read-only, locked to Clinic Utilization + Patient Dashboard only (see
  // (dashboard)/layout.tsx for the route gate) — clinician names appear as
  // initials on Clinic Utilization for this role.
  INVESTOR
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum TemplateType {
  BIRTHDAY
  HOLIDAY
  GENERAL
}

enum PatientType {
  PEDIATRIC
  ADULT
}

enum StaffDepartment {
  OT
  PT
  SLP
  SPED
  MD
  PSYCHOLOGY
  ORTHOSIS
  FRONT_DESK
  ADMINISTRATION
  PSYCHIATRY
  DEVELOPMENTAL_PEDIATRICIAN
  REHABILITATION_MEDICINE
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  passwordHash      String
  role              Role            @default(MARKETING_ADMIN)
  avatar            String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             ScheduledPost[]
  campaigns         EmailCampaign[]
  staff             Staff[]
}

model SocialAccount {
  id          String   @id @default(cuid())
  platform    Platform
  accessToken String
  accountId   String
  pageId      String?
  pageName    String?
  profileUrl  String?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduledPost {
  id          String     @id @default(cuid())
  content     String
  caption     String?
  imageUrl    String?
  imageUrls   String[]   @default([])   // all image URLs — for carousel posts
  mediaType   String?    // 'image' | 'video' — null treated as image
  platforms   Platform[]
  accountIds  String[]   @default([])
  scheduledAt DateTime
  status      PostStatus @default(DRAFT)
  errorMsg    String?
  publishedId String?
  userId      String
  createdBy   User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id         String       @id @default(cuid())
  type       TemplateType
  name       String
  config     Json
  previewUrl String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// NOTE: patient branches are plain strings, not a Prisma enum.
//
// They used to be `enum Branch`, which meant a branch created in HR Platform
// could never become a patient option without a schema change and a deploy —
// a Postgres enum cannot grow at runtime. Staff already stored its branches as
// text (Staff.branch / Staff.extraBranches), which is why interbranch staff
// worked and interbranch patients did not.
//
// Valid values are the `opsHubBranch` codes in the HrBranch registry, which
// syncs hourly from HR Platform. Validate against that (see
// @/lib/branch-options), never against a hardcoded list.

model Patient {
  id          String      @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  passwordHash String?         // optional self-service portal login (bcrypt); null = no portal account yet
  dob         DateTime?
  patientType PatientType
  branch      String?          // legacy single-branch (kept for backward compat)
  branches    String[]    @default([])  // multi-branch (primary)
  sex         String?
  civilStatus String?
  religion    String?
  nationality String?
  address     String?          // full address or barangay
  city        String?          // city/municipality (for map choropleth)
  diagnosis          String?
  notes              String?
  referralUrl        String?    // optional doctor's referral document URL
  pwdIdUrl           String?    // optional PWD ID photo URL
  firstDayOfConsult  DateTime?  // manual override: first day of consult/session (basis for cancellation reset & follow-up rules)
  pwdSeniorId        String?    // PWD or Senior Citizen ID Number (optional, for discount eligibility)
  username           String?    @unique  // portal login handle (siblings sharing an email get distinct usernames)
  profilePhoto       String?             // portal avatar, stored as a base64 data URL
  unsubscribed       Boolean    @default(false)  // opt-out from email campaigns
  smsUnsubscribed    Boolean    @default(false)  // opt-out from SMS marketing campaigns (does NOT block schedule reminders, birthdays, or clinical follow-ups)
  // Aura the Alpaca plush toy perk — one piece, given once, to VIP Digital
  // Wallet holders (checked live against Accounting Hub) or patients who've
  // reached 100 CONFIRMED sessions since 2026-04-01 (see /api/plush-toy-eligible).
  plushToyGivenAt    DateTime?
  plushToyGivenBy    String?    // front-desk User.name/id who marked it given
  createdAt          DateTime   @default(now())
  updatedAt           DateTime             @updatedAt
  schedules           Schedule[]
  viberSubscriptions  ViberSubscription[]
  surveyAssignments   SurveyAssignment[]
  deckingSlots        DeckingSlot[]
  referralTokens      ReferralUploadToken[]
  pwdIdTokens         PwdIdUploadToken[]
  cancellationLogs    CancellationLog[]
  noShowLogs          NoShowLog[]
  patientBookings     PatientBooking[]
  followUpReminders   FollowUpReminder[]
  documents           PatientDocument[]
  tickets             PatientTicket[]
  homeProgress        HomeProgressEntry[]
}

// Patient-submitted portal concern/support ticket. Patient files it from the
// portal "Concerns" widget; admin resolves it in the admin console; the
// resolution then shows in the patient's "My tickets".
model PatientTicket {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subject       String
  description   String
  screenshot    String?   // optional screenshot, base64 data URL
  status        String    @default("OPEN")   // OPEN | RESOLVED
  adminResponse String?   // reply shown to the patient when resolved
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
}

// Patient-created "Home Progress" log: a dated entry with remarks and one or
// more media files (voice / video / photo) the parent uploads or records at
// home. Visible to their clinicians in the CRM.
model HomeProgressEntry {
  id        String             @id @default(cuid())
  patientId String
  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime
  remarks   String?
  createdAt DateTime           @default(now())
  files     HomeProgressFile[]

  @@index([patientId])
}

model HomeProgressFile {
  id        String            @id @default(cuid())
  entryId   String
  entry     HomeProgressEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  kind      String            // AUDIO | VIDEO | PHOTO | OTHER
  fileName  String
  filePath  String            // relative path under ./uploads
  mimeType  String
  sizeBytes Int               @default(0)
  createdAt DateTime          @default(now())

  @@index([entryId])
}

model ReferralUploadToken {
  id        String   @id @default(cuid())
  token     String   @unique
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PwdIdUploadToken {
  id        String   @id @default(cuid())
  token     String   @unique
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Viber Bot subscriptions ────────────────────────────────────────────────────
// Populated when a patient messages the clinic Viber bot and provides their phone.
// Used to send appointment reminders via Viber instead of SMS.
model ViberSubscription {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  viberUserId String   @unique          // Viber's internal user ID for this subscriber
  branch      String                    // "SBEA" | "SBGH"
  createdAt   DateTime @default(now())

  @@unique([patientId, branch])
}

model EmailCampaign {
  id             String    @id @default(cuid())
  subject        String
  body           String
  recipientGroup String
  status         String    @default("draft")
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  nextTrancheAt   DateTime? @db.Timestamp(3)
  scheduledAt    DateTime?
  sentAt         DateTime?
  gmailAccountId String?
  // Comma-separated address(es) that get ONE copy of the campaign when it
  // starts sending — not a per-recipient Cc header (a 2,700-recipient send
  // would otherwise put 2,700 mails in the operator's inbox and expose the
  // address to every patient).
  ccEmails       String?
  userId         String
  createdBy      User      @relation(fields: [userId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BrandGuide {
  id         String    @id @default(cuid())
  name       String?   // e.g. "Sandbox Clinic", "Verdana Store"
  fileName   String
  fileUrl    String
  analyzedAt DateTime?
  styleJson  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model GmailAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  refreshToken String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CanvaAccount {
  id           String    @id @default(cuid())
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  canvaUserId  String?
  displayName  String?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Analytics {
  id          String   @id @default(cuid())
  platform    Platform
  date        DateTime
  reach       Int      @default(0)
  impressions Int      @default(0)
  engagement  Int      @default(0)
  followers   Int      @default(0)
  createdAt   DateTime @default(now())
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

model QueueAd {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String   // relative path under UPLOAD_DIR, e.g. "queue-ads/file.mp4"
  mimeType  String   // "video/mp4", "image/jpeg", etc.
  branch    String   @default("ALL")  // "ALL" | "SBEA" | "SBGH"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Minimal read model for the client-portal confidentiality gate. The full
// SessionNote table is owned by teletherapy; the ops hub only needs
// scheduleId + sharedWithOthers to hide Psychology/MD session notes from the
// patient (Client Hub) unless the author opted in. Only these columns are read.
model SessionNote {
  id               String  @id
  scheduleId       String  @unique
  sharedWithOthers Boolean @default(false)
}

model Staff {
  id              String          @id @default(cuid())
  employeeId      String?         // Employee ID from HR Platform
  firstName       String          // stored ALL CAPS
  lastName        String          // stored ALL CAPS
  email           String?
  phone           String?
  sex             String?         // "M" | "F" — shown in patient portal (icon only)
  department      StaffDepartment
  branch          String          // "SBEA" | "SBGH" — primary branch (from HR)
  extraBranches      String[]        @default([]) // additional branches; never overwritten by sync
  branchEmployment   Json            @default("{}") // per-branch employment: { SBEA: { employmentType, employeeId, department, jobTitle }, SBGH: {...} }
  // Per-branch role owned by Operations: {"SBEA":"consultant","SBGH":"employee"}. HR carries
  // a single employmentType, so this is set here and — like extraBranches — is never
  // overwritten by the HR sync. Absent/empty = use employmentType for every branch.
  employmentByBranch Json?
  dob             DateTime?       // Birthday — synced from HR Platform
  dateHired       DateTime?       // Date Hired ("Start Month" for interns) — synced from HR
                                   // Platform Staff Profile; used to exclude pre-hire days from
                                   // Therapist Utilization capacity
  contractExpiry  DateTime?       // Contract Expiration ("End Month" for interns) — synced from
                                   // HR Platform; gates the Clinic Schedule intern picker to only
                                   // currently-active interns
  jobTitle        String?         // HR Platform job title slug (e.g. "front-desk-officer")
  employmentType  String?         // "employee" | "consultant" | "intern"
  tin             String?         // TIN from HR Platform
  sss             String?         // SSS No. from HR Platform
  pagibig         String?         // Pag-IBIG No. from HR Platform
  philhealth      String?         // PhilHealth No. from HR Platform
  bankName        String?         // Bank Name from HR Platform
  bankAccountNo   String?         // Bank Account Number from HR Platform
  hrPlatformId    String?         // ID from HR Platform for sync matching
  active          Boolean         @default(true) // false = inactive in HR; hidden from Staff Module, Top 5, etc.
  isInternshipSupervisor Boolean  @default(false) // Clinical Internship Supervisor (HR Staff Profile
                                   // checkbox, synced one-way). Staff Portal reads this off the shared
                                   // DB to grant an "All Interns" view — every intern's notes, not just
                                   // this person's own decked interns.
  isClinicalMentor Boolean        @default(false) // Clinical Mentor (HR Staff Profile checkbox,
                                   // synced one-way, same pattern as isInternshipSupervisor above).
                                   // Narrower than the supervisor flag: grants visibility into only
                                   // the specific mentees below, not everyone.
  menteeIds        String[]       @default([]) // HR sends its OWN staff ids here; Ops Hub's sync
                                   // route translates them to THIS table's local Staff.id values
                                   // (same physical row Teletherapy reads) before writing — see
                                   // src/app/api/staff/sync/route.ts.
  createdById     String?
  createdBy       User?           @relation(fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  schedules       Schedule[]
  internSchedules Schedule[]      @relation("ScheduleIntern") // sessions this person did as an intern
  surveyAssignments SurveyAssignment[]
  surveyResponses   SurveyResponse[]
  assessmentTargets AssessmentTarget[]
  deckingConfigs  DeckingTherapistConfig[]
  deckingSlots    DeckingSlot[]
  peerEvalAssor       PeerEvalAssignment[] @relation("PeerEvalAssor")
  peerEvalAssee       PeerEvalAssignment[] @relation("PeerEvalAssee")
  peerEvalRespAssor   PeerEvalResponse[]   @relation("PeerEvalRespAssor")
  peerEvalRespAssee   PeerEvalResponse[]   @relation("PeerEvalRespAssee")
  peerEvalAdminConfig PeerEvalAdminConfig?
  peerEvalEmailLogs   PeerEvalEmailLog[]
  patientBookings     PatientBooking[]
}

// ── Satisfaction Survey ──────────────────────────────────────────────────────

enum SurveyType {
  HR10  // Pedia Patient Satisfaction (age ≤ 17)
  HR11  // Adult Patient Satisfaction (age ≥ 18)
  HR12  // Admin/Front Desk Satisfaction
  HR16  // Group Therapy Satisfaction
}

enum SurveyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model SurveyAssignment {
  id          String       @id @default(cuid())
  staffId     String
  staff       Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    Schedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  patientId   String?
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  surveyType  SurveyType
  patientName String?
  patientAge  Int?
  branch      String       // "SBEA" | "SBGH"
  sessionType String?      // "individual" | "group"
  status      SurveyStatus @default(PENDING)
  assignedBy  String?
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  response    SurveyResponse?
}

model SurveyResponse {
  id              String           @id @default(cuid())
  assignmentId    String           @unique
  assignment      SurveyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  staffId         String
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  surveyType      SurveyType
  branch          String
  respondentName  String?
  respondentEmail String?
  respondentPhone String?
  responsesJson   Json
  submittedAt     DateTime         @default(now())
}

model AssessmentTarget {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  year        Int
  targetCount Int
  completed   Int    @default(0)

  @@unique([staffId, year])
}

model Schedule {
  id          String         @id @default(cuid())
  staffId     String         // supervising therapist — whoever's card this was booked under
  staff       Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  date        DateTime
  startTime   String         // "08:00"
  endTime     String         // "09:00"
  duration    String         // "1h" | "1.5h" | "2h" | "custom"
  sessionType String
  status      ScheduleStatus @default(PENDING)
  notes       String?
  isTeletherapy Boolean @default(false)
  meetLink      String?
  // Which intern actually did the session, when sessionType is "IE Intern" /
  // "Session Intern" — the intern writes the note; staffId above stays the
  // supervisor. Null for every non-intern session.
  internStaffId String?
  internStaff   Staff?         @relation("ScheduleIntern", fields: [internStaffId], references: [id], onDelete: SetNull)
  // Where the session actually happens ("SBEA" | "SBGH" | "VER"), captured
  // from the branch calendar it was booked on. Interbranch clinicians hold one
  // staff profile pinned to a single branch, so staff.branch cannot attribute
  // their cross-branch sessions; this field can. Null = legacy row — consumers
  // (POS cashier queue) fall back to patient/staff-branch inference.
  branch        String?
  // Documentation age lock — owned by the staff portal (teletherapy), which
  // shares this physical table. Sessions past the documentation window are
  // read-only there until a clinician deliberately re-opens one; these record
  // that decision. Declared here purely to keep the two schemas in lockstep —
  // nothing in Operations Hub reads or writes them.
  // See teletherapy/src/lib/note-age-lock.ts.
  noteUnlockedAt   DateTime?
  noteUnlockedById String?
  createdAt     DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  surveyAssignments SurveyAssignment[]
}

// ── Decking Module ─────────────────────────────────────────────────────────────

model DeckingClinicHours {
  id        String   @id  // "SBEA" | "SBGH"
  schedule  Json     // { MON: { open: bool, openTime: "10:00", closeTime: "20:00" }, ... }
  updatedAt DateTime @updatedAt
}

model DeckingTherapistConfig {
  id         String   @id @default(cuid())
  // Interbranch staff need one config PER branch — staffId alone used to be
  // the unique key, so saving a secondary-branch schedule silently overwrote
  // the primary-branch one. (staffId, branch) is now the unique key instead.
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDays   Json     // ["MON", "TUE", "WED", "THU", "FRI"]
  startTime  String   // "10:00"
  endTime    String   // "20:00"
  useDefault Boolean  @default(true)
  branch     String
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([staffId, branch])
}

model DeckingSlot {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  patientId  String?
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  dayOfWeek  String   // "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT" | "SUN"
  startTime  String   // "10:00"
  endTime    String   // "11:00"
  branch     String
  department String
  notes      String?
  disabled   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patientBookings PatientBooking[]
}

// ── Clinic Capacity Settings (max daily sessions per dept per branch) ────────
model ClinicCapSettings {
  id           String   @id @default("default")
  seaOt        Int      @default(8)
  seaPt        Int      @default(8)
  seaSlp       Int      @default(8)
  seaSped      Int      @default(8)
  seaMd        Int      @default(8)
  seaPsych     Int      @default(8)
  seaOrthosis  Int      @default(8)
  sghOt        Int      @default(8)
  sghPt        Int      @default(8)
  sghSlp       Int      @default(8)
  sghSped      Int      @default(8)
  sghMd        Int      @default(8)
  sghPsych     Int      @default(8)
  sghOrthosis  Int      @default(8)
  updatedAt    DateTime @updatedAt
}

// ── Survey Settings (leaderboard metric weights) ─────────────────────────────
model SurveySettings {
  id                    String   @id @default("default")
  weightConfirmed       Int      @default(50)  // % weight for confirmed sessions
  weightRescheduled     Int      @default(0)   // % weight for rescheduled sessions
  weightCancelled       Int      @default(0)   // % weight for cancelled sessions (negative impact)
  weightSatisfaction    Int      @default(50)  // % weight for avg satisfaction score
  showLeaderboard       Boolean  @default(false) // Show leaderboard on TV queue display
  showComplaintForm     Boolean  @default(false) // Show patient complaint form QR on TV display
  updatedAt             DateTime @updatedAt
}

// ── Peer Evaluation ──────────────────────────────────────────────────────────

enum PeerEvalType {
  HR08_ADMIN
  HR08_PEER
  HR09_CLINICAL  // Clinical staff assess each admin staff member (≥10 assessors)
  HR09_ADMIN     // Admin peers assess each admin staff member (≥5 assessors)
}

enum PeerEvalStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model PeerEvalAssignment {
  id          String         @id @default(cuid())
  formType    PeerEvalType
  assessorId  String
  assesseeId  String
  branch      String
  periodYear  Int
  periodMonth Int            // 0 = full-year (HR08/HR09); 1-12 for monthly
  status      PeerEvalStatus @default(PENDING)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  assessor  Staff              @relation("PeerEvalAssor", fields: [assessorId], references: [id], onDelete: Cascade)
  assessee  Staff              @relation("PeerEvalAssee", fields: [assesseeId], references: [id], onDelete: Cascade)
  response  PeerEvalResponse?

  @@unique([assessorId, assesseeId, formType, periodYear, periodMonth])
}

model PeerEvalResponse {
  id           String             @id @default(cuid())
  assignmentId String             @unique
  assignment   PeerEvalAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assessorId   String
  assesseeId   String
  formType     PeerEvalType
  branch       String
  scores       Json
  strengths    String?
  improvements String?
  submittedAt  DateTime           @default(now())

  assessor Staff @relation("PeerEvalRespAssor", fields: [assessorId], references: [id], onDelete: Cascade)
  assessee Staff @relation("PeerEvalRespAssee", fields: [assesseeId], references: [id], onDelete: Cascade)
}

// ── Patient Cancellation Logs ─────────────────────────────────────────────────

model CancellationLog {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId         String?
  branch          String    // "SANDBOX_EAST" | "SANDBOX_GREENHILLS"
  type            String    // e.g. "Cancellation >24 hrs (VALID)"
  isValid         Boolean   @default(false)
  proofUrl        String?
  remarks         String?
  feeDeducted     Boolean   @default(false)
  feeDeductedAt   DateTime?
  feePaidOnReturn Boolean   @default(false)
  feePaidAt       DateTime?
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
  @@index([createdAt])
}

// ── Patient No-Show Logs ─────────────────────────────────────────────────────

model NoShowLog {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId         String?
  branch          String    // "SANDBOX_EAST" | "SANDBOX_GREENHILLS"
  remarks         String?
  feeDeducted     Boolean   @default(false)
  feeDeductedAt   DateTime?
  feePaidOnReturn Boolean   @default(false)
  feePaidAt       DateTime?
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
  @@index([createdAt])
}

// ── Peer Eval Admin Config (work-day schedule for admin/front-desk staff) ─────
// Used by HR09 assignment logic and the Settings tab.
model PeerEvalAdminConfig {
  id        String   @id @default(cuid())
  staffId   String   @unique
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workDays  Json     // ["MON","TUE","WED","THU","FRI"]
  branch    String   // "SBEA" | "SBGH"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Patient Appointment Portal (client.sapphireclinicseast.org) ──────────────

enum BookingStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
  COMPLETED
}

model PatientBooking {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId         String?
  staff           Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  deckingSlotId   String?
  deckingSlot     DeckingSlot?  @relation(fields: [deckingSlotId], references: [id], onDelete: SetNull)
  branch          String        // "SBEA" | "SBGH"
  department      String        // StaffDepartment string
  date            DateTime?     // actual appointment date (UTC date); null for teletherapy until assigned
  startTime       String        // "10:00"
  endTime         String        // "11:00"
  isTeletherapy   Boolean       @default(false)
  meetLink        String?
  notes           String?
  status          BookingStatus @default(PENDING)
  rejectionReason String?
  downpayment     Decimal?
  approvedAt      DateTime?
  approvedBy      String?
  paidAt          DateTime?
  alternateChoices Json?        // up to 2 alternates the patient offered; {staffId,date,startTime,endTime}[]
  source          String        @default("PORTAL")
  // Front-desk action flags (post-2026-05-18 self-service flow). When the
  // patient pays, the booking lands as PAID and the front desk just runs
  // these two follow-ups: add the patient to the recurring Decking grid
  // for that therapist, and tick that the downpayment was logged in
  // accounting-hub. Each button is one-shot — booleans disable after click.
  addedToDeck         Boolean   @default(false)
  accountingRecorded  Boolean   @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payment         PatientPayment?

  @@index([branch, department, date])
  @@index([status])
  @@index([patientId])
  @@index([staffId, date])
}

model PatientPayment {
  id             String         @id @default(cuid())
  bookingId      String         @unique
  booking        PatientBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount         Decimal
  currency       String         @default("PHP")
  paymongoLinkId String         @unique
  paymongoRef    String?
  checkoutUrl    String
  status         String         @default("pending")
  paidAt         DateTime?
  webhookPayload Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model SmsCampaign {
  id             String    @id
  subject        String
  message        String
  recipientGroup String
  branch         String
  department     String?
  status         String    @default("draft")
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  sentCountSbea  Int       @default(0)
  sentCountSbgh  Int       @default(0)
  nextTrancheAt  DateTime? @db.Timestamp(3)
  scheduledAt    DateTime?
  sentAt         DateTime?
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//   CLASS PORTAL — class.sapphireclinicseast.org (SCEI × LBCA SPED program)
//   Sibling app; tables prefixed ClassPortal* to avoid collisions.
// ─────────────────────────────────────────────────────────────────────────────

enum ClassPortalRole {
  STUDENT
  TEACHER
  FRONTDESK
  BRANCH_ADMIN
}

enum ClassPortalLevel {
  NURSERY
  KINDER
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum ClassPortalLrnStatus {
  NO_LRN
  WITH_LRN
  RETURNING
}

/// Class-portal users (teachers + students/parents). Admin is hardcoded
/// in the app, NOT stored here. Passwords are bcrypt'd.
model ClassPortalUser {
  id           String           @id @default(cuid())
  role         ClassPortalRole
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  level        ClassPortalLevel?
  /// Clinic branch this student is enrolled under. Null for teachers
  /// (their branch coverage lives in ClassPortalTeacherAssignment).
  branch       ClassPortalBranch?
  /// Snapshot of the parent-submitted enrollment form (JSON). For STUDENT
  /// rows only; null for TEACHER rows. Mirrors the EnrollmentDraft shape.
  enrollment   Json?
  /// Audit trail for password changes — who and when. Plaintext is NEVER
  /// stored; this is just so the admin list can show "Last reset by X on
  /// 2026-05-22" instead of the unhelpful "not on device" placeholder.
  passwordSetAt DateTime?
  passwordSetBy String?
  /// Soft-disable. When non-null, the user can't sign in and is hidden
  /// from teacher / front-desk / branch-admin views. Re-enabled by
  /// setting back to null. Hard delete is intentionally not exposed —
  /// disabled rows preserve enrollment history and payment audit trail.
  disabledAt   DateTime?
  /// Email of the admin who disabled the account. Cleared on re-enable.
  disabledBy   String?
  /// TEACHER accounts minted from an HR-hub intern row. When true, the
  /// class portal treats them as a regular teacher (same upload / edit
  /// permissions) but the intern-lifecycle cron will auto-disable the
  /// account 15 days after the end of the internship-end month tracked
  /// on the linked Staff row. Cleared to make it a permanent teacher.
  isIntern      Boolean          @default(false)
  /// Optional link to the ops-hub Staff row this account was created
  /// from. Powers the auto-disable cron (needs Staff.contractExpiry)
  /// and the Users-list badge that surfaces the intern's contract end
  /// date. Nullable so admins can still create teachers directly.
  linkedStaffId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([role, email])
  @@index([role])
  @@index([branch])
  @@index([disabledAt])
  @@index([isIntern])
  @@index([linkedStaffId])
}

enum ClassPortalEventType {
  CLASS_CANCELLED
  HOLIDAY
  FIELD_TRIP
  IEP_REVIEW
  EVENT
}

/// One row per calendar event. Spans a single date or a date range
/// (date..endDate inclusive) for multi-day items like field trips.
/// Per-branch — EAST and GREENHILLS each maintain their own set.
model ClassPortalCalendarEvent {
  id          String                @id @default(cuid())
  branch      ClassPortalBranch
  date        DateTime              @db.Date
  endDate     DateTime?             @db.Date
  title       String
  description String?
  type        ClassPortalEventType  @default(EVENT)
  createdBy   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([branch, date])
}

/// One PDF per branch — uploads replace the previous PDF for that
/// branch so admins always show the latest official calendar.
model ClassPortalCalendarPdf {
  id          String              @id @default(cuid())
  branch      ClassPortalBranch   @unique
  fileName    String
  mimeType    String              @default("application/pdf")
  data        Bytes
  uploadedBy  String
  uploadedAt  DateTime            @default(now())
}

enum ClassPortalBranch {
  EAST
  GREENHILLS
}

/// One row per (teacher, branch, grade level) pair. Lets a teacher serve
/// multiple branches with different grade-level loads in each.
model ClassPortalTeacherAssignment {
  id        String            @id @default(cuid())
  teacherId String
  branch    ClassPortalBranch
  level     ClassPortalLevel
  createdAt DateTime          @default(now())

  @@unique([teacherId, branch, level])
  @@index([branch])
  @@index([teacherId])
}

/// Per-grade-level enablement, admin-controlled. A missing row means the
/// level defaults to enabled — so the app works out-of-the-box without
/// admins explicitly turning on every level. Disabling a level only
/// affects NEW enrollments; existing students stay on the level.
model ClassPortalLevelStatus {
  level     ClassPortalLevel @id
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  updatedBy String?
}

/// Permanent server-side storage for parent-uploaded documents. Class
/// portal previously stored these only in the parent's IndexedDB, which
/// meant the partner school's /admission tracker couldn't view them.
/// Now every blob the parent uploads (PSA Birth Cert, Report Card SF9,
/// PWD ID, Parent Valid ID, Affidavit, etc.) lands here too, keyed by
/// (studentId, docKey). A new upload for the same slot replaces the
/// previous one. Files capped at 15 MB; bytea storage.
model ClassPortalDocumentBlob {
  id         String   @id @default(cuid())
  studentId  String
  /// One of: psa_birth_cert, child_photo_1x1, parent_valid_id, pwd_id,
  /// medical_reports, report_card_sf9, good_moral, form_137_sf10,
  /// affidavit_undertaking, school_id. Free-form string so new doc
  /// types can land without a schema change.
  docKey     String
  fileName   String
  fileType   String
  fileSize   Int
  fileData   Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, docKey])
  @@index([studentId])
}

/// QR-from-phone upload handoff. Desktop /documents creates a row + shows
/// a QR code that encodes /upload/<token>. The parent scans it on their
/// phone, picks/takes a photo, the phone POSTs the file body here. The
/// desktop polls this row's `uploadedAt`; once non-null, it pulls the
/// file blob, stores it in IndexedDB at the right doc slot, and deletes
/// this row. Tokens expire after 30 min.
model ClassPortalUploadToken {
  token        String    @id
  studentId    String
  studentEmail String
  /// Which document slot the upload targets (e.g. "psa_birth_cert",
  /// "parent_valid_id", "pwd_id"). Used by the desktop to know where to
  /// drop the blob once it pulls it back.
  docKey       String
  expiresAt    DateTime
  fileName     String?
  fileType     String?
  fileSize     Int?
  fileData     Bytes?
  uploadedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
  @@index([studentId])
}

/// Pending front-desk cash payment notifications from the class portal.
/// When a parent on /pay picks "Pay at front desk" + "Notify front desk",
/// the class portal POSTs a row here; the accounting hub's POS Cashier
/// picks them up via the existing /api/queue/external endpoint (they're
/// surfaced as virtual queue items so the cashier can "Convert to Order"
/// without any accounting hub code changes).
model ClassPortalFrontDeskPayment {
  id                   String            @id @default(cuid())
  /// Dedupe key: the class portal generates this and won't re-post if it
  /// already exists. Lets the parent retry the "Notify front desk" button
  /// without spawning duplicate cashier items.
  classPortalPaymentId String            @unique
  studentId            String
  studentEmail         String
  studentName          String
  branch               ClassPortalBranch
  plan                 String
  tuitionCentavos      Int
  miscCentavos         Int               @default(0)
  period               String
  status               String            @default("PENDING") // PENDING | CONVERTED | VOIDED
  /// FRONT_DESK_CASH | BANK_DEPOSIT | PAYMONGO. FRONT_DESK_CASH is a
  /// legacy enum value — the UI now labels it "Frontdesk payment" and
  /// uses `methodDetail` to record the actual instrument (cash, credit
  /// card, debit card, GCash, PayMaya). Bank deposit + PayMongo leave
  /// methodDetail null.
  method               String?
  /// Instrument detail. Only meaningful when method = FRONT_DESK_CASH;
  /// one of: CASH | CREDIT_CARD | DEBIT_CARD | GCASH | PAYMAYA. Null
  /// on legacy rows recorded before this column existed (treat as CASH
  /// in display logic).
  methodDetail         String?
  notes                String?
  createdAt            DateTime          @default(now())
  convertedAt          DateTime?

  @@index([branch, status])
  @@index([createdAt])
}

/// One row per issued school registration letter. Provides a unique
/// reference number (AURA-REG-YYYY-NNNN) and an audit trail for who
/// generated it for whom. The PDF itself is rendered client-side from
/// the live student + payment data, so no blob storage needed here —
/// regenerating the same row produces the same letter.
model ClassPortalRegistrationLetter {
  id               String   @id @default(cuid())
  referenceNumber  String   @unique          // AURA-REG-YYYY-NNNN
  studentId        String
  issuedBy         String                    // email of admin/frontdesk
  issuedAt         DateTime @default(now())
  /// Snapshot of the annual tuition + misc at the moment of issuance
  /// (centavos). Lets the same reference number always reproduce the
  /// numbers we issued, even if the student's payment rows change later.
  annualTuitionCentavos Int
  annualMiscCentavos    Int                  @default(500000) // ₱5,000
  /// Convenience field — `tuition + misc` at issuance time.
  annualTotalCentavos   Int

  @@index([studentId])
  @@index([issuedAt])
}

/// One row per payment-reminder email actually sent. Lets the daily cron
/// dedupe so a given student receives at most one email per (period,
/// reason) — never spammed. `reason` is one of WINDOW_OPEN / DUE_SOON /
/// PAST_DUE; `period` matches the format used elsewhere ("August 2026"
/// for MONTHLY, "First half SY 2026–2027" for BIANNUAL).
model ClassPortalPaymentReminderLog {
  id        String   @id @default(cuid())
  studentId String
  email     String
  plan      String   // MONTHLY | BIANNUAL | ANNUAL
  period    String
  dueOn     DateTime @db.Date
  reason    String   // WINDOW_OPEN | DUE_SOON | PAST_DUE
  severity  String   // INFO | WARNING
  sentAt    DateTime @default(now())

  @@unique([studentId, period, reason])
  @@index([sentAt])
  @@index([studentId])
}

/// Defensive audit log for the enrollment funnel. One row per server-
/// visible event in the upload-token / document-blob / account-create
/// pipeline. Lets the admin trace cases like "the parent says they
/// uploaded but there's no record" by seeing exactly which steps hit
/// the server, which failed, and where they stopped. Writes are best-
/// effort — the helper swallows errors so audit failures never break
/// the user-facing flow.
model ClassPortalEnrollmentAudit {
  id         String   @id @default(cuid())
  /// One of: 'upload_token_init', 'upload_token_complete',
  /// 'upload_blob', 'account_create_attempt', 'account_create_success',
  /// 'account_create_failure'. Free text so future kinds slot in without
  /// a migration.
  kind       String
  /// Email at the moment of the event (lowercased when known).
  email      String?
  /// Class-portal student id or draft_xxx prefix from the upload flow.
  studentId  String?
  /// e.g. psa_birth_cert, school_id, parent_valid_id.
  docKey     String?
  /// 'ok' on success, 'error' on any thrown / rejected path.
  outcome    String
  /// Error message captured at the call site. Free text.
  error      String?
  /// Source IP from the X-Forwarded-For header (first hop).
  ip         String?
  userAgent  String?
  /// Free-form bag for per-event extras (file size, role, validation
  /// errors, etc.). Easier to extend than adding columns.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([kind])
}

/// Server-backed school announcements. Admin / teachers publish; every
/// student in the targeted grade levels (or all levels if `levels` is
/// empty) sees the title + date in the panel and can click into the
/// full body. Optional poster image is stored inline as bytea so
/// editors don't have to manage a separate file step — the image is
/// served on demand via a dedicated route, not joined into the bulk
/// list query, so the panel stays fast even when posters are large.
model ClassPortalAnnouncement {
  id              String   @id @default(cuid())
  title           String
  body            String
  /// Empty array means "applies to every grade level".
  levels          String[]
  /// If true, teachers ALSO see this announcement. (Admins always see
  /// all announcements; students see them filtered by levels.)
  includeTeachers Boolean  @default(false)
  authorRole      String   // 'ADMIN' | 'TEACHER'
  authorEmail     String
  authorName      String
  /// Optional poster image. fileData lives in the same row so a single
  /// query carries the full record when needed; the list endpoint
  /// always strips it for payload reasons.
  posterFileName  String?
  posterFileType  String?
  posterFileSize  Int?
  posterFileData  Bytes?
  /// Tracks who blasted this announcement to recipients' emails and when.
  /// `emailedCount` is the number of successful sends. Null = never emailed.
  emailedAt       DateTime?
  emailedBy       String?
  emailedCount    Int?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([authorEmail])
}

/// One-shot password-reset link issued by an admin (or generated by a
/// "Forgot password?" flow). The email handed to the user contains the
/// token; the reset page verifies + consumes it. Expires 24h after issue
/// and may only be used once.
model ClassPortalPasswordReset {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Email of the admin who minted the link, or null for self-service flows.
  requestedBy String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Audit log for admin impersonation events ("View as user"). One row per
/// session minted. The endedAt column is best-effort — the admin doesn't
/// always click "Return to admin", but the per-tab sessionStorage scope
/// keeps the practical blast radius small.
model ClassPortalImpersonationLog {
  id           String   @id @default(cuid())
  adminEmail   String
  targetUserId String
  targetEmail  String
  targetRole   String
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  reason       String?

  @@index([adminEmail])
  @@index([targetUserId])
  @@index([startedAt])
}

/// A teacher-owned class — a graded class section with a roster, weekly
/// schedule, cover photo, and a feed of lessons / tests / projects /
/// activities (later phases). Only the assigned teacher can edit the
/// class data; students see a redacted view (no other students' grades);
/// admins and branch admins (within their branch) see everything; the
/// front desk has no access at all.
model ClassPortalClass {
  id                String            @id @default(cuid())
  branch            ClassPortalBranch
  level             ClassPortalLevel
  name              String
  /// Optional section label, e.g. "A", "Falcons", "Section 1".
  section           String?
  /// ID of the ClassPortalUser (role=TEACHER) who owns this class.
  teacherId         String
  /// Student roster — array of ClassPortalUser.id values (role=STUDENT).
  studentIds        String[]
  /// Weekly schedule days, e.g. ["TUESDAY","THURSDAY"]. Lessons must
  /// fall on one of these days.
  scheduleDays      String[]
  scheduleStartTime String?
  scheduleEndTime   String?
  /// Cover photo bytes stored inline so the same image is visible from
  /// every device and survives the local cache being cleared.
  photoFileName     String?
  photoFileType     String?
  photoFileSize     Int?
  photoFileData     Bytes?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([branch])
  @@index([teacherId])
  @@index([level])
}

/// One day's lesson inside a ClassPortalClass. Phase 2 of the Class
/// feature: a date-on-schedule entry with title, description, attached
/// reference materials, attendance per student, optional per-student
/// outputs, and optional graded work.
model ClassPortalLesson {
  id               String   @id @default(cuid())
  classId          String
  /// The actual class day. Must fall on one of the parent class's
  /// scheduleDays — enforced in the API.
  lessonDate       DateTime
  title            String
  description      String?
  /// Attendance map keyed by studentId → 'PRESENT' | 'ABSENT'.
  /// JSON so adding/removing students doesn't churn the schema.
  attendance       Json     @default("{}")
  /// Set when the teacher ticks "Has student output?" — controls
  /// whether the per-student output upload section renders.
  hasStudentOutput Boolean  @default(false)
  /// Total points if the lesson is graded (e.g. 100). When null the
  /// lesson is not a graded session.
  gradeTotal       Int?
  /// Grades map keyed by studentId → { score, makeupDate? }.
  grades           Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([classId])
  @@index([lessonDate])
}

/// Reference material attached to a lesson — PDFs, Word, Excel files
/// the teacher hands out. Bytes stored inline (same pattern as the
/// shared Curriculum + Template libraries).
model ClassPortalLessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  fileName  String
  fileType  String
  fileSize  Int
  fileData  Bytes
  createdAt DateTime @default(now())

  @@index([lessonId])
}

/// One student's output for a lesson — typically a photo of their
/// work. Stored inline. makeupDate is set when an absent student
/// submitted later (the teacher records the makeup date alongside).
model ClassPortalLessonOutput {
  id         String   @id @default(cuid())
  lessonId   String
  studentId  String
  fileName   String
  fileType   String
  fileSize   Int
  fileData   Bytes
  makeupDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([lessonId])
}

/// Phase 3: a test / exam pinned to a specific lesson. The lesson
/// records attendance + the day's work; the test records a graded
/// assessment that took place during it. Per-student scores +
/// per-student proof uploads (the actual exam paper, photo of the
/// test, etc.) with makeup-date support for absent learners.
model ClassPortalLessonTest {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  totalPoints Int
  /// scores: JSON map studentId → { score, makeupDate? }
  scores      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lessonId])
}

/// One student's proof for a test (uploaded scan / photo of their paper).
model ClassPortalLessonTestProof {
  id        String   @id @default(cuid())
  testId    String
  studentId String
  fileName  String
  fileType  String
  fileSize  Int
  fileData  Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, studentId])
  @@index([testId])
}

/// Phase 3: a project at the class level (not tied to a specific
/// lesson). Title + description + optional deadline + total score.
/// Roster-wide grade entry + per-student proof upload.
model ClassPortalProject {
  id          String   @id @default(cuid())
  classId     String
  title       String
  description String?
  deadline    DateTime?
  totalScore  Int
  /// grades: JSON map studentId → { score, makeupDate? }
  grades      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId])
}

model ClassPortalProjectProof {
  id        String   @id @default(cuid())
  projectId String
  studentId String
  fileName  String
  fileType  String
  fileSize  Int
  fileData  Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, studentId])
  @@index([projectId])
}

/// Phase 4: an Activity on a class — school events, field trips, IEP
/// reviews, holidays, anything that's not a graded lesson or project.
/// Date range (fromDate / toDate) and a gallery of photos uploaded by
/// the teacher.
model ClassPortalActivity {
  id          String   @id @default(cuid())
  classId     String
  name        String
  /// Free-form classification (e.g. "School Event", "Field Trip",
  /// "IEP Review", "Holiday"). UI offers suggestions but accepts any.
  type        String?
  description String?
  fromDate    DateTime?
  toDate      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId])
}

model ClassPortalActivityPhoto {
  id         String   @id @default(cuid())
  activityId String
  fileName   String
  fileType   String
  fileSize   Int
  fileData   Bytes
  createdAt  DateTime @default(now())

  @@index([activityId])
}

/// Shared curriculum library — per-grade. Stored on the server so admins,
/// teachers, front desk, and students see the same set regardless of which
/// device the file was uploaded from. Each record can carry up to three
/// variant blobs (PDF, Word, Excel) under one title.
model ClassPortalCurriculum {
  id          String   @id
  level       String
  title       String
  pdfFileName String?
  pdfFileType String?
  pdfFileSize Int?
  pdfFileData Bytes?
  docFileName String?
  docFileType String?
  docFileSize Int?
  docFileData Bytes?
  xlsFileName String?
  xlsFileType String?
  xlsFileSize Int?
  xlsFileData Bytes?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
}

/// Shared free-form template library (lesson plan templates, IEP forms,
/// parent forms, etc.). Same shape as curriculum but without a grade level.
model ClassPortalTemplate {
  id          String   @id
  title       String
  pdfFileName String?
  pdfFileType String?
  pdfFileSize Int?
  pdfFileData Bytes?
  docFileName String?
  docFileType String?
  docFileSize Int?
  docFileData Bytes?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Admin-editable fee schedule. One row per branch — the pay portal picks
/// the row matching the student's enrollment branch (fallback: hardcoded
/// defaults when no row exists yet). `extraItems` holds free-form line
/// items (uniforms, books, etc.) the admin wants surfaced on the pay page.
model ClassPortalFeeSchedule {
  branch                  ClassPortalBranch @id
  tuitionAnnualCentavos   Int      @default(0)
  tuitionBiannualCentavos Int      @default(0)
  tuitionMonthlyCentavos  Int      @default(0)
  miscAnnualCentavos      Int      @default(0)
  miscBiannualCentavos    Int      @default(0)
  miscMonthlyCentavos     Int      @default(0)
  /// JSON: Array<{ label: string; amountCentavos: number; notes?: string }>
  extraItems              Json     @default("[]")
  updatedAt               DateTime @updatedAt
  updatedBy               String?
}

/// Admin-editable tuition discount vouchers. Parents type a code on the
/// class-portal /pay page; if it's enabled and on/before its validUntil
/// date, the tuition portion is reduced by discountPercent. Managed from
/// the main admin account (Fees tab → Voucher codes).
model ClassPortalVoucher {
  id              String   @id @default(cuid())
  code            String   @unique // stored upper-cased
  discountPercent Int      @default(0) // 0–100
  validUntil      DateTime // last date the discount applies (inclusive)
  enabled         Boolean  @default(true)
  /// When set, only this ClassPortalUser.id may validate/use this
  /// voucher. Powers the "personal early-bird" vouchers issued to
  /// individual monthly students after the public AURA30 code expired
  /// — each of them keeps their 30% discount for the rest of the SY.
  /// Null = public voucher (anyone with the code can use it).
  dedicatedStudentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@index([dedicatedStudentId])
}

/// Admin-editable FAQ templates for the Sappy patient-portal chatbot.
/// /api/public/chat checks these (keyword match) before falling back to
/// Claude. Edited from the client-portal admin console. `label`, when set,
/// also surfaces the entry as a quick-reply button in the chat widget.
model ChatFaq {
  id        String   @id @default(cuid())
  label     String   @default("") // quick-reply button text ("" = hidden as a button)
  keywords  String   // comma-separated trigger keywords (matched as substrings)
  answer    String   // the template response shown to the patient
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([enabled, sortOrder])
}

/// Key-value store for Sappy's non-FAQ editable copy: the intro greeting,
/// the Claude system prompt, and the no-answer fallback message.
model ChatSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}

// ── Restored: models wiped by a stale-base schema.prisma overwrite ──

model UgatScholar {
  id           String   @id @default(cuid())
  /// Login handle (lowercased). Sign-in is by username, not email.
  username     String   @unique
  /// School / professional email + personal email. Verification links are
  /// sent to both. Not unique — two scholars could share a school domain
  /// alias in edge cases; uniqueness is enforced on username only.
  professionalEmail String
  personalEmail     String
  passwordHash String

  /// Which track the scholar registered for: ARAL (final-year interns) |
  /// TINDIG (graduates preparing for the licensure exam). Chosen at sign-up.
  track String @default("ARAL")

  /// Aral Track award tier, chosen by an admin at acceptance. The monthly
  /// stipend (5000 or 10000) and its duration in months (5 or 10) are woven
  /// into the Return Service Agreement the fellow reads and signs. Null until
  /// an admin awards the tier.
  awardMonthly Int?
  awardMonths  Int?

  firstName   String
  middleName  String?
  lastName    String
  studentNumber        String
  expectedGraduationYear Int
  birthdate   DateTime

  /// Snapshots of the chosen dropdown labels (see UgatOption).
  school         String
  program        String
  preferredField String
  /// Clinic branch(es) the applicant is interested to work in after licensure,
  /// comma-joined (chosen from the admin-managed BRANCH options). "" = none.
  preferredBranches String @default("")

  // Permanent address
  permAddress1 String
  permAddress2 String?
  permCity     String
  permRegion   String
  permZip      String

  // Present address (may mirror permanent)
  presSameAsPerm Boolean @default(false)
  presAddress1   String
  presAddress2   String?
  presCity       String
  presRegion     String
  presZip        String

  /// Set the moment the scholar clicks their emailed verification link.
  /// Null = unverified; such accounts cannot sign in.
  emailVerifiedAt DateTime?

  /// Application status shown on the admin Dashboard.
  /// APPLIED | ACCEPTED | WAITLISTED | REJECTED. Default APPLIED.
  status String @default("APPLIED")

  /// Soft-disable (admin). Null = active.
  disabledAt DateTime?
  disabledBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Admin-viewable password copy (User Access shows usernames + passwords).
  /// Kept in sync with passwordHash on signup + resets.
  passwordPlain String?

  verificationTokens UgatVerificationToken[]
  uploads            UgatUpload[]
  application        UgatApplication?
  acceptance         UgatAcceptance?

  @@index([emailVerifiedAt])
  @@index([disabledAt])
  @@index([status])
}

model UgatVerificationToken {
  id        String    @id @default(cuid())
  scholarId String
  token     String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  scholar UgatScholar @relation(fields: [scholarId], references: [id], onDelete: Cascade)

  @@index([scholarId])
}

model UgatOption {
  id         String         @id @default(cuid())
  kind       UgatOptionKind
  label      String
  sortOrder  Int            @default(0)
  /// Soft-hide from the signup dropdowns without deleting. Null = active.
  disabledAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([kind, label])
  @@index([kind, disabledAt, sortOrder])
}

enum UgatOptionKind {
  SCHOOL // legacy single school list (superseded by the per-track lists below)
  SCHOOL_ARAL // schools we accept for the Aral Track
  SCHOOL_TINDIG // schools we accept for the Tindig Track
  PROGRAM
  FIELD // preferred field of practice
  BRANCH // clinic branch the applicant is interested to work in afterwards
}

model UgatAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  /// Admin-viewable password copy (User Access shows usernames + passwords).
  passwordPlain String?
  name         String
  /// Account type: STAFF | UNIVERSITY. University admins get a read-only,
  /// restricted view (About Us + Application only).
  kind         String   @default("STAFF")
  createdAt    DateTime @default(now())
  createdBy    String?
  disabledAt   DateTime?

  @@index([disabledAt])
}

model UgatApplication {
  id        String @id @default(cuid())
  scholarId String @unique

  /// Which sub-category the applicant applied to: ARAL (internship allowance,
  /// current interns) | TINDIG (licensure review-support, graduates).
  track String @default("ARAL")

  // Step 1 — application questions
  q1WhyApply      String?
  q2Initiatives   String?
  q3WhyProgram    String?
  q4StipendUse    String?
  q5ReturnService String?
  q6ArawNgKalinga String?
  q7FiveYearPlan  String?

  // Step 4 — truthfulness attestation + signature
  truthAffirmed Boolean   @default(false)
  signedAt      DateTime?

  /// Null while a draft; set when the applicant submits Part I.
  submittedAt DateTime?
  /// Academic year this application belongs to (e.g. "2026-2027"), stamped at
  /// submission from whichever UgatApplicationCycle was open at the time.
  academicYear String?
  /// Admin decision on Part I: NOT_CONSIDERED | PENDING | FOR_INTERVIEW
  initialDecision String @default("PENDING")

  // ── Part II: Interview ──────────────────────────────────────────
  /// The interview slot the scholar booked, plus a snapshot of its time so
  /// deleting a slot doesn't lose the booking.
  interviewSlotId       String?
  interviewAt           DateTime?
  interviewDurationMins Int?
  jitsiUrl              String?
  /// Admin decision after interview: NOT_CONSIDERED | PENDING | FOR_ACCEPTANCE
  interviewDecision String @default("PENDING")

  /// Set when the empathic "not considered" email has been sent (prevents
  /// double-sending).
  rejectionEmailedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scholar UgatScholar @relation(fields: [scholarId], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@index([initialDecision])
  @@index([interviewDecision])
  @@index([academicYear])
}

model UgatApplicationCycle {
  id           String   @id @default(cuid())
  academicYear String   @unique
  opensAt      DateTime
  closesAt     DateTime
  /// Deadline to finish deciding Part I (Initial). Used for the reminder popup
  /// + the empathic "not considered" notification.
  initialDeadline   DateTime?
  /// Deadline to finish deciding Part II (Interview → Acceptance).
  interviewDeadline DateTime?
  /// Deadlines for the accepted fellow's soft-copy (e-sign) and in-person
  /// hard-copy signing of the Return Service Agreement.
  softCopyDeadline  DateTime?
  hardCopyDeadline  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([opensAt, closesAt])
}

model UgatInterviewSlot {
  id           String   @id @default(cuid())
  startsAt     DateTime
  durationMins Int      @default(30)
  capacity     Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([startsAt])
}

model UgatAcceptance {
  id        String @id @default(cuid())
  scholarId String @unique

  /// Set when an admin "sends the contract" — unlocks the signing flow.
  contractSentAt DateTime?

  // Co-maker identity
  comakerFirstName  String?
  comakerMiddleName String?
  comakerLastName   String?
  comakerBirthdate  DateTime?
  comakerEmail      String?
  comakerOccupation String?

  // Co-maker permanent address
  cmPermAddress1 String?
  cmPermAddress2 String?
  cmPermCity     String?
  cmPermRegion   String?
  cmPermZip      String?

  // Co-maker present address (may mirror permanent)
  cmPresSameAsPerm Boolean @default(false)
  cmPresAddress1   String?
  cmPresAddress2   String?
  cmPresCity       String?
  cmPresRegion     String?
  cmPresZip        String?

  // Co-maker occupation address
  cmOccAddress1 String?
  cmOccAddress2 String?
  cmOccCity     String?
  cmOccRegion   String?
  cmOccZip      String?

  /// Fellow ticked the truthfulness / agreement statement.
  truthAffirmed Boolean @default(false)
  /// Fellow submitted the signed soft copy (RSA + co-maker + IDs + signature).
  softCopySignedAt DateTime?
  /// Admin marked the in-person hard copy as signed.
  hardCopySignedAt DateTime?
  hardCopyMarkedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scholar UgatScholar @relation(fields: [scholarId], references: [id], onDelete: Cascade)

  @@index([contractSentAt])
  @@index([softCopySignedAt])
}

model UgatAnnouncement {
  id        String   @id @default(cuid())
  title     String
  details   String
  published Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model UgatMarketingAsset {
  id         String   @id @default(cuid())
  kind       String   @unique
  filename   String
  mimeType   String
  data       Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UgatAssessor {
  id            String   @id @default(cuid())
  adminId       String
  academicYear  String
  weightPercent Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([adminId, academicYear])
  @@index([academicYear])
}

model UgatRubric {
  id        String   @id @default(cuid())
  key       String   @unique @default("default")
  config    Json
  updatedAt DateTime @updatedAt
}

model UgatAssessment {
  id           String   @id @default(cuid())
  scholarId    String
  adminId      String
  academicYear String
  stage        String
  data         Json
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scholarId, adminId, stage])
  @@index([scholarId, stage])
  @@index([academicYear, stage])
}

model UgatUpload {
  id        String   @id @default(cuid())
  scholarId String
  /// PHOTO | LETTER | GRADES_Y1 | GRADES_Y2 | GRADES_Y3 | SIGNATURE |
  /// VALID_ID_1 | VALID_ID_2 | COMAKER_ID_1 | COMAKER_ID_2
  kind      String
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  scholar UgatScholar @relation(fields: [scholarId], references: [id], onDelete: Cascade)

  @@index([scholarId, kind])
}

model PeerEvalEmailLog {
  id          String   @id @default(cuid())
  assessorId  String
  branch      String
  periodYear  Int
  periodMonth Int
  sentAt      DateTime @default(now())
  sentBy      String?  // user email/name who triggered the send

  assessor Staff @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  @@unique([assessorId, branch, periodYear, periodMonth])
}

model UserNotificationState {
  userId      String   @id  // = User.id (session.user.id)
  dismissedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Hard bounces harvested from the sending mailboxes' delivery-failure reports.
/// Gmail's API confirms a message was ACCEPTED, never that it was delivered — a
/// bounce comes back afterwards as a separate mailer-daemon message, so the only
/// way to learn about it is to read the mailbox back.
model EmailBounce {
  id           String   @id @default(cuid())
  email        String
  patientId    String?
  /// HARD = the address does not exist and never will (5.1.1 / user unknown).
  /// SOFT = temporary (full mailbox, throttling). Only HARD unsubscribes.
  kind         String
  /// Enhanced status code (e.g. "5.1.1") when the report carries one.
  statusCode   String?
  reason       String?
  /// Gmail message id of the failure report, so a rescan cannot double-count.
  gmailMsgId   String   @unique
  mailbox      String
  detectedAt   DateTime @default(now())
  /// Set when this bounce is what took the patient off the mailing list.
  unsubscribed Boolean  @default(false)

  @@index([email])
  @@index([kind, detectedAt])
}
