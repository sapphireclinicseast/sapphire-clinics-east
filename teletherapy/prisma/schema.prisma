generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Enums (shared with marketing DB) ──────────────────────────────────────────

enum StaffDepartment {
  OT
  PT
  SLP
  SPED
  MD
  PSYCHOLOGY
  ORTHOSIS
  FRONT_DESK
  ADMINISTRATION
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

enum PatientType {
  PEDIATRIC
  ADULT
}

enum Branch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  VERDANA_STORE
}

// ── Shared models (read from marketing DB) ────────────────────────────────────

model Staff {
  id              String          @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  department      StaffDepartment
  branch          String          // primary branch — "SBEA" | "SBGH"
  extraBranches   String[]        @default([]) // additional branches an interbranch consultant works in (column already exists in the shared DB, managed by the ops hub)
  dob             DateTime?
  jobTitle        String?
  employmentType  String?
  hrPlatformId    String?
  // Fallback profile photo (URL or data URI) used when there is no HR photo —
  // e.g. sample/demo interns that aren't real HR records.
  photoPath       String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  schedules       Schedule[]
  internSchedules Schedule[]      @relation("ScheduleIntern") // sessions this person did as an intern
  therapistAccount TherapistAccount?
  surveyResponses  SurveyResponse[]
}

// Survey response (from marketing hub's Customer Survey module)
// Read-only from teletherapy perspective
model SurveyResponse {
  id              String   @id @default(cuid())
  assignmentId    String   @unique
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id])
  surveyType      String   // HR10|HR11|HR12|HR16
  branch          String
  respondentName  String?
  respondentEmail String?
  respondentPhone String?
  responsesJson   Json
  submittedAt     DateTime @default(now())

  @@index([staffId])
}

model Patient {
  id          String      @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dob         DateTime?
  patientType PatientType
  branch      Branch?
  branches    Branch[]    @default([])
  sex         String?
  civilStatus String?
  religion    String?
  nationality String?
  address     String?
  city        String?
  diagnosis   String?
  notes       String?
  referralUrl String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  schedules           Schedule[]
  patientAssignments  PatientAssignment[]
  documents           PatientDocument[]
}

// Documents uploaded per patient per department
// (Initial Evaluations, Progress Reports, Other Documents)
enum PatientDocumentType {
  INITIAL_EVALUATION
  PROGRESS_REPORT
  OTHER_DOCUMENT
}

model PatientDocument {
  id           String              @id @default(cuid())
  patientId    String
  patient      Patient             @relation(fields: [patientId], references: [id])
  uploadedById String              // therapistAccount.id of uploader
  department   String              // PT, OT, SLP, SPED, PSYCHOLOGY, ORTHOSIS
  documentType PatientDocumentType
  fileName     String
  filePath     String
  mimeType     String
  description  String?
  scheduleId   String?             // optional link to a session (e.g. IE flagged from session)

  // ── IE workflow: clinician emails the IE directly to the patient
  sentToPatientAt   DateTime?
  sentToPatientBy   String?        // therapistAccount.id who triggered the send
  sentToPatientCc   String?        // branch-specific cc email recorded at send time

  // ── PR workflow: clinician informs front desk that PR is available
  informedFrontDeskAt DateTime?
  informedById        String?      // therapistAccount.id

  // ── PR workflow: front desk marks paid + emails PR to patient (Marketing Hub)
  paidForAt        DateTime?
  paidById         String?         // marketing User.id
  emailedToPatientAt DateTime?
  emailedById        String?       // marketing User.id

  // Permanent freeze marker. Stamped when the uploader is endorsed
  // or discharged off the patient. Once set, the document cannot be
  // re-uploaded or deleted by anyone except an admin — even if the
  // patient is later endorsed back to the original uploader. New
  // documents the same uploader creates after re-endorsement are
  // unlocked again. Mirrors SessionNote.lockedAt for consistency.
  lockedAt     DateTime?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([patientId, department])
  @@index([documentType])
  @@index([informedFrontDeskAt])
  @@index([emailedToPatientAt])
}

// Per-branch CC email for IE notifications and tracking
model BranchCCEmail {
  id        String   @id @default(cuid())
  branch    String   @unique // SBEA, SBGH, VERDANA_STORE, etc.
  email     String
  notes     String?  // optional admin note (e.g. "Front desk East")
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HR Branch Registry (synced cache) — HR Platform is the source of truth
// (see HR Platform's `modules/branches`). Populated via admin-triggered
// POST /api/branches/sync (full replace, Bearer HR_API_KEY against
// HR_API_BASE, same working pair /api/staff/sync-hr already uses). Do not
// edit rows here directly — edits belong in HR Platform.
//
// NOTE: teletherapy shares its Postgres database (sapphire_marketing) with
// Operations Hub — same physical table as Operations Hub's own HrBranch
// model, same convention already established by BranchCCEmail above. Keep
// this model's columns in lockstep with Operations Hub's prisma/schema.prisma
// HrBranch — Operations Hub's migration is what actually creates the table.
model HrBranch {
  id                       String   @id
  shortCode                String
  aliases                  String[] @default([])
  opsHubBranch             String?
  opsHubClassPortalBranch  String?
  acctHubBranch            String?
  acctHubServiceBranch     String?
  teletherapyBranch        String?
  name                     String
  brandName                String?
  tin                      String?
  address                  String?
  phone                    String?
  emailMain                String?
  emailHr                  String?
  emailAccounting          String?
  departmentsOffered       String[] @default([])
  operatingDays            String[] @default([])
  operatingHoursOpen       String?
  operatingHoursClose      String?
  active                   Boolean  @default(true)
  syncedAt                 DateTime @default(now())
}

// Staff directory — admin-managed contact list shown to everyone.
// `departments` holds one or more StaffDepartment values (multi-select).
model DirectoryEntry {
  id          String   @id @default(cuid())
  departments String[] // e.g. ["OT", "SPED"] — multiple allowed
  branches    String[] // e.g. ["EAST", "CORPORATE"] — multiple allowed
  email       String
  // Branches whose staff may view `email`. Empty = visible to everyone.
  // Admins always see it regardless.
  visibleBranches String[]
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-branch free-text "Branch Information" shown in the Directory.
// One row per branch code (EAST / GREENHILLS / VERDANA / CORPORATE).
model DirectoryBranchInfo {
  id          String   @id @default(cuid())
  branch      String   @unique
  info        String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Directory websites — link + description, with the same per-entry branch
// visibility as emails (empty visibleBranches = visible to everyone).
model DirectoryWebsite {
  id              String   @id @default(cuid())
  link            String
  description     String?
  visibleBranches String[]
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Schedule {
  id          String         @id @default(cuid())
  staffId     String         // supervising therapist — whoever's card this was booked under
  staff       Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  date        DateTime
  startTime   String
  endTime     String
  duration    String
  sessionType String
  status      ScheduleStatus @default(PENDING)
  notes       String?
  meetLink    String?
  // Which intern actually did the session, when sessionType is "IE Intern" /
  // "Session Intern" (set from the Ops Hub Clinic Schedule) — the intern
  // writes the note; staffId above stays the supervisor. Column already
  // exists in the shared DB (Ops Hub migration 20260815_schedule_intern_staff).
  internStaffId String?
  internStaff   Staff?         @relation("ScheduleIntern", fields: [internStaffId], references: [id], onDelete: SetNull)
  // Age lock (see src/lib/note-age-lock.ts). Notes on sessions older than the
  // documentation window are read-only by default; a clinician can deliberately
  // re-open one, and that decision is recorded here rather than held in the
  // browser so the server can actually enforce the lock.
  //
  // Lives on Schedule, not SessionNote, because a stale session may have no
  // note yet — writing the first note on an old session is exactly the case
  // the lock is meant to catch.
  //
  // Distinct from SessionNote.lockedAt, which is the permanent endorsement
  // freeze and is NOT re-openable by anyone.
  noteUnlockedAt   DateTime?
  noteUnlockedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sessionNote SessionNote?

  @@index([staffId])
  @@index([internStaffId])
  @@index([patientId])
  @@index([date])
  @@index([status])
  @@index([staffId, date])
  @@index([patientId, status])
}

// Peer Evaluation responses (owned by the Marketing Hub; table already exists
// in the shared DB). Read-only here — used for the "What your Peers Love About
// You" wall, which surfaces only the free-text `strengths` for the assessee.
enum PeerEvalType {
  HR08_ADMIN
  HR08_PEER
  HR09_CLINICAL
  HR09_ADMIN
}

model PeerEvalResponse {
  id           String       @id @default(cuid())
  assignmentId String       @unique
  assessorId   String
  assesseeId   String
  formType     PeerEvalType
  branch       String
  scores       Json
  strengths    String?
  improvements String?
  submittedAt  DateTime     @default(now())

  @@index([assesseeId])
}

// ── Gmail account (read from marketing DB for email sending) ──────────────────

model GmailAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  refreshToken String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Teletherapy-specific models ───────────────────────────────────────────────

enum TherapistRole {
  THERAPIST
  ADMIN
}

enum SessionNoteStatus {
  COMPLETED
  DISCONTINUED
}

model TherapistAccount {
  id           String        @id @default(cuid())
  staffId      String        @unique
  staff        Staff         @relation(fields: [staffId], references: [id])
  email        String        @unique
  passwordHash      String
  lastPlainPassword String?
  role         TherapistRole @default(THERAPIST)
  // Access preset that drives which sidebar sections the account sees.
  // CLINICIAN (default) keeps full clinical access; FRONT_DESK / ADMIN_STAFF
  // are limited staff presets; ADMIN-role accounts always see everything.
  accountType  String        @default("CLINICIAN") // CLINICIAN | FRONT_DESK | ADMIN_STAFF | ADMIN
  isActive         Boolean       @default(true)
  // For intern accounts: once a human (HR/supervisor/admin) re-enables access
  // after the rotation lapsed, this is set so the daily auto-disable sweep
  // won't turn the account off again (e.g. a re-rotation).
  internAccessOverride Boolean   @default(false)
  lastLoginAt      DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // Per-user template pin list. HR template IDs (strings) — they live
  // in the HR hub's DB, not here, so we keep the relationship loose
  // (no foreign key) and just store the IDs the user has pinned.
  pinnedTemplateIds   Json          @default("[]")
  sessionNotes        SessionNote[]
  patientAssignments  PatientAssignment[]
  endorsedPatients    PatientAssignment[] @relation("EndorsedTo")
  clinicianSettings   ClinicianSettings?
}

model SessionNote {
  id                  String            @id @default(cuid())
  scheduleId          String            @unique
  schedule            Schedule          @relation(fields: [scheduleId], references: [id])
  therapistAccountId  String
  therapistAccount    TherapistAccount  @relation(fields: [therapistAccountId], references: [id])
  status              SessionNoteStatus
  notes               String?
  attachments         Json?
  discontinuedRemarks String?
  isInitialEvaluation Boolean           @default(false)
  emailSentAt         DateTime?
  emailSentTo         String?
  // Permanent freeze marker. Set when the authoring clinician is
  // endorsed/discharged off the patient. Once stamped, the note can
  // never be edited again — even if the patient is endorsed BACK to
  // the same clinician later. This is by design: the note is signed
  // by who delivered it at the time it was delivered, and a later
  // re-endorsement should not unlock historical clinical content.
  lockedAt            DateTime?
  // Append-only audit trail: who created/edited the note and when. Each entry
  // is { name, accountType, action: 'created'|'edited', at }. Interns author;
  // supervisors edit — this makes both visible.
  editHistory         Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

enum PatientAssignmentStatus {
  ACTIVE       // current write-owner of the patient
  DEACTIVATED  // previously assigned; read-only continuity-of-care visibility
  DISCHARGED   // discharged by this consultant; no edits
  ENDORSED     // legacy — equivalent to DEACTIVATED, kept so old data still parses
}

model PatientAssignment {
  id                String                  @id @default(cuid())
  patientId         String
  patient           Patient                 @relation(fields: [patientId], references: [id])
  therapistAccountId String
  therapistAccount  TherapistAccount        @relation(fields: [therapistAccountId], references: [id])
  status            PatientAssignmentStatus @default(ACTIVE)
  endorsedToId      String?
  endorsedTo        TherapistAccount?       @relation("EndorsedTo", fields: [endorsedToId], references: [id])
  dischargeRemarks  String?
  endorsedAt        DateTime?
  dischargedAt      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // Exactly ONE row per (patient, therapist). Status changes in place
  // when the patient is endorsed away or back. Without this constraint
  // re-endorsement cycles collide on the old (patient, therapist, status)
  // unique key (P2002).
  @@unique([patientId, therapistAccountId])
}

model CaptureToken {
  id         String   @id @default(cuid())
  scheduleId String
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ClinicianSettings {
  id                  String           @id @default(cuid())
  therapistAccountId  String           @unique
  therapistAccount    TherapistAccount @relation(fields: [therapistAccountId], references: [id])
  licenseNo           String?
  ptrNo               String?
  signatureDataUrl    String?          @db.Text // base64 signature image
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// ── Support Tickets ──────────────────────────────────────────────
// Staff-raised concerns about the portal. Numbered per branch per day
// (AHEA-/AHGH-/VERD-YYYYMMDD-NN). The main admin resolves; the raiser
// sees the resolution.
model Ticket {
  id                String    @id @default(cuid())
  ticketNumber      String    @unique
  branch            String
  subject           String
  description       String
  attachmentPath    String?
  attachmentName    String?
  status            String    @default("OPEN") // OPEN / RESOLVED
  raisedByAccountId String
  raisedByName      String
  raisedByEmail     String?
  resolution        String?
  resolvedByName    String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([raisedByAccountId])
  @@index([status])
}

// ── Intern Supervision ───────────────────────────────────────────
// Balik-Tanaw: an intern's weekly reflection. The intern submits (their typed
// name is stamped as the signature); their supervisor reads it in the portal
// and "signs" (Coordinating Teacher's signature) with their name + timestamp.
model BalikTanaw {
  id                     String    @id @default(cuid())
  internStaffId          String
  department             String
  periodLabel            String    // e.g. "Week of Aug 18, 2026"
  answers                Json      // [{ question: string, answer: string }]
  internSignedName       String
  internSignedAt         DateTime  @default(now())
  supervisorSignedName   String?
  supervisorSignedAt     DateTime?
  supervisorSignatureUrl String?
  supervisorAccountId    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([internStaffId])
}

// A supervisor's grade for an intern: one grade + an attached computation file.
model InternGrade {
  id                  String   @id @default(cuid())
  internStaffId       String
  supervisorAccountId String
  grade               String   // number/percentage or short remark
  note                String?
  fileName            String?
  filePath            String?
  mimeType            String?
  gradedByName        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([internStaffId, supervisorAccountId])
  @@index([internStaffId])
}

// An intern's Learning Outcomes & Preferences intake (one per intern, editable).
// Stored as a flexible JSON blob (open-text outcomes + multi-select preferences).
model LearningProfile {
  id            String   @id @default(cuid())
  internStaffId String   @unique
  data          Json     // { outcomes: {...}, learnBest: [], learnBestOther, feedback: [], feedbackOther, prep: [], challenges }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Internship documents supervisors upload (supervision guides, forms, etc.).
// Department-scoped: visible to supervisors in the same department (+ admins).
model InternshipDocument {
  id                  String   @id @default(cuid())
  department          String
  title               String
  description         String?
  fileName            String
  filePath            String
  mimeType            String?
  uploadedByAccountId String
  uploadedByName      String
  createdAt           DateTime @default(now())

  @@index([department])
  @@index([createdAt])
}
