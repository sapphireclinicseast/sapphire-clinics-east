// Nickel — its OWN database (separate from the shared sapphire_marketing DB).
// Homecare therapy marketplace: patients book licensed home therapists who set
// their own rate + schedule. Everything here is Nickel-owned (not synced from
// Operations/HR).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum PayoutStatus {
  PENDING // net earned, not yet paid out to the provider
  PAID    // included in a settled payout batch
}

model Payout {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount     Decimal  // total net paid in this run (PHP)
  method     String?  // snapshot of where it was sent (bank / GCash)
  reference  String?  // manual transfer reference
  note       String?
  createdAt  DateTime @default(now())
  bookings   Booking[]

  @@index([providerId])
}

enum VerificationStatus {
  UNVERIFIED // account created, not yet submitted for verification
  PENDING    // documents submitted, awaiting SCEI review (24–48h)
  VERIFIED   // approved — can take bookings and appear to clients
  REJECTED   // review failed; provider may resubmit
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  OPEN      // posted by the patient, therapists can offer
  MATCHED   // patient accepted an offer → a booking was created
  CANCELLED // patient cancelled the request
}

enum OfferStatus {
  PENDING   // therapist reached out, waiting on the patient
  ACCEPTED  // patient accepted → booking created
  DECLINED  // patient chose someone else / declined
  WITHDRAWN // therapist withdrew
}

enum TicketStatus {
  OPEN
  RESOLVED
}

// ── Therapist (provider) ─────────────────────────────────────────────────────
model Provider {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  photo        String?  // URL or data URI
  profession   String   @default("PT") // PT | OT | SLP | SPED | PSYCHOLOGY | ...

  // Homecare service config
  citiesCovered String[] @default([]) // city NAMES this therapist serves (drives patient matching)
  coverageAreas Json?    // [{city, province, region, zip}] — richer coverage detail from the dashboard
  travelBuffer  Boolean  @default(false) // leave a 1-hour gap between bookable visits for travel
  rate          Decimal? // therapist-set homecare session rate (PHP)
  transpoIncluded Boolean @default(false) // is transport included in the rate?

  // Settings — credentials & payout
  prcNumber    String?
  ptrNumber    String?
  signature    String?  // URL or data URI of their e-signature
  bankName     String?
  bankAccountNo String?
  bankAccountName String?
  gcashNumber  String?
  gcashName    String?

  // Identity & credential verification (reviewed by SCEI before the account goes live)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  facePhoto             String?  // selfie / face scan (data URI)
  prcHoldingPhoto       String?  // photo of the provider holding their PRC ID (data URI)
  school                String?  // school graduated from
  yearGraduated         String?  // year graduated (free text to preserve exact value)
  yearsExperience       String?  // years of professional experience (free text)
  postgraduate          String?  // postgraduate degree(s)
  postNominals          String?  // e.g. "PTRP, DPT" — shown after the name on the patient list
  diplomaScan           String?  // diploma scan (data URI)
  torScan               String?  // transcript of records scan (data URI)
  certifications        Json?    // [{name, file}] certification uploads (support specialized-rate requests)
  verificationSubmittedAt DateTime?
  verifiedAt            DateTime?
  rejectionReason       String?
  reviewerNote          String?  // internal note from the admin reviewer

  // Specialized rate — gated on an admin verifying a certification/specialization
  specialization        String?  // e.g. "Pediatric Neuro-developmental Treatment (NDT)"
  specializedRate       Decimal? // therapist-set rate for the specialized service
  specializedRateApproved Boolean @default(false)

  // Consent
  termsVersion    String?
  termsAcceptedAt DateTime?

  // Nickel wallet — net earnings released here on session completion; payouts draw it down.
  walletBalance Decimal @default(0)

  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  slots        ProviderSlot[]
  bookings     Booking[]
  tickets      Ticket[]
  payouts      Payout[]
  walletTxns   WalletTransaction[]
  requestOffers RequestOffer[]

  @@index([active])
}

// Weekly recurring availability window for a provider.
model ProviderSlot {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0=Sun … 6=Sat
  startTime  String   // "09:00"
  endTime    String   // "17:00"
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@unique([providerId, dayOfWeek, startTime])
}

// ── Patient ──────────────────────────────────────────────────────────────────
model Patient {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  address      String?
  city         String?
  dob          DateTime?
  // Nickel wallet — refundable store credit; can be applied at checkout.
  walletBalance Decimal @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
  walletTxns   WalletTransaction[]
  requests     PatientRequest[]

  @@index([city])
}

// ── Booking ──────────────────────────────────────────────────────────────────
model Booking {
  id         String        @id @default(cuid())
  patientId  String
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider      @relation(fields: [providerId], references: [id])
  city       String
  date       DateTime      // visit date (date-only, UTC midnight)
  startTime  String        // "10:00"
  endTime    String        // "11:00"
  status     BookingStatus @default(PENDING)
  amount     Decimal       // total charged (therapist rate; +transport if not included, handled in app)
  transpoIncluded Boolean  @default(false)
  notes      String?

  // Payment (Verdana PayMongo account)
  paymongoLinkId String?
  checkoutUrl    String?
  paidAt         DateTime?

  // Earnings split — computed when the booking is paid (see src/lib/earnings.ts)
  appFee         Decimal?      // Nickel's flat platform fee (PHP 20)
  processingFee  Decimal?      // PayMongo processing fee actually incurred (varies by method)
  paymentMethod  String?       // normalized method the patient paid with (card, gcash, wallet, …)
  providerNet    Decimal?      // what the provider is owed for this session (rate − appFee − processingFee)
  payoutStatus   PayoutStatus  @default(PENDING)
  payoutId       String?
  payout         Payout?       @relation(fields: [payoutId], references: [id])

  // Wallet flows
  walletApplied  Decimal   @default(0) // patient store credit used to pay for this booking
  earnedAt       DateTime? // when providerNet was released into the provider's wallet (on completion)
  refundedAt     DateTime? // when the patient was refunded to their wallet (on cancellation)

  // Reschedule proposal — provider proposes a new time, patient accepts/declines
  proposedDate      DateTime?
  proposedStartTime String?
  proposedAt        DateTime?

  // Chat read-tracking (for unread badges)
  patientReadAt  DateTime?
  providerReadAt DateTime?

  messages   Message[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([providerId, date])
  @@index([patientId])
  @@index([status])
  @@index([providerId, payoutStatus])
}

enum SenderRole {
  PATIENT
  PROVIDER
}

model Message {
  id             String     @id @default(cuid())
  bookingId      String
  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderRole     SenderRole
  text           String?
  attachment     String?    // data URI (image or file)
  attachmentName String?
  attachmentType String?
  createdAt      DateTime   @default(now())

  @@index([bookingId, createdAt])
}

model Notification {
  id                  String   @id @default(cuid())
  recipientPatientId  String?
  recipientProviderId String?
  bookingId           String?
  type                String   // BOOKING_PAID | BOOKING_CONFIRMED | RESCHEDULE_PROPOSED | PROPOSAL_ACCEPTED | PROPOSAL_DECLINED | BOOKING_CANCELLED
  title               String
  body                String?
  readAt              DateTime?
  createdAt           DateTime @default(now())

  @@index([recipientPatientId, createdAt])
  @@index([recipientProviderId, createdAt])
}

// One entry in a patient's or provider's Nickel wallet ledger. `amount` is
// signed: positive credits the balance, negative debits it. Exactly one of
// patientId / providerId is set.
model WalletTransaction {
  id         String    @id @default(cuid())
  patientId  String?
  patient    Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount     Decimal   // signed (PHP)
  balance    Decimal?  // running balance after this entry (for display)
  // Patient: REFUND (+), REDEEM (−), ADJUSTMENT. Provider: EARNING (+), PAYOUT (−), ADJUSTMENT.
  type       String
  bookingId  String?
  payoutId   String?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([patientId, createdAt])
  @@index([providerId, createdAt])
}

// ── Patient-broadcast matching ───────────────────────────────────────────────
// The reverse of the marketplace: a patient posts what they need and when, and
// therapists reach out with an offer the patient can accept (→ booking + pay).
model PatientRequest {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  city          String
  profession    String?       // preferred discipline filter (PT/OT/SLP/…), optional
  preferredDate DateTime?     // preferred visit date (date-only, UTC midnight)
  preferredTime String?       // preferred start time "HH:MM", optional
  flexibility   String?       // free text, e.g. "weekday mornings work too"
  note          String?       // what they need help with
  status        RequestStatus @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offers        RequestOffer[]

  @@index([status, city])
  @@index([patientId])
}

model RequestOffer {
  id         String         @id @default(cuid())
  requestId  String
  request    PatientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       DateTime       // offered visit date
  startTime  String         // offered start time "HH:MM"
  rate       Decimal        // the provider's rate at the time of the offer
  message    String?        // optional note to the patient
  status     OfferStatus    @default(PENDING)
  bookingId  String?        // set once the patient accepts
  createdAt  DateTime       @default(now())

  @@index([requestId])
  @@index([providerId, status])
}

// ── Tickets (concerns raised by providers or patients) ───────────────────────
model Ticket {
  id          String       @id @default(cuid())
  providerId  String?
  provider    Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  patientId   String?
  subject     String
  message     String
  status      TicketStatus @default(OPEN)
  response    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([providerId])
  @@index([status])
}
