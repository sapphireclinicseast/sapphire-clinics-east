// Nickel — its OWN database (separate from the shared sapphire_marketing DB).
// Homecare therapy marketplace: patients book licensed home therapists who set
// their own rate + schedule. Everything here is Nickel-owned (not synced from
// Operations/HR).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum PayoutStatus {
  PENDING // net earned, not yet paid out to the provider
  PAID    // included in a settled payout batch
}

model Payout {
  id         String    @id @default(cuid())
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  doctorId   String?
  doctor     Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  amount     Decimal   // total net paid in this run (PHP)
  method     String?   // snapshot of where it was sent: "bank" / "gcash"
  account    String?   // snapshot of the destination account no. / GCash no.
  accountName String?  // snapshot of the account holder name
  reference  String?   // disbursement reference (PayMongo) or manual transfer ref
  status     String    @default("PENDING") // PENDING (awaiting manual/failed) | PAID
  note       String?
  createdAt  DateTime  @default(now())
  bookings   Booking[]

  @@index([providerId])
  @@index([doctorId])
  @@index([status])
}

enum VerificationStatus {
  UNVERIFIED // account created, not yet submitted for verification
  PENDING    // documents submitted, awaiting SCEI review (24–48h)
  VERIFIED   // approved — can take bookings and appear to clients
  REJECTED   // review failed; provider may resubmit
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  PENDING_REFERRAL // posted, but NOT live to therapists until a doctor's referral is attached
  OPEN      // referral attached — therapists can see it and offer
  MATCHED   // patient accepted an offer → a booking was created
  CANCELLED // patient cancelled the request
}

enum OfferStatus {
  PENDING   // therapist reached out, waiting on the patient
  ACCEPTED  // patient accepted → booking created
  DECLINED  // patient chose someone else / declined
  WITHDRAWN // therapist withdrew
}

enum ConsultMode {
  IN_PERSON   // patient visits the doctor's clinic
  TELECONSULT // video consult over Nickel's LiveKit
}

enum ClinicBusinessType {
  SOLE_PROP
  PARTNERSHIP
  CORPORATION
}

// Session documentation
enum DocType {
  INITIAL_EVAL
  RE_EVAL
  TREATMENT
  PROGRESS_REPORT
  HEP
  // Rehab-doctor documents
  MD_INITIAL
  MD_FOLLOWUP
  MED_CERT
  PRESCRIPTION
}
enum DocVariant {
  ADULT
  PEDIA
}
enum DocStatus {
  DRAFT
  COMPLETED
}
enum DocSource {
  FORM   // filled in-app, PDF generated
  UPLOAD // therapist uploaded a PDF
  PHOTO  // therapist photographed a handwritten copy
}
// For patient-requested paid documents (Progress Report, HEP)
enum DocRequestStatus {
  REQUESTED // patient asked + paid; awaiting therapist
  READY     // therapist prepared it
  CANCELLED
}

// How a clinic-arranged visit is paid out.
enum PaymentRouting {
  THERAPIST_DIRECT // patient pays; therapist gets the net (therapist sets rate)
  CLINIC_WALLET    // pays into the clinic wallet; clinic pays the therapist's cut
}

// How money is collected for a clinic-arranged visit.
enum CollectionMode {
  ONLINE  // patient pays through Nickel (PayMongo)
  OFFLINE // clinic collects from the patient; Nickel bills the clinic the platform fee
}

enum TicketStatus {
  OPEN
  RESOLVED
}

// ── Therapist (provider) ─────────────────────────────────────────────────────
model Provider {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  photo        String?  // URL or data URI
  profession   String   @default("PT") // PT | OT | SLP | SPED | PSYCHOLOGY | ...

  // Homecare service config
  dob           DateTime? // date of birth
  citiesCovered String[] @default([]) // city NAMES this therapist serves (drives patient matching)
  coverageAreas Json?    // [{city, province, region, zip}] — richer coverage detail from the dashboard
  travelBuffer  Boolean  @default(false) // leave a 1-hour gap between bookable visits for travel
  rate          Decimal? // therapist-set homecare session rate — Treatment (Basic) (PHP)

  // Itemized service prices (the standard booking still uses `rate`)
  priceInitialEval        Decimal? // Initial Evaluation
  priceTreatmentSpecialized Decimal? // Treatment (Specialized) — needs an approved certification
  priceProgressReport     Decimal? // Progress Report (patient-requested, paid)
  priceHEP                Decimal? // Home Exercise Program (patient-requested, paid)
  transpoIncluded Boolean @default(false) // is transport included in the rate?

  // Practice profile (shown on the provider-network card)
  treatsAdults   Boolean  @default(true)  // treats adult patients
  treatsPedia    Boolean  @default(false) // treats pediatric patients
  caseCategories String[] @default([])    // general categories: Neurological, Musculoskeletal, Cardiopulmonary, ...
  commonCases    String[] @default([])    // free-text tags of cases commonly treated
  awards         String[] @default([])    // professional awards / recognitions
  pptaNumber     String?                  // PPTA (professional org) membership number
  pptaMember     Boolean  @default(false) // active member of the professional organization

  // Settings — credentials & payout
  prcNumber    String?
  ptrNumber    String?
  signature    String?  // URL or data URI of their e-signature
  bankName     String?
  bankAccountNo String?
  bankAccountName String?
  gcashNumber  String?
  gcashName    String?
  payoutMethod String?  @default("bank") // preferred settlement: "bank" or "gcash"

  // Identity & credential verification (reviewed by SCEI before the account goes live)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  facePhoto             String?  // selfie / face scan (data URI)
  prcHoldingPhoto       String?  // photo of the provider holding their PRC ID (data URI)
  school                String?  // school graduated from
  yearGraduated         String?  // year graduated (free text to preserve exact value)
  yearsExperience       String?  // years of professional experience (free text)
  postgraduate          String?  // postgraduate degree(s)
  postNominals          String?  // e.g. "PTRP, DPT" — shown after the name on the patient list
  diplomaScan           String?  // diploma scan (data URI)
  torScan               String?  // transcript of records scan (data URI)
  certifications        Json?    // [{name, file}] certification uploads (support specialized-rate requests)
  verificationSubmittedAt DateTime?
  verifiedAt            DateTime?
  rejectionReason       String?
  reviewerNote          String?  // internal note from the admin reviewer

  // Specialized rate — gated on an admin verifying a certification/specialization
  specialization        String?  // e.g. "Pediatric Neuro-developmental Treatment (NDT)"
  specializedRate       Decimal? // therapist-set rate for the specialized service
  specializedRateApproved Boolean @default(false)

  // Consent
  termsVersion    String?
  termsAcceptedAt DateTime?

  // Nickel wallet — net earnings released here on session completion; payouts draw it down.
  walletBalance Decimal @default(0)

  // If this therapist was onboarded by a partner clinic/hospital
  clinicId     String?
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  slots        ProviderSlot[]
  bookings     Booking[]
  tickets      Ticket[]
  payouts      Payout[]
  walletTxns   WalletTransaction[]
  requestOffers RequestOffer[]
  documents    SessionDocument[]
  docRequests  DocRequest[]

  @@index([active])
}

// Weekly recurring availability window for a provider.
model ProviderSlot {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0=Sun … 6=Sat
  startTime  String   // "09:00"
  endTime    String   // "17:00"
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@unique([providerId, dayOfWeek, startTime])
}

// ── Patient ──────────────────────────────────────────────────────────────────
model Patient {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  address      String?
  city         String?
  dob          DateTime?
  sex          String?  // Male | Female — collected at signup, auto-fills PT forms
  // Nickel wallet — refundable store credit; can be applied at checkout.
  walletBalance Decimal @default(0)
  // If this patient was onboarded by a partner clinic/hospital
  clinicId     String?
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
  walletTxns   WalletTransaction[]
  requests     PatientRequest[]
  consults     Consult[]
  documents    SessionDocument[]
  docRequests  DocRequest[]
  walletTopups WalletTopup[]

  @@index([city])
}

// A patient adding refundable store credit to their Nickel wallet via PayMongo.
model WalletTopup {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount         Decimal   // PHP added on success
  status         String    @default("PENDING") // PENDING | PAID
  paymongoLinkId String?
  checkoutUrl    String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([patientId])
  @@index([paymongoLinkId])
}

// ── Booking ──────────────────────────────────────────────────────────────────
model Booking {
  id         String        @id @default(cuid())
  patientId  String
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider      @relation(fields: [providerId], references: [id])
  city       String
  date       DateTime      // visit date (date-only, UTC midnight)
  startTime  String        // "10:00"
  endTime    String        // "11:00"
  status     BookingStatus @default(PENDING)
  amount     Decimal       // total charged (therapist rate; +transport if not included, handled in app)
  transpoIncluded Boolean  @default(false)
  notes      String?

  // Doctor's referral — required to avail of PT in the Philippines. Either the
  // patient uploads their own, or one issued by a Nickel rehab-doctor consult.
  referralFile     String?  // data URI of the uploaded/issued referral
  referralConsultId String? // the Consult that produced the referral, if any

  // Payment (Verdana PayMongo account)
  paymongoLinkId String?
  checkoutUrl    String?
  paidAt         DateTime?

  // Earnings split — computed when the booking is paid (see src/lib/earnings.ts)
  appFee         Decimal?      // Nickel's flat platform fee (PHP 20)
  processingFee  Decimal?      // PayMongo processing fee actually incurred (varies by method)
  paymentMethod  String?       // normalized method the patient paid with (card, gcash, wallet, …)
  providerNet    Decimal?      // what the provider is owed for this session (rate − appFee − processingFee)
  payoutStatus   PayoutStatus  @default(PENDING)
  payoutId       String?
  payout         Payout?       @relation(fields: [payoutId], references: [id])

  // Wallet flows
  walletApplied  Decimal   @default(0) // patient store credit used to pay for this booking
  earnedAt       DateTime? // when providerNet was released into the provider's wallet (on completion)
  refundedAt     DateTime? // when the patient was refunded to their wallet (on cancellation)

  // Clinic-arranged booking (partner clinic/hospital)
  clinicId       String?
  clinic         Clinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  paymentRouting PaymentRouting? // null = normal marketplace booking (therapist-direct)
  collectionMode CollectionMode? // how the money is collected for clinic bookings
  therapistCut   Decimal?        // therapist's cut in CLINIC_WALLET mode (clinic sets it)

  // Reschedule proposal — provider proposes a new time, patient accepts/declines
  proposedDate      DateTime?
  proposedStartTime String?
  proposedAt        DateTime?

  // Chat read-tracking (for unread badges)
  patientReadAt  DateTime?
  providerReadAt DateTime?

  // Patient's rating of the therapist after a completed session (0–5)
  rating         Int?
  review         String?
  ratedAt        DateTime?

  messages   Message[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([providerId, date])
  @@index([patientId])
  @@index([status])
  @@index([providerId, payoutStatus])
}

enum SenderRole {
  PATIENT
  PROVIDER
}

model Message {
  id             String     @id @default(cuid())
  bookingId      String
  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderRole     SenderRole
  text           String?
  attachment     String?    // data URI (image or file)
  attachmentName String?
  attachmentType String?
  createdAt      DateTime   @default(now())

  @@index([bookingId, createdAt])
}

model Notification {
  id                  String   @id @default(cuid())
  recipientPatientId  String?
  recipientProviderId String?
  recipientDoctorId   String?
  bookingId           String?
  consultId           String?
  type                String   // BOOKING_* | RESCHEDULE_* | PROPOSAL_* | REQUEST_OFFER | OFFER_ACCEPTED | CONSULT_* | REFERRAL_READY
  title               String
  body                String?
  readAt              DateTime?
  createdAt           DateTime @default(now())

  @@index([recipientPatientId, createdAt])
  @@index([recipientProviderId, createdAt])
  @@index([recipientDoctorId, createdAt])
}

// One entry in a patient's or provider's Nickel wallet ledger. `amount` is
// signed: positive credits the balance, negative debits it. Exactly one of
// patientId / providerId is set.
model WalletTransaction {
  id         String    @id @default(cuid())
  patientId  String?
  patient    Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  doctorId   String?
  doctor     Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId   String?
  clinic     Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  amount     Decimal   // signed (PHP)
  balance    Decimal?  // running balance after this entry (for display)
  // Patient: REFUND (+), REDEEM (−), ADJUSTMENT. Provider: EARNING (+), PAYOUT (−), ADJUSTMENT.
  type       String
  bookingId  String?
  payoutId   String?
  // For EARNING credits: when this money becomes payable (PayMongo settlement +
  // a Nickel hold). The rolling-payout cron only pays matured, unpaid earnings.
  payoutEligibleAt DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([patientId, createdAt])
  @@index([providerId, createdAt])
  @@index([doctorId, createdAt])
  @@index([clinicId, createdAt])
  @@index([type, payoutId, payoutEligibleAt])
}

// A clinical document tied to a patient (and usually a booking): a session note,
// evaluation, progress report, or home exercise program.
model SessionDocument {
  id         String     @id @default(cuid())
  patientId  String
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String?    // therapist author (PT documents)
  provider   Provider?  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  doctorId   String?    // rehab-doctor author (MD documents)
  doctor     Doctor?    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  bookingId  String?    // the session this documents (null for standalone reports)
  consultId  String?    // the consult this documents (doctor documents)

  type       DocType
  variant    DocVariant?  // ADULT / PEDIA (auto from patient age; null for report/HEP)
  source     DocSource    @default(FORM)
  data       Json?        // structured form fields when source = FORM
  file       String?      // data URI: generated PDF, uploaded PDF, or photo
  status     DocStatus    @default(DRAFT)

  // Set when this document fulfils a patient-requested paid item
  requestId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([patientId])
  @@index([providerId])
  @@index([doctorId])
  @@index([bookingId])
}

// A patient's paid request for a Progress Report or HEP; alerts the therapist.
model DocRequest {
  id         String           @id @default(cuid())
  patientId  String
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type       DocType          // PROGRESS_REPORT or HEP
  bookingId  String?          // the visit this relates to
  amount     Decimal
  status     DocRequestStatus @default(REQUESTED)
  paymongoLinkId String?
  checkoutUrl    String?
  paidAt         DateTime?
  documentId     String?      // the SessionDocument that fulfilled it
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([providerId, status])
  @@index([patientId])
}

// ── Partner clinic / hospital ────────────────────────────────────────────────
model Clinic {
  id            String   @id @default(cuid())
  name          String   // business / trade name
  email         String   @unique
  passwordHash  String
  contactPerson String?
  phone         String?
  businessType  ClinicBusinessType @default(SOLE_PROP)
  tin           String?
  address       String?
  city          String?

  // Business documents (data URIs)
  secDtiFile        String? // SEC (corp/partnership) or DTI (sole prop) registration
  bir2303File       String? // BIR Form 2303 (Certificate of Registration)
  aoiFile           String? // Articles of Incorporation (corporations)
  byLawsFile        String? // By-Laws (corporations)
  businessPermitFile String? // Mayor's/Business permit

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationSubmittedAt DateTime?
  verifiedAt    DateTime?
  rejectionReason String?

  // Clinic wallet — receives net for CLINIC_WALLET bookings; clinic pays therapists from it.
  walletBalance Decimal @default(0)
  // Fees the clinic owes Nickel for OFFLINE-collected bookings (₱20/booking).
  feesOwed      Decimal @default(0)

  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patients   Patient[]
  providers  Provider[]
  walletTxns WalletTransaction[]
  bookings   Booking[]

  @@index([active])
}

// ── Rehab doctor (physiatrist) — issues referrals & runs consults ────────────
model Doctor {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  phone        String?
  photo        String?
  prcNumber    String?
  ptrNumber    String?  // PTR number — auto-fills the prescription pad
  signature    String?  // e-signature data URI — auto-fills documents
  postNominals String?  // e.g. "MD, FPARM"
  specialization String? @default("Rehabilitation Medicine (Physiatry)")

  // Consult offering
  consultFee   Decimal? // fee for one consult (PHP)
  teleconsultEnabled Boolean @default(true)
  inPersonEnabled    Boolean @default(false)
  clinicName   String?
  clinicAddress String?
  clinicCity   String?

  // Payout details
  bankName      String?
  bankAccountNo String?
  bankAccountName String?
  gcashNumber   String?
  payoutMethod  String?  @default("bank") // preferred settlement: "bank" or "gcash"

  // Consent
  termsVersion    String?
  termsAcceptedAt DateTime?

  // Verification (SCEI approves before the doctor is bookable)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  prcLicenseFile   String?  // photo/scan of PRC licence (data URI)
  governmentIdFile String?  // photo of a government ID (data URI)
  verificationSubmittedAt DateTime?
  verifiedAt    DateTime?
  rejectionReason String?

  walletBalance Decimal @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  slots         DoctorSlot[]
  consults      Consult[]
  walletTxns    WalletTransaction[]
  documents     SessionDocument[]
  payouts       Payout[]

  @@index([active])
}

model DoctorSlot {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
}

model Consult {
  id         String        @id @default(cuid())
  patientId  String
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String
  doctor     Doctor        @relation(fields: [doctorId], references: [id])
  mode       ConsultMode
  date       DateTime
  startTime  String
  endTime    String
  status     BookingStatus @default(PENDING)
  amount     Decimal
  reason     String?       // patient's reason for the consult

  // Payment (Verdana PayMongo account) + split
  paymongoLinkId String?
  checkoutUrl    String?
  paidAt         DateTime?
  appFee         Decimal?
  processingFee  Decimal?
  paymentMethod  String?
  doctorNet      Decimal?
  payoutStatus   PayoutStatus @default(PENDING)
  earnedAt       DateTime?

  // Teleconsult (LiveKit)
  roomName   String?

  // Outcome
  doctorNotes    String?
  referralIssued Boolean @default(false)
  referralFile   String? // data URI of the referral the doctor issued

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([doctorId, date])
  @@index([patientId])
  @@index([status])
}

// Web-push subscription for a signed-in user (any role). One row per browser.
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  patientId  String?
  providerId String?
  doctorId   String?
  createdAt  DateTime @default(now())

  @@index([patientId])
  @@index([providerId])
  @@index([doctorId])
}

// ── Patient-broadcast matching ───────────────────────────────────────────────
// The reverse of the marketplace: a patient posts what they need and when, and
// therapists reach out with an offer the patient can accept (→ booking + pay).
model PatientRequest {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  city          String
  profession    String?       // preferred discipline filter (PT/OT/SLP/…), optional
  preferredDate DateTime?     // preferred visit date (date-only, UTC midnight)
  preferredTime String?       // preferred start time "HH:MM", optional
  flexibility   String?       // free text, e.g. "weekday mornings work too"
  note          String?       // what they need help with
  status        RequestStatus @default(PENDING_REFERRAL)
  referralFile      String?   // doctor's referral (data URI) — required to go live
  referralConsultId String?   // or a referral issued by a Nickel rehab-doctor consult
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offers        RequestOffer[]

  @@index([status, city])
  @@index([patientId])
}

model RequestOffer {
  id         String         @id @default(cuid())
  requestId  String
  request    PatientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       DateTime       // offered visit date
  startTime  String         // offered start time "HH:MM"
  rate       Decimal        // the provider's rate at the time of the offer
  message    String?        // optional note to the patient
  status     OfferStatus    @default(PENDING)
  bookingId  String?        // set once the patient accepts
  createdAt  DateTime       @default(now())

  @@index([requestId])
  @@index([providerId, status])
}

// ── Tickets (concerns raised by providers or patients) ───────────────────────
model Ticket {
  id          String       @id @default(cuid())
  providerId  String?
  provider    Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  patientId   String?
  subject     String
  message     String
  status      TicketStatus @default(OPEN)
  response    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([providerId])
  @@index([status])
}
