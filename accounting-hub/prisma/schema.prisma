generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  INVESTOR
  ACCOUNTANT
  BOOKKEEPER
  PAYROLL_OFFICER
  VIEWER
  AHEA_ADMIN
  AHGH_ADMIN
  VERDANA_ADMIN
  AHEA_FRONTDESK
  AHGH_FRONTDESK
  HMO_OFFICER
  MEDREP
}

enum Branch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  VERDANA_STORE
  AURA_INSTITUTE
  ALL
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// ── HR Branch Registry (synced cache) ───────────────────────────
// Local read-only cache of HR Platform's Branches Registry — HR Platform is
// the source of truth (see HR Platform's `modules/branches`). Populated via
// admin-triggered POST /api/branches/sync (full replace, direct connection
// via HR_PLATFORM_URL + EXTERNAL_API_KEY, same plumbing as
// src/lib/external-staff.ts). Do not edit rows here directly — edits belong
// in HR Platform. Note: Branch.ALL / ServiceBranch.ALL are pseudo-branch
// sentinels ("applies to every branch") and never get an HrBranch row.
model HrBranch {
  id                       String   @id // HR Platform's kebab-case branch id — the sync key
  shortCode                String
  aliases                  String[] @default([])
  opsHubBranch             String?
  opsHubClassPortalBranch  String?
  acctHubBranch            String?
  acctHubServiceBranch     String?
  teletherapyBranch        String?
  name                     String
  brandName                String?
  tin                      String?
  address                  String?
  phone                    String?
  emailMain                String?
  emailHr                  String?
  emailAccounting          String?
  departmentsOffered       String[] @default([])
  operatingDays            String[] @default([])
  operatingHoursOpen       String?
  operatingHoursClose      String?
  active                   Boolean  @default(true)
  syncedAt                 DateTime @default(now())
}

// ── User ─────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(VIEWER)
  branch           Branch?
  branches         Branch[]  @default([]) // multi-branch access; when set, overrides the single `branch`
  disabled         Boolean   @default(false) // soft-deleted/deactivated — blocked from login
  avatar           String?
  resetToken       String?
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AuditLog[]
  accounts  Account[]

  servicesCreated      Service[]                  @relation("ServiceCreatedBy")
  suppliersCreated     Supplier[]                 @relation("SupplierCreatedBy")
  supplierRequests     SupplierRequest[]          @relation("SupplierRequestPreparedBy")
  inventoryItems       InventoryItem[]            @relation("ItemCreatedBy")
  quotationsCreated    Quotation[]                @relation("QuotationCreatedBy")
  quotationTemplates   QuotationTemplate[]        @relation("QuotationTemplateUploadedBy")
  inventoryAdjustments InventoryAdjustment[]      @relation("AdjustmentBy")
  inventoryAdjBatches  InventoryAdjustmentBatch[] @relation("AdjBatchCreatedBy")
  transfersRequested   ConsignmentTransfer[]      @relation("TransferRequestedBy")
  transfersApproved    ConsignmentTransfer[]      @relation("TransferApprovedBy")

  referrersCreated Referrer[]        @relation("ReferrerCreatedBy")
  walletLogs       WalletLog[]       @relation("WalletLogBy")
  ordersCreated    Order[]           @relation("OrderCreatedBy")
  discountSettings DiscountSetting[] @relation("DiscountCreatedBy")
  arPayments       ARPayment[]       @relation("ARPaymentCreatedBy")
  soaSubmissions   SoaSubmission[]   @relation("SoaSubmissionCreatedBy")
  payrollEntries   PayrollEntry[]    @relation("PayrollCreatedBy")
  incentiveRules   IncentiveRule[]   @relation("IncentiveCreatedBy")
  assets           Asset[]           @relation("AssetCreatedBy")
  glCases          GlCase[]          @relation("GlCaseCreatedBy")

  @@index([email])
  @@index([role])
  servicePriceChanges ServicePriceHistory[] @relation("ServicePriceChangedBy")
}

// ── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ── Chart of Accounts ──────────────────────────────────────

model Account {
  id                String        @id @default(cuid())
  accountNumber     String        @unique
  accountTitle      String
  accountType       AccountType
  subType           String?
  subSubType        String? // Sub-sub classification (e.g., PT, OT, ST for inventory types)
  normalBalance     NormalBalance
  currency          String        @default("PHP") // PHP, USD, CNY, EUR, JPY, etc.
  description       String?
  isActive          Boolean       @default(true)
  isBankAccount     Boolean       @default(false) // Current-asset account that is a bank account (shows in Fund Transfer dropdowns)
  isCheckingAccount Boolean       @default(false) // Bank account that is specifically a checking account (Check Release Monitoring)
  // Bank account that actually takes part in buying foreign currency. Only these
  // are paired when matching a currency exchange, so unrelated accounts that
  // merely happen to hold another currency are not offered.
  isForexAccount    Boolean       @default(false)
  // A closed bank account, retired from all bank behavior: it leaves every
  // payment/transfer dropdown and the Bank Rec section, and no statements can
  // be uploaded to it. The GL account itself stays ACTIVE so reports, history
  // and opening balances are untouched (deactivating drops openings silently).
  // Only settable when the last statement balance is zero and no line is
  // PENDING — enforced server-side.
  bankRetiredAt     DateTime?
  // The branch a bank account belongs to. A bank statement is whole-account and
  // cannot be split, so without this a branch view has no way to say which cash
  // is its own: it fell back to "movement tagged to this branch", which carries
  // no opening balance and cannot be trued to any statement — Greenhills read
  // -P12.0M on its own checking account. Null means shared/corporate (SCEI Main,
  // SCI) and belongs to no single branch.
  branch            Branch?
  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  services               Service[]
  quotations             Quotation[]                @relation("QuotationBankAccount")
  inventoryItems         InventoryItem[]            @relation("InventoryRevenueAccount")
  inventorySourceItems   InventoryItem[]            @relation("InventorySourceAccount")
  inventoryExpenseItems  InventoryItem[]            @relation("InventoryExpenseAccount")
  discountSettings       DiscountSetting[]
  voucherDiscounts       Voucher[]                  @relation("VoucherDiscountAccount")
  wallets                DigitalWallet[]            @relation("WalletAccount")
  arPaymentDiscounts     ARPayment[]                @relation("ARPaymentDiscountAccount")
  arPaymentCashAccounts  ARPayment[]                @relation("ARPaymentCashAccount")
  arPaymentOverpayments  ARPayment[]                @relation("ARPaymentOverpaymentAccount")
  unitPaysExpense        UnitPay[]                  @relation("UnitPayExpense")
  taxPaymentsFrom        TaxPayment[]               @relation("TaxPaymentFrom")
  taxSettings            PayrollTaxSettings[]       @relation("TaxLiability")
  paymentModes           PaymentMode[]              @relation("PaymentModeAccount")
  paymentModeSettlements PaymentMode[]              @relation("PaymentModeSettlementAccount")
  paymentModeDeductions  PaymentModeDeduction[]     @relation("DeductionAccount")
  journalLines           JournalEntryLine[]
  salaryPaymentsFrom     SalaryPayment[]            @relation("SalaryPaymentFrom")
  benefitPaymentsFrom    BenefitPayment[]           @relation("BenefitPaymentFrom")
  // PayrollCOAMapping relations
  coaSalaryExpense       PayrollCOAMapping[]        @relation("COASalaryExpense")
  coaProfessionalFees    PayrollCOAMapping[]        @relation("COAProfFees")
  coaSssER               PayrollCOAMapping[]        @relation("COASSSER")
  coaHdmfER              PayrollCOAMapping[]        @relation("COAHdmfER")
  coaPhilhealthER        PayrollCOAMapping[]        @relation("COAPhilER")
  coaSalariesPayable     PayrollCOAMapping[]        @relation("COASalPayable")
  coaBenefitsPayable     PayrollCOAMapping[]        @relation("COABenPayable")
  coaTaxPayable          PayrollCOAMapping[]        @relation("COATaxPayable")
  beginningBalances      BeginningBalance[]
  adjBatchFxSources      InventoryAdjustmentBatch[] @relation("AdjBatchFxSource")
  issuedCheques          IssuedCheque[]

  @@index([accountType])
  @@index([isActive])
  @@index([createdById])
}

// ── Services ───────────────────────────────────────────────

enum ServiceBranch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  VERDANA_STORE
  ALL
}

enum PriceType {
  FIXED
  ADJUSTABLE
}

enum RevenueType {
  EARNED
  UNEARNED
}

model Service {
  id                    String        @id @default(cuid())
  name                  String
  department            String
  branch                ServiceBranch
  price                 Decimal
  newPrice              Decimal?
  newPriceEffectiveDate DateTime?
  priceType             PriceType     @default(FIXED)
  revenueType           RevenueType   @default(EARNED)
  walletType            String? // VIP, PACKAGE, PREPAID_CARD, DOWNPAYMENT, ADVANCE — only for UNEARNED
  vipTier               String? // PLATINUM, GOLD, SILVER — only for VIP type
  packageSessions       Int? // Number of sessions included (only for PACKAGE type)
  hasDoctorFee          Boolean       @default(false)
  doctorFee             Decimal?
  clinicFee             Decimal?
  // Scheduled fee split that takes effect together with newPrice on its
  // effective date; the current doctorFee/clinicFee stay until then.
  newDoctorFee          Decimal?
  newClinicFee          Decimal?
  pwdDiscountClinicOnly Boolean       @default(false)
  noPwdDiscount         Boolean       @default(false)
  description           String?
  revenueAccountId      String?
  revenueAccount        Account?      @relation(fields: [revenueAccountId], references: [id], onDelete: SetNull)
  unitPayId             String?
  unitPay               UnitPay?      @relation(fields: [unitPayId], references: [id], onDelete: SetNull)
  unitPayEnabled        Boolean       @default(true)
  thresholdCounted      Boolean       @default(false) // include in daily patient-threshold incentive count
  thresholdQty          Decimal       @default(1) // sessions credited per unit (e.g. 2 for a 2-hour, 0.5 for a half session)
  issuedOfficialInvoice Boolean       @default(false)
  isHmoGl               Boolean       @default(false) // service billed to HMO / Guarantee Letter → sales are receivables
  // How this service is settled: CASH (patient pays) | HMO | GL. Finer-grained
  // than isHmoGl (which stays true for both HMO and GL — receivables logic
  // reads it); drives the Payment Type column/filter on the Services page.
  paymentType           String        @default("CASH")
  hmoPaysClinicianDirect Boolean      @default(false) // HMO pays the clinician directly — sessions are monitored apart from our AR
  // Revenue recognized over N months starting the transaction month (tuition
  // and other period fees). null/1 = immediate. Applied by the reports engine.
  recognitionMonths     Int?
  isActive              Boolean       @default(true)
  createdById           String
  createdBy             User          @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  priceHistory          ServicePriceHistory[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  branchPrices        ServiceBranchPrice[]
  orderItems          OrderItem[]
  walletDiscountRules WalletDiscountRule[]
  eligibleFor         ServiceEligibility[] @relation("ParentService")
  eligibleIn          ServiceEligibility[] @relation("EligibleService")

  @@index([department])
  @@index([branch])
  @@index([isActive])
  @@index([createdById])
  @@index([revenueAccountId])
  @@index([unitPayId])
}

// Per-branch price overrides for services with branch = ALL
/// Money changes on a Service, recorded as they happen so the team can see what a
/// service used to cost and when it moved. The audit log only ever stored which
/// FIELDS changed, never the values, so history begins at the BASELINE row written
/// for each service when this table was introduced.
model ServicePriceHistory {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch      String?  // set when the change came from a per-branch price override
  field       String   // price | doctorFee | clinicFee | newPrice
  oldValue    Decimal? @db.Decimal(12, 2)
  newValue    Decimal? @db.Decimal(12, 2)
  source      String   @default("EDIT")  // EDIT | BASELINE | SCHEDULED
  note        String?
  changedById String?
  changedBy   User?    @relation("ServicePriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())

  @@index([serviceId, changedAt])
}

model ServiceBranchPrice {
  id                    String    @id @default(cuid())
  serviceId             String
  service               Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch                String // SANDBOX_EAST or SANDBOX_GREENHILLS
  price                 Decimal
  newPrice              Decimal?
  newPriceEffectiveDate DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([serviceId, branch])
  @@index([serviceId])
  @@index([branch])
}

// Links a package/VIP service to the earned services it covers
model ServiceEligibility {
  id                String   @id @default(cuid())
  parentServiceId   String // The package or VIP service
  parentService     Service  @relation("ParentService", fields: [parentServiceId], references: [id], onDelete: Cascade)
  eligibleServiceId String // The earned service that qualifies
  eligibleService   Service  @relation("EligibleService", fields: [eligibleServiceId], references: [id], onDelete: Cascade)
  discountPercent   Decimal? // For VIP: the discount % on this service
  sessionCost       Decimal  @default(1) // For PACKAGE: sessions deducted per unit of this service (0.5 steps)
  createdAt         DateTime @default(now())

  @@unique([parentServiceId, eligibleServiceId])
  @@index([parentServiceId])
  @@index([eligibleServiceId])
}

// ── Inventory & Procurement ────────────────────────────────

enum AdjustmentType {
  SHRINKAGE
  INCREASE
}

enum TransferStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  RETURNED
  CANCELLED
}

model Supplier {
  id                  String   @id @default(cuid())
  supplierName        String
  email               String?
  contactNumber       String?
  // Who to actually speak to, and where. Foreign suppliers are usually reached on
  // a messaging app rather than by phone, so the channel is worth recording.
  contactPerson       String?
  contactMethod       String? // WeChat | WhatsApp | Viber | Facebook | SMS | Email | Call | Other
  contactHandle       String? // the id/number on that channel, when not the phone number
  isForeign           Boolean  @default(false)
  currency            String   @default("PHP")
  defaultExchangeRate Decimal?
  address             String?
  notes               String?
  isActive            Boolean  @default(true)
  createdById         String
  createdBy           User     @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inventoryItems InventoryItem[]
  assets         Asset[]
  requests       SupplierRequest[]

  @@index([isActive])
  @@index([createdById])
}

/// Per-branch .docx letterhead a quotation is generated onto. The uploaded file is
/// kept verbatim — generation clones it and writes the body inside, so the header,
/// footer and artwork stay exactly as the branch designed them.
model QuotationTemplate {
  id           String   @id @default(cuid())
  branch       String   @unique // AHEA | AHGH | VERDANA | INSTITUTE
  fileName     String // original upload name, shown in Settings
  storedName   String // file in uploads/, served via /api/files/[filename]
  uploadedById String
  uploadedBy   User     @relation("QuotationTemplateUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quotation {
  id                  String   @id @default(cuid())
  quotationNumber     String   @unique
  branch              String // AHEA | AHGH | VERDANA | INSTITUTE
  recipientName       String
  recipientEmail      String?
  recipientPhone      String?
  contactPerson       String?
  datePrepared        DateTime
  validityDays        Int // 30 | 45 | 60 | 90
  usePwdRate          Boolean  @default(false)
  globalDiscountType  String? // PERCENT | AMOUNT — "special discount for all"
  globalDiscountValue Decimal?
  remarks             String?
  /// Downpayment required to reserve the booking: 20 | 30 | 40 | 50 (percent).
  downpaymentPercent  Int?
  /// Where the downpayment is to be deposited. The name/number/bank are copied
  /// alongside so a quotation already sent still reads correctly if the account
  /// is later renamed or retired.
  bankAccountId       String?
  bankAccount         Account? @relation("QuotationBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankAccountName     String?
  bankAccountNumber   String?
  bankName            String?
  preparedByName      String
  preparedByPosition  String
  signatureUrl        String? // uploaded e-sig or a drawn signature, both stored as images
  subtotalGross       Decimal  @default(0)
  grandTotal          Decimal  @default(0)
  createdById         String
  createdBy           User     @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items QuotationItem[]

  @@index([branch])
  @@index([createdAt])
}

/// A line on the quotation. Name/price/department are copied at generation time so a
/// later price change never rewrites a quotation that has already gone out.
model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  kind            String // SERVICE | PRODUCT
  serviceId       String?
  inventoryItemId String?
  name            String
  department      String? // services
  sku             String? // products
  imageUrl        String? // products — the photo printed on the quotation
  grossPrice      Decimal
  discountedPrice Decimal? // null when the line carries no discount
  discountLabel   String? // PWD, 10%, ₱500 off — printed so the reader sees why
  quantity        Int       @default(1)
  lineTotal       Decimal
  sortOrder       Int       @default(0)

  @@index([quotationId])
}

model InventoryItem {
  id                    String    @id @default(cuid())
  name                  String
  sku                   String    @unique
  skuDepartment         String
  skuCategory           String
  skuSubcategory        String
  skuSequence           Int
  barcode               String?
  imageUrl              String? // product photo (shown in Inventory + adjustment rows)
  branch                Branch
  accountSubType        String?
  unitCost              Decimal   @default(0)
  initialUnitCost       Decimal? // Original unit cost set at item creation
  sellingPrice          Decimal?
  rewardPointsPrice     Int? // Price in reward points (e.g., 1000 pts)
  quantity              Int       @default(0)
  branchStock           Json? // Display-only per-branch split of `quantity` for consigned stock, e.g. { "SANDBOX_GREENHILLS": 2 }. `quantity` remains the authoritative TOTAL for FIFO/COGS/BS; this only records where the units physically sit (folded-in from the retired '-SAND' consignment rows).
  sourceItemId          String? // For a branch consignment copy: the pool (source) item it was received from. Lets checkout/receive find the branch row without guessing at SKU suffixes.
  reorderLevel          Int?
  supplierId            String?
  supplier              Supplier? @relation(fields: [supplierId], references: [id])
  supplierProductName   String? // what the supplier calls this item on their catalogue/invoice — our `name` is the internal one, so this is how you find it when reordering
  description           String? // free-text description of the product (materials, contents, what it is for)
  supplierExchangeRate  Decimal?
  dimensionLength       Decimal? // cm — length inclusive of packaging (for CBM)
  dimensionWidth        Decimal? // cm — width inclusive of packaging (for CBM)
  dimensionHeight       Decimal? // cm — height inclusive of packaging (for CBM)
  weightKg              Decimal? // kg — shipping weight inclusive of packaging (drives store shipping rates)
  revenueAccountId      String?
  revenueAccount        Account?  @relation("InventoryRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: SetNull)
  sourceAccountId       String?
  sourceAccount         Account?  @relation("InventorySourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  expenseAccountId      String?
  expenseAccount        Account?  @relation("InventoryExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  isBundle              Boolean   @default(false)
  fromPettyCash         Boolean   @default(false) // bought via petty cash / expense — cash handled by replenishment, so NOT counted as an inventory cash outflow on the BS (avoids double-count)
  issuedOfficialInvoice Boolean   @default(false)
  isPreOrder            Boolean   @default(false) // deliberately kept at 0 stock (e.g. swings) — stays sellable at 0; negative qty is the backlog, netted off when the arrival is recorded
  websiteClassification String? // customer-facing category on verdanarehab.com (Merch & Resources, Pretend Play & Learning Toys, Sensory Therapeutic Tools, Active & Sensory Play, Furniture & Room Pieces). Internal SKU dept/category stays unchanged.
  isActive              Boolean   @default(true)
  createdById           String
  createdBy             User      @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  adjustments      InventoryAdjustment[]
  consignments     ConsignmentTransfer[]
  orderItems       OrderItem[]
  variants         InventoryVariant[]
  bundleComponents BundleComponent[]     @relation("BundleParent")
  componentOf      BundleComponent[]     @relation("BundleChild")

  @@index([branch])
  @@index([skuDepartment])
  @@index([supplierId])
  @@index([isActive])
  @@index([createdById])
  @@index([isBundle])
  @@index([revenueAccountId])
  @@index([sourceAccountId])
  @@index([expenseAccountId])
  @@index([sourceItemId])
  supplierRequestItems SupplierRequestItem[]
}

model BundleComponent {
  id          String        @id @default(cuid())
  bundleId    String
  bundle      InventoryItem @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId String
  component   InventoryItem @relation("BundleChild", fields: [componentId], references: [id], onDelete: Restrict)
  quantity    Int           @default(1) // How many of this component per bundle
  createdAt   DateTime      @default(now())

  @@unique([bundleId, componentId])
  @@index([bundleId])
  @@index([componentId])
}

model InventoryVariant {
  id           String        @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variantType  String        @default("Color") // e.g. "Color", "Size", "Material", "Flavor", "Scent"
  variantLabel String // e.g. "Red", "Large", "Wood", "Strawberry"
  variantSku   String        @unique // e.g. "OT-TOY-THE-001-RED"
  barcode      String?       @unique
  quantity     Int           @default(0)
  adjustments  InventoryAdjustment[]
  // Per-variant cost and price. NULL = inherit the parent item's figure, so existing
  // variants keep behaving exactly as before. Set these when variants genuinely differ
  // (e.g. The Petite Pouf in polyester vs cotton — different landed cost and price).
  unitCost     Decimal?      @db.Decimal(12, 2)
  sellingPrice Decimal?      @db.Decimal(12, 2)
  // Per-variant physical specs, NULL = inherit the parent item's figure. Size
  // variants (e.g. a SMALL vs LARGE pouf) ship in genuinely different boxes,
  // and weight drives the verdanarehab.com shipping fee at checkout.
  dimensionLength Decimal?   @db.Decimal(10, 2)  // cm, inclusive of packaging
  dimensionWidth  Decimal?   @db.Decimal(10, 2)  // cm
  dimensionHeight Decimal?   @db.Decimal(10, 2)  // cm
  weightKg        Decimal?   @db.Decimal(10, 3)  // kg, inclusive of packaging
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([itemId])
  @@index([variantType])
  @@index([variantLabel])
}

model InventoryAdjustment {
  id                String                    @id @default(cuid())
  itemId            String
  item              InventoryItem             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Which variant this movement applies to. NULL = the product as a whole (how every
  // adjustment before 2026-08 was recorded, and still correct for items without variants).
  variantId         String?
  variant           InventoryVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type              AdjustmentType
  quantityChange    Int
  remainingQuantity Int? // FIFO: units still available (INCREASE lots only)
  previousQuantity  Int
  newQuantity       Int
  adjustmentDate    DateTime
  remarks           String
  batchId           String? // Groups adjustments from same bulk upload
  batchRefId        String? // FK to InventoryAdjustmentBatch (freight batches)
  batch             InventoryAdjustmentBatch? @relation(fields: [batchRefId], references: [id])
  referenceNumber   String? // Auto-generated display reference
  foreignCost       Decimal? // Cost per unit in foreign currency
  foreignCurrency   String? // e.g. CNY, USD
  exchangeRate      Decimal? // Computed: localTotal / foreignTotal
  localCost         Decimal? // Cost per unit in PHP (after exchange)
  freightAllocation Decimal? // Pro-rated freight cost allocated to this item
  totalLandedCost   Decimal? // localCost * qty + freightAllocation
  countedQuantity   Int? // physical-count shrinkage: the counted amount
  auditorName       String? // inventory audit: name of person who conducted the count
  auditorSignature  String? // inventory audit: auditor e-signature (URL/data-URL)
  auditPeriodFrom   DateTime? // inventory audit: period covered — from
  auditPeriodTo     DateTime? // inventory audit: period covered — to
  proofUrls         Json? // inventory audit: proof documents/photos (string[])
  adjustedById      String
  adjustedBy        User                      @relation("AdjustmentBy", fields: [adjustedById], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now())

  @@index([itemId])
  @@index([variantId])
  @@index([adjustedById])
  @@index([adjustmentDate])
  @@index([batchId])
  @@index([batchRefId])
}

// A purchase request sent to a supplier: what we want, how many, and who asked.
// The printed sheet quotes the supplier's own product name, since that is what
// they recognise when reordering.
model SupplierRequest {
  id             String    @id @default(cuid())
  referenceNumber String   @unique // SR-YYYYMMDD-NNN
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestDate    DateTime
  status         String    @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED
  remarks        String?
  // Captured at creation so the printed sheet keeps saying who prepared it even
  // if the account is renamed or deactivated later.
  preparedByName String
  preparedById   String?
  preparedBy     User?     @relation("SupplierRequestPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items SupplierRequestItem[]

  @@index([supplierId])
  @@index([requestDate])
}

model SupplierRequestItem {
  id        String          @id @default(cuid())
  requestId String
  request   SupplierRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Int
  remarks   String?
  createdAt DateTime        @default(now())

  @@index([requestId])
  @@index([itemId])
}

// Consumable pre-numbered forms (e.g. ADMIN01) tracked by control-number range.
// Received pcs = numeric(toControl) − numeric(fromControl) + 1. Toggled per branch.
model FormReceipt {
  id            String   @id @default(cuid())
  branch        String
  formType      String // form code / series, e.g. "ADMIN01"
  dateReceived  DateTime
  fromControl   String // starting control number (string preserves zero-padding)
  toControl     String // ending control number
  quantity      Int // computed pcs in the range
  remarks       String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([branch])
  @@index([formType])
}

model InventoryAdjustmentBatch {
  id                 String               @id @default(cuid())
  referenceNumber    String               @unique
  adjustmentDate     DateTime
  hasForeignPurchase Boolean              @default(true)
  foreignCurrency    String?
  exchangeRate       Decimal?
  freight1Amount     Decimal? // Manufacturing → Warehouse
  freight1IsForeign  Boolean              @default(false)
  freight2Amount     Decimal? // Foreign → Local
  freight2IsForeign  Boolean              @default(false)
  freight3Amount     Decimal? // Warehouse → Office
  freight3IsForeign  Boolean              @default(false)
  totalFreightPHP    Decimal              @default(0)
  // FX source: the foreign-currency bank account the payment was drawn from. The
  // suggested exchange rate is the weighted purchase rate of that account's forex
  // buys (Fund Transfer cross-currency history recorded via Bank Recon).
  fxSourceAccountId  String?
  fxSourceAccount    Account?             @relation("AdjBatchFxSource", fields: [fxSourceAccountId], references: [id], onDelete: SetNull)
  // Payments behind this shipment — possibly recorded as separate Expense RFPs:
  // one paying the manufacturer, one paying the freight forwarder.
  manufacturerRfpId  String?
  manufacturerRfp    ReimbursementReport? @relation("AdjBatchManufacturerRfp", fields: [manufacturerRfpId], references: [id], onDelete: SetNull)
  freightRfpId       String?
  freightRfp         ReimbursementReport? @relation("AdjBatchFreightRfp", fields: [freightRfpId], references: [id], onDelete: SetNull)
  proofUrls          Json?
  remarks            String?
  createdById        String
  createdBy          User                 @relation("AdjBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())

  adjustments InventoryAdjustment[]

  @@index([createdById])
  @@index([adjustmentDate])
  @@index([fxSourceAccountId])
  @@index([manufacturerRfpId])
  @@index([freightRfpId])
}

model ConsignmentTransfer {
  id              String         @id @default(cuid())
  referenceNumber String? // Groups multiple items in one batch transfer
  itemId          String
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromBranch      Branch
  toBranch        Branch
  quantity        Int
  status          TransferStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  requestedAt     DateTime       @default(now())
  approvedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([itemId])
  @@index([status])
  @@index([fromBranch])
  @@index([toBranch])
  @@index([requestedById])
  @@index([referenceNumber])
}

// ── POS System ─────────────────────────────────────────────

enum OrderType {
  SERVICE
  PRODUCT
}

enum OrderStatus {
  COMPLETED
  REOPENED
  VOIDED
}

enum PaymentMethod {
  CASH
  GCASH
  PAYMAYA
  PAYMONGO
  DEBIT
  CREDIT_CARD
  VIP_CARD
  PREPAID_CARD
  REWARD_POINTS
  SHOPEE
  LAZADA
  TIKTOK
  DOWNPAYMENT
  PACKAGE
  ADVANCE
  HMO
  GL
}

enum DiscountType {
  NONE
  PWD_SC
  CUSTOM
}

enum WalletAction {
  DEDUCTION
  RELOAD
  REWARD_EARN
  REWARD_SPEND
  AR_PAYMENT
  AR_PAYMENT_REVERSED
  VOID_REVERSAL
}

enum WalletType {
  PACKAGE
  VIP
  PREPAID_CARD
  DOWNPAYMENT
  ADVANCE
  HMO
  GL
}

model Referrer {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("DOCTOR") // DOCTOR | LAW_FIRM | PARTNER_SCHOOL
  affiliation    String?
  specialization String?
  branches       String[] @default([]) // visibility scope: SANDBOX_EAST / SANDBOX_GREENHILLS; empty = all branches
  isActive       Boolean  @default(true)
  createdById    String
  createdBy      User     @relation("ReferrerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders           Order[]
  referredPatients ReferredPatient[]

  @@index([isActive])
  @@index([createdById])
}

// A patient a referrer sent to us. patientId links to the Operations Hub CRM
// patient; patientName is stored for display + matching orders that predate any id.
model ReferredPatient {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    Referrer @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  patientId   String? // Operations Hub CRM patient id
  patientName String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([referrerId])
  @@index([patientId])
}

model DigitalWallet {
  id               String       @id @default(cuid())
  patientId        String
  patientName      String
  patientEmail     String?
  barcode          String       @unique
  walletType       WalletType
  vipTier          String? // PLATINUM, GOLD, SILVER — only for VIP wallets
  balance          Decimal      @default(0)
  rewardPoints     Int          @default(0)
  accountId        String? // COA account (e.g., Accounts Receivable for HMO/GL)
  account          Account?     @relation("WalletAccount", fields: [accountId], references: [id], onDelete: SetNull)
  totalGlAmount    Decimal? // GL wallets: full approved amount (for AR — different from balance which tracks remaining usable amount)
  attachmentUrl    String? // Uploaded proof — legacy single-file field (kept for backward compat)
  attachmentUrls   Json? // GL wallets: multi-file proof URLs stored as JSON array
  agency           String? // GL wallets: issuing agency (e.g., DSWD, PhilHealth, OWWA)
  diagnosis        String? // GL wallets: patient diagnosis from CRM (snapshot at creation)
  approvedServices Json? // GL wallets: approved service types (e.g. ["PT","OT","SLP"])
  soaStatus        String?      @default("With GL/No SOA") // GL wallets: "With GL/No SOA" blocks checkout; "With GL and SOA" allows it
  paysClinicForMd  Boolean      @default(false) // HMO exception: pays the clinic even for MD consults (e.g. Intellicare)

  // ── GL case tracking (the "Detailed GL" sheet) ──────────────────────────
  // A Guarantee Letter is a paper trail before it is a receivable: documents go
  // in, an amount is requested, a smaller amount is approved and released, an
  // SOA is filed, and only then does a cheque arrive. None of that fitted in
  // totalGlAmount alone, so it was being kept in a spreadsheet outside the app.
  // All optional — existing letters keep working with these blank.
  glRequestedAmount Decimal? // Requested GL, before approval trimmed it
  glDocsSubmittedAt DateTime? // Date the supporting documents were submitted
  glReleasedAt      DateTime? // Date the approved GL was released
  soaAmount         Decimal? // Amount billed on the SOA (differs from the approved GL)
  soaSubmittedAt    DateTime? // Date the SOA was submitted to the agency
  soaResubmittedAt  DateTime? // Date the SOA was resubmitted after being returned for errors
  guardianName      String? // Parent/guardian who signed for the patient
  // Agency commission withheld from the SOA amount — the rate varies by case
  // (20% or 25%), so it is stored per letter rather than assumed.
  soaCommissionRate Decimal?
  payoutBatch       String? // Payout cutoff the professional fee went out on
  qbEntry           String? // QuickBooks reference (e.g. AR25-0027)
  branch           String       @default("ALL") // SANDBOX_EAST, SANDBOX_GREENHILLS, or ALL
  dateObtained     DateTime? // Date patient originally obtained the wallet/card
  paymentModeId    String? // How the initial load was paid
  paymentMode      PaymentMode? @relation("WalletPaymentMode", fields: [paymentModeId], references: [id], onDelete: SetNull)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  packages   WalletPackage[]
  logs       WalletLog[]
  payments   OrderPayment[]
  arPayments ARPayment[]
  soaSubmissions SoaSubmission[]
  glCase     GlCase?        @relation("WalletGlCase")

  @@index([patientId, walletType])
  @@index([patientName])
  @@index([barcode])
  @@index([walletType])
  @@index([accountId])
  @@index([paymentModeId])
  @@index([branch])
}

/// A Guarantee Letter case entered by accounting, which may not have a POS
/// wallet behind it yet — a second application filed before the wallet exists,
/// or a letter still awaiting approval. Once POS does have the wallet, staff tag
/// the case to it and the live figures (balance drawn down, payments) come from
/// there instead of being retyped.
///
/// walletId is unique so a wallet can back at most one case; Detailed GL renders
/// every case plus the wallets no case has claimed, which keeps a tagged letter
/// from appearing twice.
model GlCase {
  id       String         @id @default(cuid())
  walletId String?        @unique
  wallet   DigitalWallet? @relation("WalletGlCase", fields: [walletId], references: [id], onDelete: SetNull)

  patientName String
  branch      String @default("ALL")

  // The same paper trail the wallet-backed rows carry. Held here too, because an
  // untagged case has no wallet to read them from.
  glRequestedAmount Decimal?
  glDocsSubmittedAt DateTime?
  glReleasedAt      DateTime?
  /// Approved GL for an untagged case. Once tagged, the wallet's totalGlAmount wins.
  approvedAmount    Decimal?
  soaAmount         Decimal?
  soaSubmittedAt    DateTime?
  soaResubmittedAt  DateTime? // Date the SOA was resubmitted after being returned for errors
  guardianName      String?
  soaCommissionRate Decimal?
  payoutBatch       String?
  qbEntry           String?
  /// Cheque date for an untagged case. A tagged one takes its payment from ARPayment.
  paidAt            DateTime?
  notes             String?

  // ── GL processor payout ────────────────────────────────────────────────
  // The fee we owe the GL processor (soaAmount × soaCommissionRate) is settled
  // in batches through an RFP. Recording the RFP here is what stops a letter
  // being paid twice: a case with processorRfpId set is excluded from the next
  // batch. Nullable throughout — nothing is owed until an SOA amount and a rate
  // both exist.
  processorRfpId    String?
  processorRfp      ReimbursementReport? @relation("GlProcessorRfp", fields: [processorRfpId], references: [id], onDelete: SetNull)
  processorPaidAt   DateTime?
  processorProofUrl String?

  createdById String
  createdBy   User     @relation("GlCaseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientName])
  @@index([branch])
  @@index([processorRfpId])
}

model WalletPackage {
  id            String        @id @default(cuid())
  walletId      String
  wallet        DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  serviceName   String
  serviceId     String?
  department    String?
  totalSessions Int
  usedSessions  Decimal       @default(0) // Decimal: services may cost 0.5/1.5/... sessions
  amountPaid    Decimal
  purchaseDate  DateTime      @default(now())
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  logs WalletLog[]

  @@index([walletId])
  @@index([isActive])
}

model WalletLog {
  id            String         @id @default(cuid())
  walletId      String
  wallet        DigitalWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  packageId     String?
  package       WalletPackage? @relation(fields: [packageId], references: [id])
  action        WalletAction
  description   String
  sessions      Decimal? // fractional sessions allowed (0.5 steps)
  pointsChange  Int?
  balanceBefore Int?
  balanceAfter  Int?
  createdById   String
  createdBy     User           @relation("WalletLogBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())

  @@index([walletId])
  @@index([packageId])
  @@index([createdAt])
}

model Order {
  id                    String       @id @default(cuid())
  orderNumber           Int          @unique @default(autoincrement())
  orderType             OrderType
  branch                String
  platform              String? // Sales channel for product orders: Website | Shopee | Lazada | Tiktok | Clinic
  patientId             String?
  patientName           String?
  clinicianName         String?
  subtotal              Decimal
  discountAmount        Decimal      @default(0)
  discountType          DiscountType @default(NONE)
  discountLabel         String?
  netAmount             Decimal
  revenueType           String       @default("EARNED")
  queueItemId           String?
  referrerId            String?
  referrer              Referrer?    @relation(fields: [referrerId], references: [id])
  notes                 String?
  issuedOfficialInvoice Boolean      @default(false)
  salesInvoiceNumber    String?
  referenceNumber       String?
  arProofUrl            String? // Per-transaction AR proof attachment (PDF or image)
  arCustomDate          DateTime? // Manually overridden transaction date for AR Invoice / SOA
  // Per-claim SOA submission outcome: null = Pending; APPROVED | DISAPPROVED set
  // manually in the Per HMO table. A paid order displays as Approved regardless.
  soaApprovalStatus     String?
  status                OrderStatus  @default(COMPLETED)
  returnedByBuyer       Boolean      @default(false) // product order returned by buyer (stock restocked, sale reversed)
  paymentStatus         String       @default("PAID") // PAID | UNPAID (session recorded, cash collected later)
  paymentDate           DateTime? // date cash was actually collected — drives end-of-day cash reconciliation; session stays on transactionDate
  transactionDate       DateTime
  createdById           String
  createdBy             User         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  items             OrderItem[]
  payments          OrderPayment[]
  arPaymentItems    ARPaymentItem[]
  soaSubmissionItems SoaSubmissionItem[]
  otherReceivable   OtherReceivable?
  // Who the sale was to. Asked on every checkout, not just credit sales, because
  // an official invoice needs the buyer whatever the payment mode was. A patient
  // is matched from the CRM; anyone else is typed in, and only an invoice needs
  // an address or a TIN — so these stay null on an ordinary walk-in sale.
  buyerIsPatient    Boolean          @default(false)
  buyerName         String?
  buyerAddress      String?
  buyerIsBusiness   Boolean          @default(false)
  buyerBusinessName String?
  buyerTin          String?

  @@index([orderType])
  @@index([branch])
  @@index([status])
  @@index([transactionDate])
  @@index([createdById])
  @@index([referrerId])
  @@index([queueItemId])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?       @relation(fields: [serviceId], references: [id])
  inventoryItemId  String?
  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  name             String
  quantity         Int            @default(1)
  unitPrice        Decimal
  lineTotal        Decimal
  cogsCost         Decimal? // FIFO cost of goods sold for this line item
  isFreeSample     Boolean        @default(false) // Inventory out to marketing expense (8120)
  returnedQuantity Int            @default(0) // units returned/refunded (buyer return)
  refundAmount     Decimal        @default(0) // ₱ refunded for this line — grossed up into revenue + shown under 7160 Refunds
  variantId        String? // Which variant was sold (if product has variants)
  variantLabel     String? // e.g. "Red / Large"
  createdAt        DateTime       @default(now())

  @@index([orderId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

model OrderPayment {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal
  walletId      String?
  wallet        DigitalWallet? @relation(fields: [walletId], references: [id])
  reference     String?
  paymentModeId String? // Configured PaymentMode (carries deduction rules)
  paymentMode   PaymentMode?   @relation("OrderPaymentMode", fields: [paymentModeId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([orderId])
  @@index([method])
  @@index([walletId])
  @@index([paymentModeId])
}

// ── Vouchers ─────────────────────────────────────────────
// A batch of discount vouchers generated at once (POS → Services → Vouchers).
// Each batch fixes the discount (percentage, fixed peso amount, or the entire
// service free), a validity date, and the reason it was created; the batch
// then owns N individually-coded vouchers. Creation is restricted to
// ADMIN / ACCOUNTANT / BOOKKEEPER; front desk can view and redeem at checkout.
model ServiceVoucherBatch {
  id           String    @id @default(cuid())
  reason       String // why the vouchers were created (marketing push, apology, raffle …)
  discountKind String // PERCENTAGE | FIXED | FREE (entire service free)
  value        Decimal   @default(0) // % for PERCENTAGE, ₱ for FIXED, unused for FREE
  validUntil   DateTime // vouchers expire at end of this date
  createdById  String?
  createdAt    DateTime  @default(now())
  vouchers     ServiceVoucher[]
}

// One voucher: a unique CODE128-scannable code. Redeemed (status USED) when an
// order applies it; voiding pulls it from circulation without deleting the record.
model ServiceVoucher {
  id          String       @id @default(cuid())
  code        String       @unique // e.g. VC-7K3M9XPQ — printed under the barcode
  batchId     String
  batch       ServiceVoucherBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status      String       @default("ACTIVE") // ACTIVE | USED | VOIDED
  usedAt      DateTime?
  usedOrderId String? // POS order that redeemed it
  usedById    String?
  createdAt   DateTime     @default(now())

  @@index([batchId])
  @@index([status])
}

model DiscountSetting {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("PERCENTAGE")
  value       Decimal
  branch      String?
  walletType  String? // If set, links this discount to a wallet type (VIP, PREPAID_CARD, etc.)
  departments String[] @default([]) // if set, discount only applies to items in these departments; empty = all
  accountId   String? // COA account for this discount (REVENUE accounts with DEBIT normal balance = contra-revenue)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("DiscountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules WalletDiscountRule[]

  @@index([isActive])
  @@index([branch])
  @@index([walletType])
  @@index([accountId])
}

model WalletDiscountRule {
  id                String          @id @default(cuid())
  discountSettingId String
  discountSetting   DiscountSetting @relation(fields: [discountSettingId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id])
  department        String? // e.g. "OT", "SLP", "PT" — applies to all services in dept
  discountPercent   Decimal // The discount percentage for this service/dept
  createdAt         DateTime        @default(now())

  @@index([discountSettingId])
  @@index([serviceId])
  @@index([department])
}

// ── Payment Mode Settings ─────────────────────────────────

model PaymentMode {
  id                      String   @id @default(cuid())
  name                    String // "Cash - SBEA", "GCash", "Credit Card", etc.
  paymentMethod           String? // PaymentMethod enum key: CASH, GCASH, PAYMAYA, DEBIT, CREDIT_CARD, SHOPEE, LAZADA, TIKTOK
  branch                  String? // null = all branches, "SANDBOX_EAST", "SANDBOX_GREENHILLS"
  isActive                Boolean  @default(true)
  accountId               String? // COA where NET amount is lodged (usually an asset account)
  account                 Account? @relation("PaymentModeAccount", fields: [accountId], references: [id], onDelete: SetNull)
  // Bank account the processor actually deposits settlements into, when that is
  // NOT accountId (e.g. TikTok sales lodge into a clearing account, but the
  // payout lands in VER BDO Checking). Bank rec offers this mode's payments
  // when reconciling either account.
  settlementBankAccountId String?
  settlementBankAccount   Account? @relation("PaymentModeSettlementAccount", fields: [settlementBankAccountId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  deductions    PaymentModeDeduction[]
  orderPayments OrderPayment[]         @relation("OrderPaymentMode")
  wallets       DigitalWallet[]        @relation("WalletPaymentMode")

  @@index([isActive])
}

model PaymentModeDeduction {
  id            String      @id @default(cuid())
  paymentModeId String
  paymentMode   PaymentMode @relation(fields: [paymentModeId], references: [id], onDelete: Cascade)
  name          String // "Merchant Discount Rate", "Creditable Withholding Tax"
  rate          Decimal // value — interpreted by valueType: PERCENTAGE → % of gross; FIXED → peso amount
  valueType     String      @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  // Rate eras: banks reprice MDR (e.g. AUB credit card 2.5% → 2.2%, QRPH 1% → 0%
  // around Oct 2025). A deduction applies to a sale only when the SALE date falls
  // inside [effectiveFrom, effectiveTo]; null = open-ended on that side. Undated
  // rows apply forever, so existing configs behave unchanged.
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  accountId     String? // COA where this deduction is lodged (expense or liability)
  account       Account?    @relation("DeductionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([paymentModeId])
}

// ── PayMongo integration ─────────────────────────────────
// A REUSABLE payment link for one service/product on one PayMongo account.
// PayMongo checkout sessions are single-use and (with QRPh) never ask the payer for their
// details, so the intake is hosted here instead: the shared URL is /pay/<token>, where the
// payer enters their name / contact / email, and only then is a fresh PayMongo checkout
// session minted for them. One link therefore serves any number of patients.
model PaymentLink {
  id              String   @id @default(cuid())
  token           String   @unique // public, unguessable slug used in /pay/<token>
  account         String // AHEA | AHGH | VERDANA | AHI
  branch          String?
  serviceId       String?
  inventoryItemId String?
  itemName        String
  department      String?
  quantity        Int      @default(1)
  unitPrice       Decimal // snapshot; re-read from the catalogue on each visit
  // Optional promo baked into the link: every payer gets this discount automatically.
  // When set, the payer isn't asked for a code. When null, allowVoucher decides whether
  // they may type their own.
  voucherId       String?
  voucherCode     String?
  allowVoucher    Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([account])
  @@index([token])
  @@index([isActive])
}

// Tracks a PayMongo checkout session ↔ POS order, plus the settled payment fee/net.
model PaymongoCheckout {
  id                String    @id @default(cuid())
  checkoutId        String    @unique // PayMongo checkout_session id (cs_...)
  referenceCode     String? // our reference (also sent as PayMongo metadata)
  orderId           String? // linked POS order (set when the sale is recorded)
  branch            String?
  // Which PayMongo merchant account issued this link: AHEA | AHGH | VERDANA | AHI.
  // Each account has its own secret key, so payments/payouts are polled per account.
  account           String?
  // What is being paid for — either a Service or an Inventory product (never both).
  serviceId         String?
  inventoryItemId   String?
  itemName          String?
  quantity          Int       @default(1)
  // Payer details collected when the link is generated.
  customerFirstName String?
  customerLastName  String?
  customerPhone     String?
  customerEmail     String?
  // Voucher applied (if any). grossAmount = list price before discount; amount = charged.
  paymentLinkId     String? // the reusable PaymentLink this payment came through
  // Which instrument the payer actually used: CARD | GCASH | PAYMAYA | QRPH.
  // Read from the PayMongo payment payload and used to pick the matching POS PaymentMode.
  paymentMethodUsed String?
  convertedAt       DateTime? // when a cashier recorded this payment (as an advance, or a POS order)
  // The patient ADVANCE wallet this payment was loaded into. The money is banked when the
  // payer pays (DR clearing / CR 4050 Unearned) — converting only moves it into the wallet so
  // the cashier can charge the session against it later, which is what clears 4050.
  advanceWalletId   String?
  voucherId         String?
  voucherCode       String?
  grossAmount       Decimal?
  discountAmount    Decimal?
  description       String?
  amount            Decimal // gross (PHP)
  status            String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED
  checkoutUrl       String?
  paymentId         String? // pay_... once paid
  fee               Decimal? // PayMongo fee (PHP)
  netAmount         Decimal? // amount − fee
  paidAt            DateTime?
  payoutId          String? // reconciliation: PayMongo payout that settled this
  livemode          Boolean   @default(false)
  raw               Json? // last webhook/payment payload
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([payoutId])
  @@index([account])
  @@index([voucherId])
}

// Promo voucher codes applied to PayMongo checkout links (and reusable elsewhere).
// Effectivity is either a date window or "lifetime" (never expires). A voucher can be
// valid at several branches at once.
model Voucher {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique // what the customer types; matched case-insensitively
  discountType   String    @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue  Decimal   @default(0) // 10 = 10% when PERCENTAGE; 200 = PHP 200 when FIXED
  // Effectivity — isLifetime ignores the dates entirely.
  isLifetime     Boolean   @default(false)
  startDate      DateTime?
  endDate        DateTime?
  // Branch scope (PayMongo account codes: AHEA | AHGH | VERDANA | AHI). Empty = all.
  branches       String[]  @default([])
  // Department scope (Service.department codes: PT | MD | OT | SLP | SPED |
  // PSYCHOLOGY | ORTHOSIS_PROSTHESIS). Empty = everything. When set, only
  // services under a ticked department are covered — products and services in
  // other departments are refused (a service whose department is ALL counts as
  // every department).
  departments    String[]  @default([])
  // Usage cap: UNLIMITED | ONCE_PER_CUSTOMER (by email) | MAX_USES (see maxUses).
  usageLimitType String    @default("UNLIMITED")
  maxUses        Int?
  // PWD/Senior vouchers only apply when Patient CRM (Operations Hub) holds BOTH a
  // PWD/Senior ID number AND an uploaded ID photo for the payer. Checked at payment time.
  requiresPwdId  Boolean   @default(false)
  // Contra-revenue account this discount is booked to (chosen from the COA).
  accountId      String?
  account        Account?  @relation("VoucherDiscountAccount", fields: [accountId], references: [id], onDelete: SetNull)
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  redemptions VoucherRedemption[]

  @@index([code])
  @@index([isActive])
}

// One row per successful use of a voucher — drives ONCE_PER_CUSTOMER and MAX_USES checks.
model VoucherRedemption {
  id             String   @id @default(cuid())
  voucherId      String
  voucher        Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  checkoutId     String? // PaymongoCheckout.checkoutId that consumed it
  customerEmail  String?
  account        String? // PayMongo account the redemption happened on
  discountAmount Decimal  @default(0)
  redeemedAt     DateTime @default(now())

  @@index([voucherId])
  @@index([customerEmail])
  @@index([checkoutId])
}

// Singleton config for PayMongo payout auto-reconciliation. When autoReconcile is
// on and a settlement bank is set, settled PayMongo payouts are pulled from the
// Payouts API and posted DR Bank / CR PayMongo Clearing automatically.
model PaymongoSettings {
  id            String    @id @default("singleton")
  bankAccountId String? // COA bank account PayMongo deposits payouts into
  autoReconcile Boolean   @default(true)
  lastSyncAt    DateTime? // throttle marker for the on-load poll
  updatedAt     DateTime  @default(now()) @updatedAt
}

// ── Accounts Receivable Payments ─────────────────────────

model ARPayment {
  id                   String        @id @default(cuid())
  walletId             String
  wallet               DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  paymentDate          DateTime
  amount               Decimal
  discount             Decimal       @default(0)
  discountAccountId    String?
  discountAccount      Account?      @relation("ARPaymentDiscountAccount", fields: [discountAccountId], references: [id], onDelete: SetNull)
  cashAccountId        String? // COA account to debit (cash/bank account)
  cashAccount          Account?      @relation("ARPaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  // HMO overpayment: the payer remitted a few pesos more than the AR being
  // settled. amount holds the real cash received; overpayment is the excess,
  // credited to overpaymentAccount (an income account) instead of AR.
  overpayment          Decimal       @default(0)
  overpaymentAccountId String?
  overpaymentAccount   Account?      @relation("ARPaymentOverpaymentAccount", fields: [overpaymentAccountId], references: [id], onDelete: SetNull)
  proofUrl             String? // URL or file path to payment proof
  notes                String?
  salesInvoiceNumber   String? // SI issued for this HMO/GL collection → Sales Summary (With SI)
  branch               String?
  createdById          String
  createdBy            User          @relation("ARPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())

  items ARPaymentItem[]

  @@index([walletId])
  @@index([paymentDate])
  @@index([branch])
  @@index([createdById])
}

// ── Other Receivables (non-HMO/GL) ───────────────────────
// Credit/bulk sales to outside customers (e.g. Sandbox Clark): a POS product
// order paid via "Receivable" creates one of these. Collected under Accounts
// Receivable → Others, optionally on a staggered monthly plan with interest
// (percent of principal or an absolute add-on) — totalDue = principal +
// interest, monthlyAmount = totalDue / months.
model OtherReceivable {
  id                 String    @id @default(cuid())
  branch             String
  customerName       String
  // Sales to a company are billed to the company, not the person who collected,
  // and an official sales invoice needs the buyer's TIN. A walk-in customer has
  // neither, so both stay null rather than being faked.
  isBusiness         Boolean   @default(false)
  businessName       String?
  businessTin        String?
  buyerAddress       String?
  issuedSalesInvoice Boolean   @default(false)
  orderId            String?   @unique
  order              Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  principal          Decimal
  months             Int? // staggered plan length (null = no plan yet)
  interestType       String? // PERCENT | ABSOLUTE
  interestValue      Decimal?
  totalDue           Decimal // principal + interest (equals principal until a plan is set)
  monthlyAmount      Decimal? // totalDue / months
  startDate          DateTime? // first installment month
  notes              String?
  status             String    @default("OPEN") // OPEN | SETTLED
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments OtherReceivablePayment[]

  @@index([branch])
  @@index([status])
  @@index([customerName])
}

model OtherReceivablePayment {
  id           String          @id @default(cuid())
  receivableId String
  receivable   OtherReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  date         DateTime
  amount       Decimal
  method       String?
  reference    String?
  proofUrl     String?
  notes        String?
  createdById  String?
  createdAt    DateTime        @default(now())

  @@index([receivableId])
  @@index([date])
}

model ARPaymentItem {
  id        String    @id @default(cuid())
  paymentId String
  payment   ARPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@index([paymentId])
  @@index([orderId])
}

// A batch of sessions the HMO officer has physically submitted to a provider
// for evaluation. This is the step before a payment exists: it records what
// went out, when, and the paper trail proving it was transmitted — so an
// unpaid session can be told apart from one nobody has billed yet.
model SoaSubmission {
  id             String        @id @default(cuid())
  // SOA reference number, assigned when the submission is recorded:
  // BR-YYYYMMDD-HMO-000x (e.g. AHEA-20260903-ITCR-0001), sequence per prefix.
  referenceNo    String?       @unique
  walletId       String
  wallet         DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  submittedDate  DateTime
  // Proof the batch was handed over (courier receipt, email screenshot) and the
  // scanned claim documents themselves. Both hold a JSON array of file URLs.
  transmittalUrls Json?
  documentUrls    Json?
  notes          String?
  branch         String?
  createdById    String
  createdBy      User          @relation("SoaSubmissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items SoaSubmissionItem[]

  @@index([walletId])
  @@index([submittedDate])
}

model SoaSubmissionItem {
  id           String        @id @default(cuid())
  submissionId String
  submission   SoaSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())

  // One session can only be in a given submission once; re-submitting the same
  // session to the same provider is a data-entry slip, not a second claim.
  @@unique([submissionId, orderId])
  @@index([submissionId])
  @@index([orderId])
}

// ── Payroll ──────────────────────────────────────────────

model Consultant {
  id               String   @id @default(cuid())
  externalStaffId  String?  @unique // Marketing site Staff.id
  bioId            Int? // Bio/Employee ID from HR Hub (for payreg)
  name             String // "LASTNAME, FIRSTNAME"
  department       String // OT, PT, SLP, SPED, MD, PSYCHOLOGY, etc.
  branch           String // SBEA, SBGH — primary branch
  extraBranches    String[] @default([]) // additional scheduling branches (never overwritten by sync)
  // Mentorship / supervision roles, synced from the staff feed (HR checkboxes).
  isClinicalSupervisor Boolean @default(false)
  isClinicalMentor     Boolean @default(false)
  isMentee             Boolean @default(false)
  email            String?
  phone            String?
  tinNumber        String?
  birAddress       String? // BIR registered address (for payroll XLSX export)
  sssNumber        String?
  philhealthNumber String?
  pagibigNumber    String?
  bankName         String?
  bankAccountNo    String?
  taxDeduction     String   @default("NONE") // "FIVE_PERCENT" or "NONE"
  monthlyRetainer  Decimal  @default(0) // total per month; = sum of retainerByBranch when that is set
  // Which branch(es) the retainer is actually for, e.g. { "SBGH": 10000 } for a consultant
  // who works interbranch but is only retained at Greenhills. Null/empty falls back to the
  // whole of monthlyRetainer on the primary branch.
  retainerByBranch Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unitPayRates      ConsultantUnitPay[]
  payrollEntries    PayrollEntry[]
  requests          EmployeeRequest[]
  cutoffAdjustments ConsultantCutoffAdjustment[]
  benefits          ConsultantBenefit[]

  @@index([department])
  @@index([branch])
  @@index([isActive])
  mentorMeetingCharges MentorshipMeetingCharge[] @relation("MentorMeetingCharges")
  menteeMeetingCharges MentorshipMeetingCharge[] @relation("MenteeMeetingCharges")
}

model UnitPay {
  id               String   @id @default(cuid())
  name             String // e.g. "Basic PF", "Assessment PF"
  departments      Json     @default("[]") // JSON array of dept codes, or empty for all
  isActive         Boolean  @default(true)
  expenseAccountId String?
  expenseAccount   Account? @relation("UnitPayExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consultantRates ConsultantUnitPay[]
  services        Service[]

  @@index([isActive])
  @@index([expenseAccountId])
}

model ConsultantUnitPay {
  id               String     @id @default(cuid())
  consultantId     String
  consultant       Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  unitPayId        String
  unitPay          UnitPay    @relation(fields: [unitPayId], references: [id], onDelete: Cascade)
  amount           Decimal // Per-unit amount for this consultant (default across branches)
  // Per-branch override of `amount`, e.g. { "SBGH": 1050 } for a consultant paid
  // 1,000 at East but 1,050 at Greenhills. Branches not listed use `amount`.
  branchAmounts    Json?
  disabled         Boolean    @default(false) // When true, this unit pay is not applicable for this clinician
  thresholdEnabled Boolean    @default(false)
  thresholdAmount  Decimal? // Min order netAmount to qualify for full rate
  reducedAmount    Decimal? // Rate used when order netAmount is below threshold

  @@unique([consultantId, unitPayId])
  @@index([consultantId])
  @@index([unitPayId])
}

// ── Incentive Rules ───────────────────────────────────────────

model IncentiveRule {
  id           String   @id @default(cuid())
  name         String // e.g. "Daily Patient Threshold Bonus"
  description  String?
  threshold    Int // Minimum patients per day to trigger (e.g. 7)
  bonusPerUnit Decimal // Bonus amount per patient when triggered (e.g. 20)
  departments  Json     @default("[]") // JSON array of dept codes; empty = all
  branch       String? // null = all branches
  isActive     Boolean  @default(true)
  createdById  String
  createdBy    User     @relation("IncentiveCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([branch])
}

model PayrollEntry {
  id                      String     @id @default(cuid())
  consultantId            String
  consultant              Consultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  cutoffPeriod            String // e.g. "2026-03-1" or "2026-03-2"
  branch                  String
  items                   Json // [{unitPayName, unitAmount, quantity, lineTotal}]
  extraItems              Json       @default("[]") // manually added unit pays [{id, unitPayId, unitPayName, unitAmount, qty}]
  adjustments             Json       @default("[]") // [{id, name, amount, isAddition, isTaxed, remarks}]
  incentives              Json       @default("[]") // [{name, bonusPerUnit, sessionCount, bonus, department}]
  incentiveTotal          Decimal    @default(0) // sum of all incentive bonuses
  grossPay                Decimal
  retainerAmount          Decimal    @default(0)
  taxAmount               Decimal    @default(0)
  // Benefit contributions (SSS/PHIC/HDMF) — mirror EmployeePayslip. EE share is
  // deducted from netPay; ER share is an employer accrual. Both feed Benefits Payable.
  sssDeduction            Decimal    @default(0)
  philhealthDeduction     Decimal    @default(0)
  pagibigDeduction        Decimal    @default(0)
  sssEmployerShare        Decimal    @default(0)
  philhealthEmployerShare Decimal    @default(0)
  pagibigEmployerShare    Decimal    @default(0)
  netPay                  Decimal
  pdfUrl                  String? // Stored PDF file path on VPS
  status                  String     @default("DRAFT") // DRAFT, FINAL
  taxRemitted             Boolean    @default(false)
  salariesRemitted        Boolean    @default(false)
  salaryPaymentId         String? // set when salary is remitted
  salaryRfpId             String? // set when included in a Salaries-Payable RFP (locked until paid/deleted)
  benefitsRemitted        Boolean    @default(false)
  benefitPaymentId        String? // set when SSS/PHIC/HDMF is remitted
  benefitRfpId            String? // set when included in a (legacy combined) Benefits-Payable RFP
  // Per-agency Benefits-Payable RFP locks — SSS/PHIC/HDMF are remitted separately.
  sssRfpId                String?
  philhealthRfpId         String?
  pagibigRfpId            String?
  createdById             String
  createdBy               User       @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  taxPaymentEntries TaxPaymentEntry[]
  salarySplits      SalaryPayableSplit[]

  @@unique([consultantId, cutoffPeriod, branch])
  @@index([consultantId])
  @@index([cutoffPeriod])
  @@index([branch])
  @@index([status])
  @@index([taxRemitted])
  @@index([salariesRemitted])
}

model TaxPayment {
  id            String   @id @default(cuid())
  paymentDate   DateTime
  totalAmount   Decimal
  fromAccountId String
  fromAccount   Account  @relation("TaxPaymentFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  proofUrl      String?
  notes         String?
  paymentType   String   @default("CONSULTANT")
  status        String   @default("COMPLETED")
  createdById   String
  createdAt     DateTime @default(now())

  entries TaxPaymentEntry[]

  @@index([paymentDate])
  @@index([paymentType])
  @@index([createdById])
}

model TaxPaymentEntry {
  id             String       @id @default(cuid())
  taxPaymentId   String
  taxPayment     TaxPayment   @relation(fields: [taxPaymentId], references: [id], onDelete: Cascade)
  payrollEntryId String
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  taxAmount      Decimal

  @@index([taxPaymentId])
  @@index([payrollEntryId])
}

model PayrollTaxSettings {
  id                 String   @id @default(cuid())
  liabilityAccountId String?
  liabilityAccount   Account? @relation("TaxLiability", fields: [liabilityAccountId], references: [id], onDelete: SetNull)
  updatedAt          DateTime @updatedAt
}

// ── Employee Payroll ──────────────────────────────────────

enum RateType {
  DAILY
  MONTHLY
}

enum EmployeeRequestType {
  LEAVE
  OVERTIME
  UNDERTIME
  CHANGE_SCHEDULE
  CHANGE_TIME_IN
  CHANGE_TIME_OUT
  CERTIFICATE_OF_EMPLOYMENT
  CERTIFICATE_OF_CONSULTATION
}

enum LeaveType {
  VACATION
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
  SIL // Service Incentive Leave
  BDAY // Birthday Leave
  TRAINING // Training Leave
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum TimekeepingSource {
  BIOMETRIC
  BIOMETRIC_CONFLICT
  MANUAL
  FILING
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

enum PayslipStatus {
  DRAFT
  FINAL
  LOCKED
}

enum TKUploadStatus {
  UPLOADED
  ACCEPTED
  FINALIZED
}

model Employee {
  id                 String    @id @default(cuid())
  externalStaffId    String?   @unique // Marketing site Staff.id (from Administration dept)
  employeeBioId      Int?      @unique // Biometric device ID (column 1 in .dat file)
  firstName          String
  lastName           String
  email              String?
  phone              String?
  department         String // ADMIN, OPERATIONS, etc.
  branch             String // SBEA, SBGH
  jobTitle           String?
  rateType           RateType  @default(DAILY)
  dailyRate          Decimal   @default(0)
  monthlyRate        Decimal   @default(0)
  sssNumber          String?
  philhealthNumber   String?
  pagibigNumber      String?
  tinNumber          String?
  bankName           String?
  bankAccountNo      String?
  dateHired          DateTime?
  regularizationDate DateTime?
  scheduleIn         String    @default("08:00") // Default clock-in time HH:mm
  scheduleOut        String    @default("17:00") // Default clock-out time HH:mm
  daySchedules       Json? // Per-day overrides: { "THURSDAY": { "in": "09:00", "out": "18:00" } }
  restDay            String    @default("SUNDAY") // e.g. "SUNDAY", "SATURDAY"
  ignoreTimekeeping  Boolean   @default(false) // If true: pays fixed half-month salary regardless of biometric attendance
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  timekeepingRecords TimekeepingRecord[]
  requests           EmployeeRequest[]
  benefits           EmployeeBenefit[]
  payslips           EmployeePayslip[]
  cutoffAdjustments  CutoffAdjustment[]
  staffLoans         StaffLoan[]

  @@index([branch])
  @@index([department])
  @@index([isActive])
  @@index([employeeBioId])
}

model EmployeeSettings {
  id                               String   @id @default(cuid())
  // Cutoff configuration
  cutoff1Start                     Int      @default(1) // Day of month for 1st cutoff start
  cutoff1End                       Int      @default(15) // Day of month for 1st cutoff end
  cutoff2Start                     Int      @default(16) // Day of month for 2nd cutoff start
  cutoff2EndLastDay                Boolean  @default(true) // true = use last day of month
  cutoff2End                       Int      @default(30) // Day if not using last day
  payout1Day                       Int      @default(15) // Payout day for 1st cutoff
  payout2Day                       Int      @default(30) // Payout day for 2nd cutoff (0 = last day)
  // Work hours
  standardHoursPerDay              Decimal  @default(8)
  overtimeMultiplier               Decimal  @default(1.25) // Regular OT = 125%
  nightDiffMultiplier              Decimal  @default(0.10) // 10% additional for 10pm-6am
  // Holiday multipliers (DOLE Philippines)
  regularHolidayRate               Decimal  @default(2.0) // 200% of daily rate
  specialHolidayRate               Decimal  @default(1.3) // 130% of daily rate
  regularHolidayOTRate             Decimal  @default(2.6) // 260% for OT on regular holiday
  specialHolidayOTRate             Decimal  @default(1.69) // 169% for OT on special holiday
  restDayRate                      Decimal  @default(1.3) // 130% for rest day
  restDayRegHolidayRate            Decimal  @default(2.6) // 260% for rest day + regular holiday
  restDaySpecHolidayRate           Decimal  @default(1.5) // 150% for rest day + special holiday
  // Late / Overtime rules
  lateGraceMinutes                 Int      @default(0) // Minutes late from time-in before deduction applies (e.g. 5)
  otIntervalMinutes                Int      @default(30) // OT counted in intervals of N minutes (e.g. 30)
  otMaxHours                       Decimal  @default(3) // Maximum OT hours considered per day (e.g. 3)
  // Deduction toggles
  sssEnabled                       Boolean  @default(true)
  philhealthEnabled                Boolean  @default(true)
  pagibigEnabled                   Boolean  @default(true)
  taxEnabled                       Boolean  @default(true)
  benefitDeductionTiming           String   @default("HALF_HALF") // HALF_HALF, FIRST_CUTOFF, SECOND_CUTOFF
  hrOfficerNameSBEA                String? // HR officer name for East Branch COE/COC
  hrOfficerNameSBGH                String? // HR officer name for Greenhills Branch COE/COC
  hrOfficerNameVERDANA             String? // HR officer name for Verdana Store COE/COC
  // Employee request approval settings
  requestApprovalExcludedPositions Json? // JSON array of job titles that branch admins cannot approve (requires ADMIN/ACCOUNTANT)
  leaveMaxDays                     Json? // { "VACATION": 5, "SICK": 5, "SIL": 5, "BDAY": 1, ... } — max per leave type per year
  updatedAt                        DateTime @updatedAt
}

model EmployeeRequest {
  id                   String              @id @default(cuid())
  employeeId           String? // For employee requests (COE, leave, etc.)
  employee             Employee?           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  consultantId         String? // For consultant requests (Certificate of Consultation)
  consultant           Consultant?         @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  requestType          EmployeeRequestType
  leaveType            LeaveType? // Only for LEAVE requests
  isHalfDay            Boolean             @default(false)
  halfDayPeriod        String? // "MORNING" or "AFTERNOON" — only when isHalfDay is true
  startDate            DateTime?
  endDate              DateTime?
  requestedTimeIn      String? // HH:mm for CHANGE_TIME_IN
  requestedTimeOut     String? // HH:mm for CHANGE_TIME_OUT
  requestedScheduleIn  String? // HH:mm for CHANGE_SCHEDULE new time in
  requestedScheduleOut String? // HH:mm for CHANGE_SCHEDULE new time out
  changeToWorkingDay   Boolean? // true = rest→work, false = work→rest (CHANGE_SCHEDULE)
  reason               String?
  attachment           String? // File URL / base64 for supporting docs (DTR photo)
  status               RequestStatus       @default(PENDING)
  reviewedById         String?
  reviewNotes          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([employeeId])
  @@index([consultantId])
  @@index([status])
  @@index([requestType])
  @@index([startDate])
}

model TimekeepingUpload {
  id           String         @id @default(cuid())
  fileName     String
  uploadDate   DateTime       @default(now())
  recordCount  Int            @default(0)
  branch       String?
  uploadedById String
  status       TKUploadStatus @default(UPLOADED)
  createdAt    DateTime       @default(now())

  records TimekeepingRecord[]

  @@index([uploadDate])
  @@index([branch])
  @@index([status])
}

model TimekeepingRecord {
  id               String             @id @default(cuid())
  employeeId       String
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadId         String?
  upload           TimekeepingUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  date             DateTime // The calendar date
  timeIn           DateTime? // Clock-in timestamp
  timeOut          DateTime? // Clock-out timestamp
  hoursWorked      Decimal? // Computed hours
  lateMinutes      Int                @default(0)
  undertimeMinutes Int                @default(0)
  overtimeMinutes  Int                @default(0)
  isRestDay        Boolean            @default(false)
  isHoliday        Boolean            @default(false)
  holidayType      String? // REGULAR, SPECIAL_NON_WORKING, SPECIAL_WORKING
  source           TimekeepingSource  @default(BIOMETRIC)
  conflictData     Json? // Raw time entries when multiple IN/OUT detected
  dtrProof         String? // Base64 or URL of DTR photo proof for manual entries
  remarks          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([uploadId])
}

model EmployeeBenefit {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefitType   String // SSS, PHILHEALTH, PAGIBIG, TAX
  employeeShare Decimal  @default(0) // Employee's monthly contribution
  employerShare Decimal  @default(0) // Employer's monthly contribution
  effectiveDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([benefitType])
  @@index([isActive])
}

// Per-consultant SSS/PHIC/HDMF contribution amounts — mirrors EmployeeBenefit.
model ConsultantBenefit {
  id            String     @id @default(cuid())
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  benefitType   String // SSS, PHILHEALTH, PAGIBIG
  employeeShare Decimal    @default(0) // consultant's monthly contribution (deducted from net)
  employerShare Decimal    @default(0) // employer's monthly contribution
  effectiveDate DateTime   @default(now())
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([consultantId])
  @@index([benefitType])
  @@index([isActive])
}

// Reusable "Other Fees" lines pre-loaded when generating a Benefits-Payable RFP
// (e.g. online-transfer fees). One template per branch; benefitType null = all types.
model BenefitRfpFeeTemplate {
  id        String   @id @default(cuid())
  branch    String   @unique
  fees      Json     @default("[]") // [{accountTitle, description, requestor, grossAmount, vatable, hasEwt, ewtRate}]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Holiday {
  id          String      @id @default(cuid())
  name        String
  date        DateTime
  holidayType HolidayType
  branch      String? // null = all branches
  isRecurring Boolean     @default(false) // Repeats yearly
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([date, branch])
  @@index([date])
  @@index([holidayType])
}

model EmployeePayslip {
  id                      String        @id @default(cuid())
  employeeId              String
  employee                Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cutoffPeriod            String // e.g. "2026-03-1" or "2026-03-2"
  branch                  String
  // Earnings
  basicPay                Decimal       @default(0)
  leavePay                Decimal       @default(0)
  overtimePay             Decimal       @default(0)
  holidayPay              Decimal       @default(0)
  nightDiffPay            Decimal       @default(0)
  restDayPay              Decimal       @default(0)
  allowances              Decimal       @default(0)
  grossPay                Decimal       @default(0)
  // Deductions
  sssDeduction            Decimal       @default(0)
  philhealthDeduction     Decimal       @default(0)
  pagibigDeduction        Decimal       @default(0)
  taxDeduction            Decimal       @default(0)
  lateDeduction           Decimal       @default(0)
  undertimeDeduction      Decimal       @default(0)
  otherDeductions         Decimal       @default(0)
  totalDeductions         Decimal       @default(0)
  // Employer shares (for journal entries)
  sssEmployerShare        Decimal       @default(0)
  philhealthEmployerShare Decimal       @default(0)
  pagibigEmployerShare    Decimal       @default(0)
  // Net
  netPay                  Decimal       @default(0)
  // Details
  daysWorked              Decimal       @default(0)
  hoursWorked             Decimal       @default(0)
  overtimeHours           Decimal       @default(0)
  lateMinutes             Int           @default(0)
  undertimeMinutes        Int           @default(0)
  details                 Json? // Additional breakdown data
  pdfUrl                  String? // Stored PDF file path on VPS
  status                  PayslipStatus @default(DRAFT)
  taxRemitted             Boolean       @default(false)
  salariesRemitted        Boolean       @default(false)
  salaryPaymentId         String? // set when salary is remitted
  salaryRfpId             String? // set when included in a Salaries-Payable RFP
  benefitsRemitted        Boolean       @default(false)
  benefitPaymentId        String? // set when SSS/PHIC/HDMF is remitted
  benefitRfpId            String? // set when included in a (legacy combined) Benefits-Payable RFP
  // Per-agency Benefits-Payable RFP locks — SSS/PHIC/HDMF are remitted separately.
  sssRfpId                String?
  philhealthRfpId         String?
  pagibigRfpId            String?
  computeTaxNow           Boolean       @default(false) // For cutoff 1 resignations: compute monthly tax now instead of waiting for cutoff 2
  createdById             String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  salarySplits SalaryPayableSplit[]

  @@unique([employeeId, cutoffPeriod, branch])
  @@index([taxRemitted])
  @@index([salariesRemitted])
  @@index([benefitsRemitted])
  @@index([salaryPaymentId])
  @@index([benefitPaymentId])
  @@index([employeeId])
  @@index([cutoffPeriod])
  @@index([branch])
  @@index([status])
}

model CutoffAdjustment {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cutoffPeriod   String // e.g. "2026-04-1"
  branch         String
  allowance      Decimal  @default(0)
  allowanceType  String   @default("NON_TAXABLE") // TAXABLE or NON_TAXABLE
  allowanceLabel String? // e.g. "De Minimis", "Transportation"
  deduction      Decimal  @default(0)
  deductionType  String   @default("NON_TAXABLE") // TAXABLE (pre-tax, reduces taxable income) or NON_TAXABLE
  deductionLabel String? // e.g. "Cash Advance", "Loan"
  // When this deduction repays a staff loan, the loan it repays. Set by the
  // payroll suggestion flow; finalize turns it into a StaffLoanDeduction.
  staffLoanId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, cutoffPeriod, branch])
  @@index([employeeId])
  @@index([cutoffPeriod])
  @@index([branch])
}

// ── Staff Loans & Perks ──────────────────────────────────────────────
// Money the company put out for a staff member that comes back through
// payroll: cash loans, BIR assistance, sponsored trainings, medical bills,
// SOS program balances. The release debits 1160 Due from Employees; every
// per-cutoff deduction credits it back. This register is the per-person
// subledger 1160 never had.
model StaffLoan {
  id           String    @id @default(cuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  staffName    String // as written in the source; kept even when employeeId is linked
  branch       String? // SBEA, SBGH, VERDANA
  category     String    @default("LOAN") // LOAN, BIR_ASSISTANCE, TRAINING, MEDICAL, SOS, PERK
  description  String?
  principal    Decimal   @default(0)
  dateReleased DateTime?
  chequeRef    String? // cheque number that released the money, when known
  perCutoff    Decimal   @default(0) // standing deduction per cutoff (payroll suggestion)
  status       String    @default("ACTIVE") // ACTIVE, PAID, WAIVED
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deductions StaffLoanDeduction[]

  @@index([employeeId])
  @@index([status])
}

model StaffLoanDeduction {
  id             String    @id @default(cuid())
  loanId         String
  loan           StaffLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  cutoffPeriod   String // "2026-01-2" style, matching payroll cutoffs
  amount         Decimal
  source         String    @default("IMPORT") // IMPORT (monitoring sheet), PAYROLL (finalized cutoff), MANUAL
  journalEntryId String? // the Dr salary expense / Cr 1160 entry, when posted
  createdAt      DateTime  @default(now())

  @@unique([loanId, cutoffPeriod, source])
  @@index([cutoffPeriod])
}

// ── Mentorship meetings (staff portal) charged through payroll ──────────────
//
// A MENTORSHIP meeting from the staff portal (teletherapy app) can be included
// in a consultant payroll cutoff: the mentee is charged the meeting fee and the
// mentor receives it. One row per (meeting, mentee) — ticking creates it,
// unticking deletes it, and the unique key stops the same meeting from being
// included twice across runs. lockedAt is set when the cutoff's payroll is
// finalized; paidNotifiedAt when the portal has been told to badge it "Paid".
model MentorshipMeetingCharge {
  id                 String      @id @default(cuid())
  externalMeetingId  String // SupervisionMeeting.id in the staff portal
  meetingDate        DateTime
  title              String?
  mentorConsultantId String?
  mentorConsultant   Consultant? @relation("MentorMeetingCharges", fields: [mentorConsultantId], references: [id], onDelete: SetNull)
  mentorName         String
  menteeConsultantId String?
  menteeConsultant   Consultant? @relation("MenteeMeetingCharges", fields: [menteeConsultantId], references: [id], onDelete: SetNull)
  menteeName         String
  fee                Decimal // snapshot of the fee setting at tick time
  cutoffPeriod       String // e.g. "2026-08-2"
  branch             String
  lockedAt           DateTime?
  paidNotifiedAt     DateTime?
  createdAt          DateTime    @default(now())

  @@unique([externalMeetingId, menteeName])
  @@index([cutoffPeriod, branch])
  @@index([mentorConsultantId])
  @@index([menteeConsultantId])
}

// Single-row settings for the mentorship meeting fee (Payroll → Consultants →
// Mentorship Meetings → Settings).
model MentorshipFeeSetting {
  id         Int      @id @default(1)
  meetingFee Decimal  @default(0)
  updatedAt  DateTime @updatedAt
}

model ConsultantCutoffAdjustment {
  id             String     @id @default(cuid())
  consultantId   String
  consultant     Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  cutoffPeriod   String // e.g. "2026-04-1"
  branch         String
  allowance      Decimal    @default(0)
  allowanceType  String     @default("NON_TAXABLE")
  allowanceLabel String?
  deduction      Decimal    @default(0)
  deductionLabel String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([consultantId, cutoffPeriod, branch])
  @@index([consultantId])
  @@index([cutoffPeriod])
  @@index([branch])
}

// ── Payroll COA Mapping ──────────────────────────────────────

model PayrollCOAMapping {
  id                        String   @id @default(cuid())
  // Expense accounts (debits on finalize)
  salaryExpenseAccountId    String?
  salaryExpenseAccount      Account? @relation("COASalaryExpense", fields: [salaryExpenseAccountId], references: [id], onDelete: SetNull)
  professionalFeesAccountId String?
  professionalFeesAccount   Account? @relation("COAProfFees", fields: [professionalFeesAccountId], references: [id], onDelete: SetNull)
  sssERAccountId            String?
  sssERAccount              Account? @relation("COASSSER", fields: [sssERAccountId], references: [id], onDelete: SetNull)
  hdmfERAccountId           String?
  hdmfERAccount             Account? @relation("COAHdmfER", fields: [hdmfERAccountId], references: [id], onDelete: SetNull)
  philhealthERAccountId     String?
  philhealthERAccount       Account? @relation("COAPhilER", fields: [philhealthERAccountId], references: [id], onDelete: SetNull)
  // Liability accounts (credits on finalize)
  salariesPayableAccountId  String?
  salariesPayableAccount    Account? @relation("COASalPayable", fields: [salariesPayableAccountId], references: [id], onDelete: SetNull)
  benefitsPayableAccountId  String?
  benefitsPayableAccount    Account? @relation("COABenPayable", fields: [benefitsPayableAccountId], references: [id], onDelete: SetNull)
  taxPayableAccountId       String?
  taxPayableAccount         Account? @relation("COATaxPayable", fields: [taxPayableAccountId], references: [id], onDelete: SetNull)
  updatedAt                 DateTime @updatedAt
}

// ── Journal Entries ──────────────────────────────────────────

model JournalEntry {
  id            String   @id @default(cuid())
  entryDate     DateTime
  description   String
  referenceType String // PAYROLL_CONSULTANT, PAYROLL_EMPLOYEE, SALARY_PAYMENT, BENEFIT_PAYMENT, TAX_PAYMENT
  referenceId   String? // cutoffPeriod+branch or payment ID
  totalAmount   Decimal
  branch        String   @default("ALL")
  createdById   String
  createdAt     DateTime @default(now())
  // Contribution-margin department tags: empty = "All" (allocated by rent %).
  departments   String[] @default([])

  lines JournalEntryLine[]

  @@index([referenceType, referenceId])
  @@index([entryDate])
  @@index([createdById])
  @@index([branch])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
}

// ── Payroll Payable Tracking ─────────────────────────────────

model PayrollPayableStatus {
  id                   String   @id @default(cuid())
  cutoffPeriod         String
  branch               String
  payrollType          String // CONSULTANT or EMPLOYEE
  totalSalariesPayable Decimal  @default(0)
  totalBenefitsPayable Decimal  @default(0)
  totalTaxPayable      Decimal  @default(0)
  salariesRemitted     Boolean  @default(false)
  benefitsRemitted     Boolean  @default(false)
  taxRemitted          Boolean  @default(false)
  salaryPaymentId      String?
  benefitPaymentId     String?
  taxPaymentId         String?
  journalEntryId       String? // The finalization journal entry
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([cutoffPeriod, branch, payrollType])
  @@index([cutoffPeriod])
  @@index([branch])
}

model SalaryPayment {
  id             String   @id @default(cuid())
  paymentDate    DateTime
  totalAmount    Decimal
  fromAccountId  String
  fromAccount    Account  @relation("SalaryPaymentFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  proofUrl       String?
  notes          String?
  remarks        String?
  paymentType    String   @default("EMPLOYEE") // EMPLOYEE or CONSULTANT
  cutoffPeriod   String
  branch         String
  journalEntryId String?
  status         String   @default("COMPLETED")
  createdById    String
  createdAt      DateTime @default(now())

  @@index([paymentDate])
  @@index([paymentType])
  @@index([cutoffPeriod])
}

model BenefitPayment {
  id             String   @id @default(cuid())
  paymentDate    DateTime
  totalAmount    Decimal
  fromAccountId  String
  fromAccount    Account  @relation("BenefitPaymentFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  proofUrl       String?
  notes          String?
  remarks        String?
  cutoffPeriod   String
  branch         String
  journalEntryId String?
  status         String   @default("COMPLETED")
  createdById    String
  createdAt      DateTime @default(now())

  @@index([paymentDate])
  @@index([cutoffPeriod])
}

// ── Sales Checking ────────────────────────────────────────────
model SalesDayClearing {
  id            String   @id @default(cuid())
  date          String // "YYYY-MM-DD"
  branch        String
  clearedById   String
  clearedAt     DateTime @default(now())
  isCleared     Boolean  @default(false) // true = officially cleared; false = draft-saved only
  actualAmounts Json? // [{ method: string, amount: number }]
  remarks       Json? // [{ method: string, remarks: string }]
  // Per-method OK ticks: [{ method, confirmed, source }]. source 'BANK_REC' means
  // the tick was set automatically because every one of that day's payments on
  // that method is linked to a reconciled bank line; 'USER' means hand-ticked.
  confirmed     Json?
  // Scanned deposit slips / sales proofs for the day: [{ url, name?, note? }].
  // A deposit covering several days is attached to each covered day with a note
  // saying so (covered dates are in the filename). Drives Scanned Sales Records.
  proofUrls     Json?
  updatedAt     DateTime @updatedAt

  @@unique([date, branch])
  @@index([date])
  @@index([branch])
}

// ── Asset Management ──────────────────────────────────────────

model Asset {
  id                  String    @id @default(cuid())
  branch              Branch
  name                String
  purchasePrice       Decimal
  quantity            Int       @default(1)
  totalAmount         Decimal
  dateBought          DateTime
  classification      String // e.g. "2020", "2030", … "2100"
  yearsDepreciation   Int // 3, 5, or 10
  monthlyDepreciation Decimal
  depreciationEndDate DateTime
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  sourceAccountId     String? // COA bank account the asset was purchased from (credited on the acquisition JE)
  fromPettyCash       Boolean   @default(false) // created from a petty-cash/expense entry — cash is handled by replenishment, so NO bank credit here (avoids double-counting cash on the BS)
  photoUrl            String? // main photo (shown in the list)
  photoUrls           Json? // all photos (gallery)
  isDefective         Boolean   @default(false)
  // A downpayment or part-payment is not a thing anyone can stand in front of and
  // check, so it is carried on the books but kept out of the audit. Only auditable
  // assets can be counted.
  auditable           Boolean   @default(true)
  departments         Json      @default("[]") // string[] of dept names
  utilized            Boolean   @default(true)
  controlNumber       String?
  accountableName     String? // staff accountable/custodian (from HR Hub)
  remarks             String?
  createdById         String
  createdBy           User      @relation("AssetCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([branch])
  @@index([classification])
  @@index([createdById])
}

// Annual physical asset audit. Snapshots the assets in scope at creation time,
// records per-asset condition (usable / needs replacement), and locks on finalize.
model AssetAudit {
  id          String    @id @default(cuid())
  refNumber   String // AUDIT-26-0001
  refSeq      Int
  dateFrom    DateTime
  dateTo      DateTime
  auditorName String
  branch      String // Branch enum value or 'ALL'
  departments Json      @default("[]") // string[] of dept names covered
  status      String    @default("DRAFT") // DRAFT | FINALIZED
  proofUrls   Json? // photo documentation of the audit
  finalizedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items AssetAuditItem[]

  @@unique([refNumber])
  @@index([branch])
}

model AssetAuditItem {
  id               String     @id @default(cuid())
  auditId          String
  audit            AssetAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  assetId          String
  // snapshot so the printed report is stable even if the asset later changes
  assetName        String
  controlNumber    String?
  classification   String?
  accountableName  String?
  usable           Boolean? // null = not yet assessed during the audit
  needsReplacement Boolean    @default(false)
  remarks          String?
  createdAt        DateTime   @default(now())

  @@index([auditId])
  @@index([assetId])
}

// Per-classification default depreciation years (set in Depreciation Settings)
model AssetDepreciationSetting {
  classification String   @id // "2020", "2030", ... "2100"
  years          Int // 3, 5, or 10
  updatedAt      DateTime @updatedAt
}

// ── Beginning Balances ───────────────────────────────────────
// One row per (Account, fiscal year) capturing the opening balance for the
// period. Required so the Balance Sheet reflects cumulative state — Cash,
// Owner's Equity, and Retained Earnings — instead of just current-year flows.
model BeginningBalance {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodYear  Int
  amount      Decimal   @default(0)
  startDate   DateTime? // bank reconciliation only considers Hub entries on/after this date
  notes       String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, periodYear])
  @@index([periodYear])
  @@index([accountId])
}

// ── IE / PR Payroll Tracking ──────────────────────────────────
// Mirrors PatientDocument records fetched from the teletherapy hub.
// We only store the payroll-tracking state locally; all document
// ── SOA (Statement of Account) ────────────────────────────────

// Singleton settings for SOA PDF generation (bank details, signatories, etc.)
model SoaSettings {
  id                   String   @id @default("singleton")
  clinicName           String?
  clinicAddress        String?
  bankName             String?
  bankBranch           String?
  bankAccountName      String?
  bankAccountNo        String?
  hmoOfficerName       String?
  hmoOfficerEsigUrl    String?
  clinicManagerName    String?
  clinicManagerEsigUrl String?
  contactEmail         String?
  contactPhone1        String?
  contactPhone2        String?
  // Per-provider code used in SOA reference numbers (BR-YYYYMMDD-HMO-000x),
  // as { [walletId]: "ITCR" }. Missing entries derive from the provider name.
  hmoCodes             Json?
  updatedAt            DateTime @updatedAt
}

// Generated SOA records (stored with base64 PDF data)
model SoaRecord {
  id              String   @id @default(cuid())
  walletId        String
  walletName      String
  period          String // "YYYY-MM" format
  pdfData         String? // Base64-encoded PDF
  branch          String?
  isHighlighted   Boolean  @default(false) // true when multiple SOAs for same provider+period
  // Orders covered by this SOA, captured at generation (JSON array of Order ids).
  // The "Submitted" button tags exactly these into an SoaSubmission batch.
  orderIds        Json?
  submittedDate   DateTime? // when the user recorded this SOA as actually submitted
  submissionId    String? // the SoaSubmission batch created by the Submitted button
  referenceNo     String? // copy of the batch's SOA reference number, for display
  generatedAt     DateTime @default(now())
  generatedById   String?
  generatedByName String?

  @@index([walletId, period])
  @@index([period])
}

// metadata (patient name, upload date, file) is fetched live from
// the teletherapy hub's internal API.
model IEPRPayrollRecord {
  id               String   @id @default(cuid())
  documentId       String   @unique // teletherapy PatientDocument.id
  staffId          String? // therapist Staff.id = Consultant.externalStaffId
  countedInPayroll Boolean  @default(false)
  cutoffPeriod     String? // e.g. "2026-04-1"
  notes            String?
  markedById       String? // accounting User.id who last updated
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([documentId])
  @@index([staffId])
  @@index([countedInPayroll])
  @@index([cutoffPeriod])
}

// Per-branch invoice header settings (company name, address, phone shown on invoices)
model InvoiceSettings {
  branch      String   @id
  companyName String?
  tradeName   String?
  address     String?
  phone       String?
  email       String?
  updatedAt   DateTime @updatedAt
}

// Corporate equity anchor (singleton). Authorized shares fix the total issued
// capital; Treasury Shares are derived as authorizedShares − outstanding, so the
// available-for-sale figure stays correct even if a reissuance wasn't tagged.
model EquitySettings {
  id                      String   @id @default("singleton")
  authorizedShares        Int      @default(20000000)
  authorizedCommonShares  Int? // sub-limit of authorized shares reserved for Common classes
  authorizedFounderShares Int? // sub-limit reserved for Founders classes
  updatedAt               DateTime @updatedAt
}

// ── Petty Cash module ─────────────────────────────────────────
model PettyCashEntry {
  id                  String               @id @default(cuid())
  branch              String // SANDBOX_EAST | SANDBOX_GREENHILLS | VERDANA_STORE
  pcvNumber           String // e.g. PCV26-001794
  pcvSeq              Int
  pcvSub              Int                  @default(1)
  requestor           String?
  department          String? // ADMIN, PT, OT, SLP, SPED, PSYCH, MD, ORTHOSIS (legacy single)
  // Contribution-margin department tags: empty = "All" (allocated by rent %).
  departments         String[]             @default([])
  pcfStatus           String? // Unliquidated | For Replenishment | Cancelled | Missing
  date                DateTime?
  description         String?
  vatable             String? // VAT | NV | Invalid | Cancelled
  siNumber            String?
  tinNumber           String? // XXX-XXX-XXX-XXXXX
  registeredName      String?
  registeredAddress   String?
  grossAmount         Decimal              @default(0)
  accountTitle        String?
  referenceNumber     String?
  proofUrl            String?
  proofUrls           Json?
  validity            String?
  branchAllocations   Json?
  recordType          String               @default("PETTY_CASH")
  finalized           Boolean              @default(false)
  audited             Boolean              @default(false)
  // A one-time copy made from a distributed recurring entry so the FULL amount can be
  // RFP'd/paid. The recurring entry already amortizes to the P&L, so this copy is kept
  // OUT of the Income Statement (skipReports) to avoid double-counting the expense.
  skipReports         Boolean              @default(false)
  sourceRecurringId   String? // links this one-time payment copy back to its recurring setup
  recurFrequency      String?
  recurDeadlineDay    Int?
  distributeMonthly   Boolean              @default(false)
  amountVaries        Boolean              @default(false)
  hasEwt              Boolean              @default(false)
  ewtRate             Int?
  ewtRemitted         Boolean              @default(false) // EWT withheld on this expense has been remitted via a Taxes EWT RFP
  ewtRemittedBranches Json? // CEO shared entries: per-branch EWT remittance state { SANDBOX_EAST: true, ... }
  distributeStart     DateTime?
  distributeEnd       DateTime?
  filingStatus        String?              @default("FOR_FILING")
  paidAt              DateTime?
  paymentMethod       String?
  checkNumber         String?
  creditCard          String?
  creditCardId        String?
  payrollAccount      String?
  paymentBankAccount  String?
  reimbursementId     String?
  reimbursement       ReimbursementReport? @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  // CEO petty cash only: a CEO expense can be allocated across branches and each
  // branch portion goes into its own branch RFP. Maps branch enum → RFP report id
  // so the same entry can be reimbursed once per branch without a single FK.
  rfpBranchMap        Json?
  assetAddedAt        DateTime? // set when this entry was added to Asset Management — persistent, cross-user "Added" state to prevent accidental double-adds
  inventoryRecordedAt DateTime? // set when this entry was recorded in Inventory & Procurement (new item / stock adjustment / capitalized freight) — persistent, cross-user "Recorded" state
  soaId               String? // links a one-time entry tagged "Paid by Credit Card" to its CreditCardSOA
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([branch, pcvNumber])
  @@index([branch])
  @@index([reimbursementId])
  @@index([recordType])
}

// A TikTok order that never became a sale — cancelled or failed-delivery, with
// TikTok's own reason. Informational only (no GL impact): postOrderJournal never
// sees these, since the orders importer only processes Order Status = Completed.
// Purpose is purely the Products Analysis "Top Cancellation Reasons" breakdown.
// Upserted by orderId so re-uploading the same TikTok export is a no-op, and a
// later "Cancelled" export can supply the real reason for an order that first
// showed up in a "Failed Delivery" export with no reason yet.
model TiktokCancellation {
  id            String    @id @default(cuid())
  orderId       String    @unique
  branch        String    @default("VERDANA_STORE")
  status        String // TikTok's Order Status at export time, e.g. "Canceled", "Shipped"
  cancelType    String? // TikTok's "Cancelation/Return Type"
  cancelBy      String? // System | User | Seller
  cancelReason  String? // null when the order failed delivery but hasn't been formally
  // cancelled by TikTok yet (Order Status still "Shipped"/"In transit")
  orderAmount   Decimal?
  cancelledTime DateTime?
  sourceFile    String // which upload last touched this row: "CANCELLED" | "FAILED_DELIVERY"
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([branch])
  @@index([cancelReason])
}

model ReimbursementReport {
  id             String    @id @default(cuid())
  branch         String
  refNumber      String // e.g. AHEA26-000001
  refSeq         Int
  grossTotal     Decimal   @default(0)
  status         String    @default("PENDING") // PENDING | PAID
  pdfData        String? // base64 data URI
  paidAt         DateTime?
  paymentMethod  String?
  checkNumber    String?
  transferRef    String?
  kind           String?
  module         String    @default("PETTY_CASH")
  payableTo      String? // who the payment is payable to → surfaces as Payee in the Expense Report
  filingStatus   String?   @default("FOR_FILING") // FOR_FILING | FILED — used by the Taxes Report
  meta           Json? // tax RFPs: { taxType, period, payrollBranch, items:[{id,name,gross,tax}] }
  creditCardId   String?
  debitAccount   String?
  depositAccount String?
  proofUrl       String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entries                  PettyCashEntry[]
  adjBatchesAsManufacturer InventoryAdjustmentBatch[] @relation("AdjBatchManufacturerRfp")
  adjBatchesAsFreight      InventoryAdjustmentBatch[] @relation("AdjBatchFreightRfp")
  glProcessorCases         GlCase[]                   @relation("GlProcessorRfp")

  @@unique([branch, refNumber])
  @@index([branch])
}

// Patient refunds — a deduction against Unearned Revenue (prepaid balances), NOT an
// expense. On refund-RFP payment we post DR Unearned Revenue / CR Cash. Refunds are
// grouped into an RFP (ReimbursementReport module='REFUND') exactly like expense RFPs,
// but never surface in the Expense Report.
model Refund {
  id                 String    @id @default(cuid())
  branch             String
  date               DateTime  @default(now())
  patientId          String? // Marketing Hub CRM patient id (optional)
  patientName        String
  refundAmount       Decimal   @default(0) // gross amount to refund
  chargesDeducted    Decimal   @default(0) // cancellation / processing charges withheld
  netAmount          Decimal   @default(0) // cash actually returned = refundAmount − chargesDeducted
  reason             String?
  proofUrls          Json? // string[] of uploaded proofs (file or QR)
  audited            Boolean   @default(false) // the "OK" check — required before RFP
  refundRfpId        String? // set when included in a Refund RFP (locked until paid/deleted)
  paidAt             DateTime?
  paymentMethod      String?
  checkNumber        String?
  paymentBankAccount String? // bank account credited (cash out)
  journalEntryId     String? // DR Unearned Revenue / CR Cash entry posted on payment
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([branch])
  @@index([refundRfpId])
  @@index([audited])
}

model PettyCashSettings {
  branch         String   @id // SANDBOX_EAST | SANDBOX_GREENHILLS | VERDANA_STORE
  nextPcvSeq     Int      @default(1)
  nextReimbSeq   Int      @default(1)
  requestors     Json     @default("[]")
  prepaidAccount String?
  updatedAt      DateTime @default(now()) @updatedAt
}

model CreditCard {
  id         String   @id @default(cuid())
  branch     String
  bank       String
  cardNumber String
  bankCode   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([branch])
}

model CreditCardReport {
  id           String    @id @default(cuid())
  branch       String
  cardId       String
  bankCode     String
  refSeq       Int
  refNumber    String
  periodMonth  Int
  periodYear   Int
  statementUrl String?
  status       String    @default("FOR_FILING")
  paidAt       DateTime? // when the credit-card bill itself was settled
  paymentForm  String? // Check Deposit | Cash Deposit | Online Fund Transfer
  paymentRef   String? // check number / transfer reference for the CC bill payment
  createdAt    DateTime  @default(now())

  @@unique([branch, cardId, periodMonth, periodYear])
  @@index([branch])
}

// Credit Card SOA — one Statement of Account per batch of one-time expenses
// tagged "Paid by Credit Card" for a chosen card. Flows: OPEN → IN_RFP (Request
// for RFP) → PAID (RFP recorded paid), or OPEN → PAID via petty cash. Paid SOAs
// surface in the Credit Card Report.
model CreditCardSOA {
  id               String    @id @default(cuid())
  branch           String
  cardId           String
  bankCode         String
  refNumber        String
  refSeq           Int
  status           String    @default("OPEN") // OPEN | IN_RFP | PAID
  paymentRoute     String? // RFP | PETTY_CASH
  statementUrl     String? // uploaded bank statement of account
  legacyRef        String? // pre-standardization reference (e.g. the source filename) kept for traceability
  periodYear       Int? // statement period the SOA covers (billing month)
  periodMonth      Int? // 1-12
  soaDocUrl        String? // system-generated SOA PDF (petty-cash proof)
  reimbursementId  String? // RFP created via Request for RFP
  pettyCashEntryId String? // settlement entry if paid through petty cash
  filingStatus     String    @default("FOR_FILING") // FOR_FILING | FILED
  paidAt           DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([branch, refNumber])
  @@index([branch])
}

// Cash Advance (event float): cash released to a staff up front, liquidated later,
// unspent balance returned. Release/return/reimburse post bank JEs (bank rec);
// liquidation lines post expense JEs (income statement). See src/app/api/cash-advances.
model CashAdvance {
  id              String   @id @default(cuid())
  branch          String
  refNumber       String // e.g. AHEA-CA26-0001
  refSeq          Int
  accountableName String // staff accountable for the float (HR Hub)
  purpose         String
  dateReleased    DateTime
  amount          Decimal // amount released
  sourceAccountId String? // bank account the float was released from
  status          String   @default("OPEN") // OPEN | CLOSED
  proofUrls       Json? // release proof(s): approval memo, acknowledgement receipt, etc.
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines CashAdvanceLine[]

  @@unique([branch, refNumber])
  @@index([branch])
}

model CashAdvanceLine {
  id                String      @id @default(cuid())
  advanceId         String
  advance           CashAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  kind              String // LIQUIDATION | RETURN | REIMBURSE
  date              DateTime
  accountTitle      String? // LIQUIDATION: the expense account
  description       String?
  vatable           String? // VAT | Non-VAT
  amount            Decimal // gross
  siNumber          String? // SI / OR number
  // Expense-entry parity fields (BIR-relevant supplier info)
  requestor         String? // payee (as picked from Suppliers)
  department        String?
  validity          String? // Valid | Invalid | Cancelled
  tinNumber         String?
  registeredName    String? // BIR-registered supplier name
  registeredAddress String?
  hasEwt            Boolean     @default(false)
  ewtRate           Int? // 5 | 10 (informational; float posting is unchanged)
  proofUrl          String?
  proofUrls         Json?
  bankAccountId     String? // RETURN / REIMBURSE bank account
  journalEntryId    String?
  createdById       String?
  createdAt         DateTime    @default(now())

  @@index([advanceId])
}

// Resolution for a flagged Sales Invoice number (a gap in the continuous sequence,
// or a duplicate): either declared CANCELLED, or acknowledged with REMARKS.
model SalesInvoiceFlag {
  id          String   @id @default(cuid())
  branch      String
  siNumber    String
  status      String // CANCELLED | REMARKS | TAGGED
  remarks     String?
  orderId     String? // TAGGED: the order this SI number was assigned to
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branch, siNumber])
  @@index([branch])
}

// Monthly sales target (with-SI) per branch — encoded by admin/accountant/bookkeeper.
model SalesTarget {
  id          String   @id @default(cuid())
  branch      String
  periodMonth Int
  periodYear  Int
  target      Decimal  @default(0)
  createdById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([branch, periodMonth, periodYear])
  @@index([branch])
}

model ExpenseSupplier {
  id                String   @id @default(cuid())
  branch            String
  registeredName    String
  registeredAddress String?
  tin               String?
  createdAt         DateTime @default(now())

  @@unique([branch, registeredName])
  @@index([branch])
}

model FundTransfer {
  id            String   @id @default(cuid())
  refNumber     String   @unique // FTYY-000001
  refSeq        Int
  date          DateTime
  fromAccountId String
  toAccountId   String
  amount        Decimal
  // Cross-currency transfers (e.g. buying CNY out of a PHP account): `amount` is
  // always what left the source account, `toAmount` what landed in the
  // destination, and the implied rate is amount / toAmount. Both null on an
  // ordinary same-currency transfer.
  toAmount      Decimal?
  exchangeRate  Decimal?
  checkNumber   String?
  description   String?
  proofUrl      String?
  proofUrls     Json? // multiple attachments (proofUrl kept = first, for back-compat)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

model FundTransferSettings {
  id        String   @id @default("singleton")
  nextSeq   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt
}

// Manually-recorded cancelled/voided checks, kept per checking account so the
// Check Release Monitoring log has a record of checks that were spoiled/cancelled.
model CancelledCheck {
  id          String   @id @default(cuid())
  accountId   String // Account.id of the checking account the check was drawn on
  checkNumber String
  date        DateTime
  reason      String?
  payee       String?
  amount      Decimal  @default(0)
  proofUrls   Json? // scanned image(s) of the cancelled check
  createdById String?
  createdAt   DateTime @default(now())

  @@index([accountId])
}

// Ephemeral session backing the "Scan QR" phone-upload flow. The desktop creates
// one (with the section's naming prefix), shows a QR to the token URL, the phone
// uploads photos into it, and the desktop polls `urls` until done.
model UploadSession {
  id          String   @id @default(cuid()) // the token embedded in the QR
  prefix      String // filename prefix, e.g. AHEA-PCV26-000077
  section     String // petty-cash | expenses | taxes | cash-advance | ar | fund-transfer | asset
  urls        Json     @default("[]")
  createdById String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// ── Equity: shareholders, common/preferred shares, dividends ──
model Shareholder {
  id          String    @id @default(cuid())
  shNumber    String    @unique // SH0001, SH0002 …
  shSeq       Int       @unique
  name        String
  tin         String?
  birthdate   DateTime?
  email       String?
  mobile      String?
  address     String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  commonShares    CommonShare[]
  preferredShares PreferredShare[]
  // Transfers where this shareholder was the buyer (kept for the registry even
  // if the bought holding is later deleted).
  transfersReceived ShareTransfer[] @relation("TransfersReceived")
}

model CommonShare {
  id                      String          @id @default(cuid())
  shareholderId           String
  shareholder             Shareholder     @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  dateAcquired            DateTime
  agreementType           String // SUBSCRIPTION | DEED_OF_ASSIGNMENT
  assignedToShareholderId String? // when DEED_OF_ASSIGNMENT — who the shares are assigned to
  agreementUrls           Json?
  stockCertNumber         String?
  proofOfDepositUrls      Json?
  validIdUrls             Json? // shareholder's valid ID(s) — multi-file, QR upload
  shareClass              String? // e.g. "Common – Voting – with Par" / "Founders – …"
  numberOfShares          Decimal
  truePar                 Decimal? // par value per share (PHP)
  apic                    Decimal? // additional paid-in capital per share (PHP)
  pricePerShare           Decimal // = truePar + apic (issue price per share)
  soldFromTreasury        Boolean         @default(false) // shares reissued from treasury (bought-back) stock
  // Mutual rescission: the issuance is treated as if it never happened — the
  // issuance JE is reversed (both legs vanish from the statements) and the
  // holding is excluded from every share count and capitalization figure.
  rescinded               Boolean         @default(false)
  // Single bank account the equity was debited into. Kept for back-compat and
  // still used when the holding has no EquityDeposit rows — one deposit, one
  // bank, the common case. When deposits exist they take over entirely.
  bankAccountId           String? // COA bank account the equity was debited into
  equityAccountId         String? // COA equity account credited on issuance (chosen from CoA)
  // Debited for any part of the subscription not yet paid, when itemised
  // deposits fall short of the full capitalization. Without it a short-paid
  // holding cannot post a balanced entry, so the JE is withheld instead.
  receivableAccountId     String?
  journalEntryId          String?
  // Consideration actually received for the shares, itemised. A subscription can
  // be paid across several deposits, into different bank accounts, on different
  // dates — and some consideration is not cash at all (e.g. equipment bought for
  // the company). See EquityDeposit.
  deposits                EquityDeposit[]
  // Buyback → Treasury Shares. Legacy single-buyback columns kept for back-compat;
  // buybacks are now recorded as ShareBuyback rows (multiple per shareholder).
  boughtBack              Boolean         @default(false)
  buybackPrice            Decimal?
  buybackShares           Decimal?
  buybackBankAccountId    String?
  treasuryAccountId       String? // COA equity/treasury account debited on buyback
  buybackProofUrls        Json?
  buybackJournalEntryId   String?
  buybacks                ShareBuyback[]
  // Secondary sales: shares this holding sold to another party (out), and the
  // transfer that created this holding when it was bought from another
  // shareholder (in). See ShareTransfer.
  transfersOut            ShareTransfer[] @relation("TransferFrom")
  transferIn              ShareTransfer?  @relation("TransferTo")
  // Who the shares are really held for. A holding can be split across several
  // beneficial owners; allocations are registry info only (no GL impact).
  beneficialOwners        BeneficialOwner[]
  createdById             String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([shareholderId])
}

// A secondary sale of shares: one shareholder sells part or all of a common
// holding to another party — a current shareholder or an external buyer. The
// price is settled privately between the two parties and never passes through
// a company bank account, so the company records NO cash movement: total
// equity on the balance sheet is unchanged. What is recorded is the ownership
// move — the seller's holding shrinks by `shares`, a new holding
// (`toCommonShareId`, agreement type DEED_OF_ASSIGNMENT) is created for the
// buyer at the seller's BOOK value (par/APIC), and a net-zero memo journal
// entry (DR/CR the same equity account, referenceType EQUITY_TRANSFER) keeps
// the per-investor attribution in the ledger. `price` is the private
// per-share sale price, kept for the registry only — it is deliberately NOT
// what the journal entry is measured at.
model ShareTransfer {
  id                String       @id @default(cuid())
  fromCommonShareId String
  fromCommonShare   CommonShare  @relation("TransferFrom", fields: [fromCommonShareId], references: [id], onDelete: Cascade)
  toCommonShareId   String?      @unique // buyer's holding created by this transfer
  toCommonShare     CommonShare? @relation("TransferTo", fields: [toCommonShareId], references: [id], onDelete: SetNull)
  toShareholderId   String
  toShareholder     Shareholder  @relation("TransfersReceived", fields: [toShareholderId], references: [id])
  date              DateTime
  shares            Decimal
  price             Decimal // per-share price the buyer paid the seller (private, off the company's books)
  proofUrls         Json? // deed of sale / proof of the private payment
  journalEntryId    String? // the net-zero equity memo entry
  createdById       String?
  createdAt         DateTime     @default(now())

  @@index([fromCommonShareId])
}

// A beneficial owner of (part of) a common shareholding — the registered holder
// holds the shares, but some or all are beneficially owned by someone else.
// Allocations across a holding's owners may not exceed its net (post-buyback)
// shares. Registry information only: no journal entries are posted from this.
model BeneficialOwner {
  id            String      @id @default(cuid())
  commonShareId String
  commonShare   CommonShare @relation(fields: [commonShareId], references: [id], onDelete: Cascade)
  name          String
  tin           String?
  email         String?
  address       String?
  shares        Decimal
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([commonShareId])
}

// A single buyback event against a common shareholding. A shareholder may have
// several. Each posts its own DR Treasury / CR Bank journal entry.
// One item of consideration received for a common shareholding. A holding may
// have many: several cash deposits (possibly into different bank accounts, on
// different dates), and/or non-cash consideration such as equipment purchased
// on the company's behalf, which never appears on a bank statement.
//
// When a holding has deposits, the issuance journal entry debits one line per
// deposit instead of a single line to CommonShare.bankAccountId. Deposits need
// not sum to the full capitalization — any shortfall is debited to the
// subscription-receivable account chosen on the holding, which is the correct
// treatment for a partially paid subscription.
model EquityDeposit {
  id               String          @id @default(cuid())
  // A deposit belongs to exactly one holding — common OR preferred. Preferred shares
  // are paid for the same way and need the same bank-rec tagging, so both are allowed
  // and exactly one is set (enforced in the API).
  commonShareId    String?
  commonShare      CommonShare?    @relation(fields: [commonShareId], references: [id], onDelete: Cascade)
  preferredShareId String?
  preferredShare   PreferredShare? @relation(fields: [preferredShareId], references: [id], onDelete: Cascade)
  date             DateTime
  amount           Decimal
  kind             String          @default("CASH") // CASH | NON_CASH
  bankAccountId    String? // COA bank account debited — CASH only
  assetAccountId   String? // COA asset/expense account debited — NON_CASH only
  note             String? // e.g. "Equipment purchased for the company"
  proofUrls        Json?
  createdById      String?
  createdAt        DateTime        @default(now())

  @@index([commonShareId])
  @@index([preferredShareId])
}

model ShareBuyback {
  id                String      @id @default(cuid())
  commonShareId     String
  commonShare       CommonShare @relation(fields: [commonShareId], references: [id], onDelete: Cascade)
  date              DateTime
  shares            Decimal
  price             Decimal
  bankAccountId     String?
  treasuryAccountId String?
  journalEntryId    String?
  proofUrls         Json?
  createdById       String?
  createdAt         DateTime    @default(now())

  @@index([commonShareId])
}

model PreferredShare {
  id                 String      @id @default(cuid())
  shareholderId      String
  shareholder        Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  dateAcquired       DateTime
  agreementType      String // SUBSCRIPTION | DEED_OF_ASSIGNMENT
  agreementUrls      Json?
  stockCertNumber    String?
  proofOfDepositUrls Json?
  validIdUrls        Json? // shareholder's valid ID(s) — multi-file, QR upload
  shareClass         String? // e.g. "Preferred – Voting – with Par" / "Redeemable Preferred – …"
  numberOfShares     Decimal
  retiredShares      Decimal?    @default(0) // preferred shares redeemed/retired
  truePar            Decimal? // par value per share (PHP)
  apic               Decimal? // additional paid-in capital per share (PHP)
  pricePerShare      Decimal // = truePar + apic (issue price per share)
  bankAccountId      String?
  equityAccountId    String? // COA equity account credited on issuance
  journalEntryId     String?
  annualInterest     Decimal? // % per year
  maturityYears      Int? // buyback maturity, e.g. 5
  buybackPrice       Decimal? // price to buy back at maturity
  payoutSchedule     String? // ANNUALLY | BIANNUALLY | QUARTERLY | MONTHLY
  payoutStartMonth   Int? // 1–12
  payoutStartYear    Int?
  payoutDay          Int? // day of month (capped to month end), e.g. 30
  pdcUrls            Json? // post-dated cheques (multi)
  createdById        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  payouts  PreferredPayout[]
  deposits EquityDeposit[]

  @@index([shareholderId])
}

// Preferred dividend payout history / schedule occurrences.
model PreferredPayout {
  id               String         @id @default(cuid())
  preferredShareId String
  preferredShare   PreferredShare @relation(fields: [preferredShareId], references: [id], onDelete: Cascade)
  shareholderId    String
  dueDate          DateTime
  amount           Decimal
  status           String         @default("PENDING") // PENDING | PAID
  paidDate         DateTime?
  bankAccountId    String?
  proofUrls        Json?
  emailedAt        DateTime?
  journalEntryId   String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([preferredShareId])
  @@index([dueDate])
}

// Common-share dividend releases.
model DividendRelease {
  id                  String    @id @default(cuid())
  date                DateTime
  boardResolutionUrls Json?
  dividendAmount      Decimal // per common share
  dividendType        String // REGULAR | SPECIAL
  totalAmountPaid     Decimal   @default(0)
  status              String    @default("DRAFT") // DRAFT | FINALIZED
  bankAccountId       String? // bank credited when the dividend is paid
  retainedAccountId   String? // equity account debited (Retained Earnings)
  proofOfDepositUrls  Json?
  journalEntryId      String?
  finalizedAt         DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items DividendReleaseItem[]
}

model DividendReleaseItem {
  id              String          @id @default(cuid())
  releaseId       String
  release         DividendRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  shareholderId   String
  shareholderName String
  shares          Decimal
  amount          Decimal
  emailedAt       DateTime?

  @@index([releaseId])
}

// Preferred-share dividend (quarterly interest) releases — tick which preferred
// shareholders were paid for the period, upload proof, email each.
model PreferredDividendRelease {
  id                 String   @id @default(cuid())
  date               DateTime // deposit / payout date
  quarterKey         String // "2025-Q3" — used to build the per-quarter matrix
  periodLabel        String? // "Q3 2025"
  proofOfDepositUrls Json?
  bankAccountId      String? // CR on payout
  expenseAccountId   String? // DR (interest expense / retained earnings)
  journalEntryId     String?
  totalAmountPaid    Decimal  @default(0)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items PreferredDividendItem[]

  @@index([quarterKey])
}

model PreferredDividendItem {
  id              String                   @id @default(cuid())
  releaseId       String
  release         PreferredDividendRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  shareholderId   String
  shareholderName String
  shares          Decimal
  amount          Decimal // quarterly dividend for this shareholder
  paidDate        DateTime?
  emailedAt       DateTime?

  @@index([releaseId])
}

// ── Scholars: award terms for approved fellowship scholars ────────
// The approved roster (name, school, program) is pulled LIVE from the
// scholarship portal (scholarship.sapphireclinicseast.org). Award financials
// live here, keyed to the portal scholar id. One row per approved scholar.
model ScholarAward {
  id               String   @id @default(cuid())
  portalScholarId  String   @unique // UgatScholar.id from the scholarship portal
  scholarName      String // snapshot for history if the portal row goes away
  school           String? // snapshot from the portal
  email            String? // snapshot from the portal (for release notices)
  academicYear     String? // e.g. "2025-2026" — entered here (portal has no A.Y.)
  scholarshipType  String? // free-text, self-building dropdown on the client
  amountAwarded    Decimal  @default(0) // total award over the whole grant
  monthlyAmount    Decimal  @default(0) // amount released each month
  startMonth       String? // "YYYY-MM" — first release month
  releaseDay       Int? // day of month the check is deposited (1..31)
  numberOfMonths   Int? // duration in months
  signedRsaUrls    Json? // uploaded signed RSA (Return Service Agreement) files
  bankAccountId    String? // default bank the release is paid from (CR)
  expenseAccountId String? // default scholarship-expense account (DR)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  releases ScholarRelease[]

  @@index([academicYear])
  @@index([school])
}

// One recorded monthly disbursement for a scholar. Posts DR scholarship
// expense / CR bank (refType SCHOLAR_RELEASE) so it folds into the P&L.
model ScholarRelease {
  id                 String       @id @default(cuid())
  awardId            String
  award              ScholarAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  monthKey           String // "YYYY-MM" the release is FOR (drives the matrix)
  date               DateTime // actual deposit date
  amount             Decimal
  bankAccountId      String?
  expenseAccountId   String?
  journalEntryId     String?
  proofOfDepositUrls Json?
  emailedAt          DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())

  @@unique([awardId, monthKey])
  @@index([awardId])
  @@index([monthKey])
}

// ── Loans & Advances: Advances ────────────────────────────────
model Advance {
  id                       String   @id @default(cuid())
  shareholderId            String?
  name                     String
  dateAcquired             DateTime
  advanceType              String // CASH | KIND
  kindType                 String?
  principalAmount          Decimal
  hasInterest              Boolean  @default(false)
  interestMode             String? // ANNUAL_PCT | MONTHLY_AMORT
  annualPct                Decimal?
  termMonths               Int?
  monthlyAmortization      Decimal?
  computedAnnualPct        Decimal? // back-computed effective annual rate (IRR)
  totalInterest            Decimal?
  proofOfDepositUrls       Json?
  bankAccountId            String? // debited (money in)
  creditAccountId          String? // Advances liability account (CR on release)
  interestExpenseAccountId String? // interest expense account
  // Which branch(es) this advance funds, as [{branch, amount}]. Drives where the
  // interest expense lands on the branch income statements — same shape and meaning
  // as Loan.branchAllocations. Null/empty = company-wide (All Branches view only).
  branchAllocations        Json?
  payoutSchedule           String? // ANNUALLY | BIANNUALLY | QUARTERLY | MONTHLY
  payoutStartMonth         Int?
  payoutStartYear          Int?
  payoutDay                Int?
  payoutAmountPerPeriod    Decimal? // explicit cash-out per period (overrides derived amount)
  repaymentMode            String? // INTEREST_ONLY | AMORTIZING (null = legacy amortizing)
  principalPerPeriod       Decimal? // explicit principal portion per period (interest = amount − principal)
  paymentBankAccountId     String? // bank credited on each amortization payment (CR)
  pdcUrls                  Json?
  remarks                  String?
  journalEntryId           String?
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  payouts AdvancePayout[]

  @@index([shareholderId])
}

model AdvancePayout {
  id               String    @id @default(cuid())
  advanceId        String
  advance          Advance   @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  principalPortion Decimal   @default(0)
  interestPortion  Decimal   @default(0)
  amount           Decimal
  status           String    @default("PENDING") // PENDING | PAID
  paidDate         DateTime?
  bankAccountId    String?
  proofUrls        Json?
  memo             String?
  emailedAt        DateTime?
  journalEntryId   String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([advanceId])
  @@index([dueDate])
}

// ── Loans & Advances: Loans ───────────────────────────────────
model Loan {
  id                       String    @id @default(cuid())
  loanEntity               String // SHAREHOLDER | BANK | OTHER
  shareholderId            String? // when loanEntity = SHAREHOLDER
  entityName               String? // bank / other-institution name
  name                     String // display name (shareholder name or entity name)
  dateAcquired             DateTime
  loanType                 String // CASH | CORPORATE_BOND | KIND
  kindType                 String?
  principalAmount          Decimal
  // Cash / Kind interest (straight-line amortization, mirrors Advance)
  hasInterest              Boolean   @default(false)
  interestMode             String? // ANNUAL_PCT | MONTHLY_AMORT
  annualPct                Decimal?
  termMonths               Int?
  monthlyAmortization      Decimal?
  computedAnnualPct        Decimal?
  totalInterest            Decimal?
  // Corporate bond: annual coupon %; principal repaid at maturity
  maturityDate             DateTime?
  proofOfDepositUrls       Json?
  bankAccountId            String? // debited (money in) — net of deducted charges
  creditAccountId          String? // Loan liability account (CR on release)
  interestExpenseAccountId String?
  payoutSchedule           String? // ANNUALLY | BIANNUALLY | QUARTERLY | MONTHLY
  payoutStartMonth         Int?
  payoutStartYear          Int?
  payoutDay                Int?
  payoutAmountPerPeriod    Decimal? // explicit cash-out per period (overrides derived amount)
  repaymentMode            String? // INTEREST_ONLY | AMORTIZING (null = legacy amortizing)
  principalPerPeriod       Decimal? // explicit principal portion per period (interest = amount − principal)
  paymentBankAccountId     String? // bank credited on each amortization/coupon payment (CR)
  loanAgreementUrls        Json?
  pdcUrls                  Json?
  netAmountToDebit         Decimal? // principal − charges deducted from disbursement
  // [{branch: 'SANDBOX_EAST'|…, amount}] — which branch(es) this loan funds; interest
  // expense follows this split on the branch income statements (null = company-wide)
  branchAllocations        Json?
  remarks                  String?
  fromCreditLineId         String? // set when this loan is a credit-line drawdown
  journalEntryId           String?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  charges LoanCharge[]
  payouts LoanPayout[]

  @@index([shareholderId])
  @@index([fromCreditLineId])
}

// One-time charges on a loan (mirrors an Expenses one-time expense; may be
// deducted from the disbursement). Each also creates an Expenses entry.
model LoanCharge {
  id                String   @id @default(cuid())
  loanId            String
  loan              Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  date              DateTime
  description       String
  registeredName    String? // supplier / payee
  vatable           String? // VAT | NV
  amount            Decimal
  siNumber          String?
  chargeAccountId   String? // expense account (COA)
  deductedFromDebit Boolean  @default(false)
  proofUrls         Json?
  pettyCashEntryId  String? // linked Expenses-history entry
  createdAt         DateTime @default(now())

  @@index([loanId])
}

model LoanPayout {
  id               String    @id @default(cuid())
  loanId           String
  loan             Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  dueDate          DateTime
  principalPortion Decimal   @default(0)
  interestPortion  Decimal   @default(0)
  amount           Decimal
  status           String    @default("PENDING") // PENDING | PAID
  paidDate         DateTime?
  bankAccountId    String?
  proofUrls        Json?
  memo             String?
  emailedAt        DateTime?
  journalEntryId   String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([loanId])
  @@index([dueDate])
}

// ── Loans & Advances: Credit Line ─────────────────────────────
model CreditLine {
  id                    String    @id @default(cuid())
  entityName            String // lender / facility name
  amount                Decimal // total available line
  interestPct           Decimal? // annual %
  utilized              Boolean   @default(false)
  // "Paid full earlier" settlement
  settledAt             DateTime?
  settledJournalEntryId String?
  remarks               String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ── POS settlement batches (bank rec) ────────────────────
// A bank deposit that settles a set of POS order payments: a day's cash count
// deposited 1-3 days later, or a card/GCash/PayMaya batch credited net of the
// payment mode's deductions. The batch records exactly which order payments a
// deposit covered; an order payment can settle into at most one deposit.
model PosSettlementBatch {
  id                String   @id @default(cuid())
  bankTransactionId String   @unique // the bank line this batch settles
  paymentModeId     String? // mode the payments were made through
  label             String
  grossTotal        Decimal  @default(0)
  netTotal          Decimal  @default(0) // gross minus mode deductions (what the bank shows)
  createdById       String?
  createdAt         DateTime @default(now())

  payments PosSettlementPayment[]
}

model PosSettlementPayment {
  id             String             @id @default(cuid())
  batchId        String
  batch          PosSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderPaymentId String             @unique // settles into at most one deposit
  amount         Decimal            @default(0)

  @@index([batchId])
}

model BankTransaction {
  id                String   @id @default(cuid())
  bankAccountId     String // Account.id (a Chart-of-Accounts bank account)
  date              DateTime
  description       String
  spent             Decimal  @default(0)
  received          Decimal  @default(0)
  status            String   @default("PENDING") // PENDING | POSTED | EXCLUDED
  fromToName        String?
  categoryAccountId String? // Categorise target account
  matchType         String? // FUND_TRANSFER | RFP | ORDER | CC_REPORT | ...
  matchId           String?
  matchLabel        String?
  journalEntryId    String? // GL journal posted on Categorise
  note              String?
  proofUrl          String?
  // Running balance printed on the statement for this line, when the uploaded
  // file carries one. Lets a balance "as of" any date be read straight off the
  // statement instead of being inferred from a chain of movements.
  statementBalance  Decimal?
  // Rate applied when this line was posted, for accounts not held in PHP. Kept
  // on the line so the general-ledger figure can always be traced back to the
  // rate that produced it, even if the rate table is edited afterwards.
  fxRate            Decimal?
  importBatch       String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([bankAccountId, status])
  @@index([date])
}

// SKU Guide: a manually-maintained dictionary of SKU classification codes
// (DEPT-CAT-SUBCAT prefix → human meaning). Product count is derived live from
// InventoryItem.sku (startsWith "<skuCode>-").
// One "Upload from file" run in Bank Reconciliation. Statement uploads are
// corrected and re-done often, so the lines from a single file are grouped here
// and can be removed together instead of one row at a time.
model BankImportBatch {
  id            String   @id @default(cuid())
  bankAccountId String
  fileName      String?
  rowCount      Int      @default(0)
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([bankAccountId])
}

// Exchange rates used to state foreign-currency accounts in PHP.
//
// Rates are captured from transactions that actually happened — every currency
// exchange matched in Bank Reconciliation records the rate it implied — and can
// also be entered by hand for dates with no exchange of their own.
model ExchangeRate {
  id          String   @id @default(cuid())
  currency    String // the foreign currency, e.g. "CNY"
  date        DateTime @db.Date // effective date
  phpPerUnit  Decimal // PHP for 1 unit of `currency`
  source      String   @default("MANUAL") // MANUAL | FOREX_MATCH
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([currency, date])
  @@index([currency, date])
}

model SkuDefinition {
  id           String   @id @default(cuid())
  skuCode      String   @unique
  department   String
  mainCategory String
  subcategory  String
  details      String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([skuCode])
}

// Budgeting: per-month budgeted amount per Income-Statement line (COA account),
// compared against the actual IS values to compute variance. Lockable per period.
model BudgetEntry {
  id          String   @id @default(cuid())
  year        Int
  month       Int // 1-12
  branch      String // Branch enum value, or 'ALL'
  accountKey  String // "7010 Physical Therapy Services Revenue" (accountNumber + title)
  accountType String // REVENUE | EXPENSE | COGS
  amount      Decimal  @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month, branch, accountKey])
  @@index([year, branch])
}

model BudgetLock {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  branch     String
  lockedById String?
  lockedAt   DateTime @default(now())

  @@unique([year, month, branch])
}

/// Accounting's own copy of the staff feed, one row per person ever synced.
///
/// The upstream feeds only list people who are still with us, so once someone resigns they
/// simply stop appearing — leaving Payroll unable to tell "resigned" from "the feed hiccuped",
/// which is why resigned consultants used to be left active forever and kept turning up in
/// payslip generation. This table remembers everyone we have ever seen, so absence becomes a
/// fact we can act on. It is a record of the FEED, never a payroll record: payslips stay keyed
/// to Consultant/Employee, so retiring someone here never hides what they were paid.
model StaffDirectory {
  id              String    @id @default(cuid())
  externalStaffId String    @unique // Operations Staff.id, or HR id for HR-sourced staff
  source          String // OPERATIONS | HR
  name            String
  branch          String
  department      String?
  employmentType  String?
  activeUpstream  Boolean   @default(true) // what the feed last said about them
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  missingSince    DateTime? // first sync that stopped listing them at all
  resignedAt      DateTime? // when we concluded they are gone (flag or absence)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([branch])
  @@index([resignedAt])
}

// ── Statutory benefit availments ───────────────────────────────
// When a staff member claims maternity, sickness or ECC benefits, the company
// pays her up front and SSS reimburses months later. The money is therefore not
// an expense but a receivable from the agency, and only the portion the company
// grants on top of the statutory amount is a real cost.
//
// This is a monitoring record, not a second posting path: the cash still moves
// through the RFP that paid it, and `advanceRfpId` / `reimbursementRfpId` point
// at those entries. Recording it here as well would double the amounts.
model BenefitAvailment {
  id                 String    @id @default(cuid())
  branch             String
  employeeId         String?
  employeeName       String
  benefitType        String // MATERNITY | SICKNESS | ECC | OTHER
  periodFrom         DateTime?
  periodTo           DateTime?
  // Advanced on the agency's behalf — the receivable (1165).
  amountAdvanced     Decimal   @default(0)
  // Granted by the company on top of the statutory benefit — a real expense (8340).
  companyShare       Decimal   @default(0)
  datePaidToEmployee DateTime?
  advanceRfpId       String?
  reimbursedAmount   Decimal   @default(0)
  reimbursedDate     DateTime?
  reimbursementRfpId String?
  notes              String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([branch])
  @@index([employeeName])
  @@index([reimbursedDate])
}

// Auto-categorization rules for bank reconciliation. A rule maps a description
// pattern (case-insensitive substring) to a category account; applying rules
// posts the same JE the manual categorise action posts. 2,019 pending imports
// motivated this — recurring payees should be categorized once, not 2,019 times.
model BankCategoryRule {
  id                String    @id @default(cuid())
  pattern           String // case-insensitive substring matched against description + fromToName
  direction         String    @default("ANY") // OUT | IN | ANY
  bankAccountId     String? // limit to one bank account; null = all
  categoryAccountId String
  fromToName        String? // stamp a payee on matched lines
  // Rules only touch lines dated on/after this. Expenses before it were
  // recorded through other channels (QB imports, the petty module), and a rule
  // reaching back would count them twice.
  effectiveFrom     DateTime?
  active            Boolean   @default(true)
  createdById       String
  createdAt         DateTime  @default(now())

  @@index([active])
}

// An itemized register for 4010 Accounts Payable. The balance-sheet figure is
// one lump; these rows name what it is made of, and closing one posts the
// settling entry (Dr 4010 / Cr the chosen account) so the lump and the list
// walk down together. Salaries and taxes clear through RFPs; this is for
// everything else, which previously had no way to close at all.
model APItem {
  id                  String    @id @default(cuid())
  vendor              String
  description         String?
  amount              Decimal
  dateIncurred        DateTime
  branch              String    @default("ALL")
  status              String    @default("OPEN") // OPEN | CLOSED
  closedAt            DateTime?
  closeAccountId      String? // what settled it: a bank account, petty cash, or an income/equity account for write-offs
  closeNote           String?
  closeJournalEntryId String?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
}

// The CEO petty cash fund before it lived in the Hub: amounts were advanced to
// the CEO's personal account, spent across branches, and replenished — not to
// the peso, so the RFP model cannot hold it. This register carries that history
// verbatim from the interbranch monitoring workbook: display-only, ledger-
// neutral, because QuickBooks already recorded the expense side.
model CeoPcfHistory {
  id          String   @id @default(cuid())
  branch      String
  date        DateTime
  particulars String
  receivedBy  String?
  cashIn      Decimal  @default(0)
  cashOut     Decimal  @default(0)
  fileName    String?
  remarks     String?
  qbRecorded  Boolean  @default(false)
  qbRef       String?
  createdAt   DateTime @default(now())

  @@index([branch, date])
}

/// A net-pay amount broken into instalments so each one can be paid — and bank
/// reconciled — separately. The splits of a payslip must sum to its net pay, so
/// nothing is created or lost by splitting; only the timing of payment changes.
/// Once a payslip has splits, the splits (not the payslip) are what gets put in
/// an RFP and marked remitted; the parent flips to remitted when all of its
/// splits are, so every existing report keeps working unchanged.
model SalaryPayableSplit {
  id                String  @id @default(cuid())
  /// Exactly one of these is set — employees and consultants live in
  /// different tables but split identically.
  employeePayslipId String?
  payrollEntryId    String?
  seq               Int /// 1-based, for stable display order
  amount            Decimal @db.Decimal(12, 2)
  note              String?

  salariesRemitted Boolean   @default(false)
  salaryRfpId      String? /// set while included in a Salaries-Payable RFP
  salaryPaymentId  String?
  paidAt           DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  employeePayslip EmployeePayslip? @relation(fields: [employeePayslipId], references: [id], onDelete: Cascade)
  payrollEntry    PayrollEntry?    @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)

  @@unique([employeePayslipId, seq])
  @@unique([payrollEntryId, seq])
  @@index([employeePayslipId])
  @@index([payrollEntryId])
  @@index([salaryRfpId])
  @@index([salariesRemitted])
  @@index([salaryPaymentId])
}

/// A cheque as written in the physical chequebook — the issuance itself, before
/// and regardless of what expense it paid for. Check Release Monitoring is built
/// on this: the register is the spine, and the petty-cash / RFP / fund-transfer
/// records that reference the same number hang off it as the breakdown of what
/// the cheque covered. Cancelled and unused leaves are kept, because a chequebook
/// that skips numbers cannot be reconciled.
model IssuedCheque {
  id          String    @id @default(cuid())
  accountId   String
  /// Digits only, exactly as printed (leading zeros preserved).
  checkNumber String
  date        DateTime?
  payee       String?
  amount      Decimal   @default(0)
  /// ISSUED | CANCELLED | UNUSED
  status      String    @default("ISSUED")
  note        String?
  /// Where the row came from, e.g. "chequebook 2024-2026".
  source      String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, checkNumber])
  @@index([accountId])
  @@index([date])
  @@index([status])
}

// Rent allocation for the Contribution Margin analysis: per branch, what % of
// that branch's rent (8210 indirect + 8211 direct) each department carries.
// Managed from the Contribution Margin tab.
model ContributionRentAllocation {
  id         String   @id @default(cuid())
  branch     String
  department String
  pct        Decimal  @default(0)
  // 'RENT' (8210+8211) or 'OTHER' (every remaining expense) — each category
  // carries its own per-branch percentages.
  category   String   @default("RENT")
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([branch, department, category])
}

/// What the till is currently showing the patient at one branch.
///
/// One row per branch, overwritten in place: the tablet is fixed at that
/// branch's address, so the branch is the pairing key and there is never more
/// than one live checkout to choose between. Ephemeral by nature — a stale row
/// is harmless because `active` is cleared when the cashier closes the form,
/// and the tablet ignores anything older than a few minutes.
model PatientViewCheckout {
  id     String  @id @default(cuid())
  branch String  @unique
  active Boolean @default(true)

  /// { patientName, items[], discountLabel, subtotal, discountAmount, netAmount, payments[] }
  /// Held as JSON because this mirrors an unsaved cart, not a persisted order —
  /// giving it columns would imply it is a record of something that happened.
  payload Json

  /// A card barcode the tablet scanned, for the till to pick up and apply.
  /// Cleared once the till has consumed it.
  scannedCode String?
  scannedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
