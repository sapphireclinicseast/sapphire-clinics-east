generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  ACCOUNTANT
  VIEWER
  SBEA_ADMIN
  SBGH_ADMIN
  VERDANA_ADMIN
  SBEA_FRONTDESK
  SBGH_FRONTDESK
}

enum Branch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  VERDANA_STORE
  ALL
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// ── User ─────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(VIEWER)
  branch           Branch?
  avatar           String?
  resetToken       String?
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AuditLog[]
  accounts  Account[]

  servicesCreated       Service[]               @relation("ServiceCreatedBy")
  suppliersCreated      Supplier[]              @relation("SupplierCreatedBy")
  inventoryItems        InventoryItem[]         @relation("ItemCreatedBy")
  inventoryAdjustments  InventoryAdjustment[]   @relation("AdjustmentBy")
  transfersRequested    ConsignmentTransfer[]   @relation("TransferRequestedBy")
  transfersApproved     ConsignmentTransfer[]   @relation("TransferApprovedBy")

  referrersCreated      Referrer[]              @relation("ReferrerCreatedBy")
  walletLogs            WalletLog[]             @relation("WalletLogBy")
  ordersCreated         Order[]                 @relation("OrderCreatedBy")
  discountSettings      DiscountSetting[]       @relation("DiscountCreatedBy")
  arPayments            ARPayment[]             @relation("ARPaymentCreatedBy")
  payrollEntries        PayrollEntry[]          @relation("PayrollCreatedBy")
  incentiveRules        IncentiveRule[]         @relation("IncentiveCreatedBy")

  @@index([email])
  @@index([role])
}

// ── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ── Chart of Accounts ──────────────────────────────────────

model Account {
  id            String        @id @default(cuid())
  accountNumber String        @unique
  accountTitle  String
  accountType   AccountType
  subType       String?
  subSubType    String?       // Sub-sub classification (e.g., PT, OT, ST for inventory types)
  normalBalance NormalBalance
  currency      String        @default("PHP")   // PHP, USD, CNY, EUR, JPY, etc.
  description   String?
  isActive      Boolean       @default(true)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  services              Service[]
  inventoryItems        InventoryItem[] @relation("InventoryRevenueAccount")
  inventorySourceItems  InventoryItem[] @relation("InventorySourceAccount")
  inventoryExpenseItems InventoryItem[] @relation("InventoryExpenseAccount")
  discountSettings      DiscountSetting[]
  wallets               DigitalWallet[] @relation("WalletAccount")
  arPaymentDiscounts    ARPayment[]     @relation("ARPaymentDiscountAccount")
  arPaymentCashAccounts ARPayment[]     @relation("ARPaymentCashAccount")
  unitPaysExpense       UnitPay[]         @relation("UnitPayExpense")
  taxPaymentsFrom       TaxPayment[]      @relation("TaxPaymentFrom")
  taxSettings           PayrollTaxSettings[] @relation("TaxLiability")
  paymentModes          PaymentMode[]           @relation("PaymentModeAccount")
  paymentModeDeductions PaymentModeDeduction[]  @relation("DeductionAccount")

  @@index([accountType])
  @@index([isActive])
  @@index([createdById])
}

// ── Services ───────────────────────────────────────────────

enum ServiceBranch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  ALL
}

enum PriceType {
  FIXED
  ADJUSTABLE
}

enum RevenueType {
  EARNED
  UNEARNED
}

model Service {
  id                    String        @id @default(cuid())
  name                  String
  department            String
  branch                ServiceBranch
  price                 Decimal
  priceType             PriceType     @default(FIXED)
  revenueType           RevenueType   @default(EARNED)
  walletType            String?       // VIP, PACKAGE, PREPAID_CARD, DOWNPAYMENT, ADVANCE — only for UNEARNED
  vipTier               String?       // PLATINUM, GOLD, SILVER — only for VIP type
  packageSessions       Int?          // Number of sessions included (only for PACKAGE type)
  hasDoctorFee          Boolean       @default(false)
  doctorFee             Decimal?
  clinicFee             Decimal?
  pwdDiscountClinicOnly Boolean       @default(false)
  noPwdDiscount         Boolean       @default(false)
  description           String?
  revenueAccountId      String?
  revenueAccount        Account?      @relation(fields: [revenueAccountId], references: [id], onDelete: SetNull)
  unitPayId             String?
  unitPay               UnitPay?      @relation(fields: [unitPayId], references: [id], onDelete: SetNull)
  unitPayEnabled        Boolean       @default(true)
  isActive              Boolean       @default(true)
  createdById           String
  createdBy             User          @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  orderItems          OrderItem[]
  walletDiscountRules WalletDiscountRule[]
  eligibleFor         ServiceEligibility[] @relation("ParentService")
  eligibleIn          ServiceEligibility[] @relation("EligibleService")

  @@index([department])
  @@index([branch])
  @@index([isActive])
  @@index([createdById])
  @@index([revenueAccountId])
  @@index([unitPayId])
}

// Links a package/VIP service to the earned services it covers
model ServiceEligibility {
  id                String   @id @default(cuid())
  parentServiceId   String   // The package or VIP service
  parentService     Service  @relation("ParentService", fields: [parentServiceId], references: [id], onDelete: Cascade)
  eligibleServiceId String   // The earned service that qualifies
  eligibleService   Service  @relation("EligibleService", fields: [eligibleServiceId], references: [id], onDelete: Cascade)
  discountPercent   Decimal? // For VIP: the discount % on this service
  createdAt         DateTime @default(now())

  @@unique([parentServiceId, eligibleServiceId])
  @@index([parentServiceId])
  @@index([eligibleServiceId])
}

// ── Inventory & Procurement ────────────────────────────────

enum AdjustmentType {
  SHRINKAGE
  INCREASE
}

enum TransferStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  RETURNED
  CANCELLED
}

model Supplier {
  id                  String    @id @default(cuid())
  supplierName        String
  email               String?
  contactNumber       String?
  isForeign           Boolean   @default(false)
  currency            String    @default("PHP")
  defaultExchangeRate Decimal?
  address             String?
  notes               String?
  isActive            Boolean   @default(true)
  createdById         String
  createdBy           User      @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inventoryItems InventoryItem[]

  @@index([isActive])
  @@index([createdById])
}

model InventoryItem {
  id                   String    @id @default(cuid())
  name                 String
  sku                  String    @unique
  skuDepartment        String
  skuCategory          String
  skuSubcategory       String
  skuSequence          Int
  barcode              String?
  branch               Branch
  accountSubType       String?
  unitCost             Decimal   @default(0)
  sellingPrice         Decimal?
  rewardPointsPrice    Int?      // Price in reward points (e.g., 1000 pts)
  quantity             Int       @default(0)
  reorderLevel         Int?
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id])
  supplierExchangeRate Decimal?
  revenueAccountId     String?
  revenueAccount       Account?  @relation("InventoryRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: SetNull)
  sourceAccountId      String?
  sourceAccount        Account?  @relation("InventorySourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  expenseAccountId     String?
  expenseAccount       Account?  @relation("InventoryExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  isBundle             Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdById          String
  createdBy            User      @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  adjustments      InventoryAdjustment[]
  consignments     ConsignmentTransfer[]
  orderItems       OrderItem[]
  variants         InventoryVariant[]
  bundleComponents BundleComponent[]     @relation("BundleParent")
  componentOf      BundleComponent[]     @relation("BundleChild")

  @@index([branch])
  @@index([skuDepartment])
  @@index([supplierId])
  @@index([isActive])
  @@index([createdById])
  @@index([isBundle])
  @@index([revenueAccountId])
  @@index([sourceAccountId])
  @@index([expenseAccountId])
}

model BundleComponent {
  id           String        @id @default(cuid())
  bundleId     String
  bundle       InventoryItem @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId  String
  component    InventoryItem @relation("BundleChild", fields: [componentId], references: [id], onDelete: Restrict)
  quantity     Int           @default(1)  // How many of this component per bundle
  createdAt    DateTime      @default(now())

  @@unique([bundleId, componentId])
  @@index([bundleId])
  @@index([componentId])
}

model InventoryVariant {
  id           String        @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variantType  String        @default("Color")  // e.g. "Color", "Size", "Material", "Flavor", "Scent"
  variantLabel String        // e.g. "Red", "Large", "Wood", "Strawberry"
  variantSku   String        @unique  // e.g. "OT-TOY-THE-001-RED"
  barcode      String?       @unique
  quantity     Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([itemId])
  @@index([variantType])
  @@index([variantLabel])
}

model InventoryAdjustment {
  id                String         @id @default(cuid())
  itemId            String
  item              InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type              AdjustmentType
  quantityChange    Int
  remainingQuantity Int?           // FIFO: units still available (INCREASE lots only)
  previousQuantity  Int
  newQuantity       Int
  adjustmentDate    DateTime
  remarks           String
  batchId           String?        // Groups adjustments from same bulk upload
  foreignCost       Decimal?       // Cost per unit in foreign currency
  foreignCurrency   String?        // e.g. CNY, USD
  exchangeRate      Decimal?       // Computed: localTotal / foreignTotal
  localCost         Decimal?       // Cost per unit in PHP (after exchange)
  freightAllocation Decimal?       // Pro-rated freight cost allocated to this item
  totalLandedCost   Decimal?       // localCost * qty + freightAllocation
  adjustedById      String
  adjustedBy        User           @relation("AdjustmentBy", fields: [adjustedById], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())

  @@index([itemId])
  @@index([adjustedById])
  @@index([adjustmentDate])
  @@index([batchId])
}

model ConsignmentTransfer {
  id              String         @id @default(cuid())
  referenceNumber String?        // Groups multiple items in one batch transfer
  itemId          String
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromBranch      Branch
  toBranch        Branch
  quantity        Int
  status          TransferStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  requestedAt     DateTime       @default(now())
  approvedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([itemId])
  @@index([status])
  @@index([fromBranch])
  @@index([toBranch])
  @@index([requestedById])
  @@index([referenceNumber])
}

// ── POS System ─────────────────────────────────────────────

enum OrderType {
  SERVICE
  PRODUCT
}

enum OrderStatus {
  COMPLETED
  REOPENED
  VOIDED
}

enum PaymentMethod {
  CASH
  GCASH
  PAYMAYA
  DEBIT
  CREDIT_CARD
  VIP_CARD
  PREPAID_CARD
  REWARD_POINTS
  SHOPEE
  LAZADA
  TIKTOK
  DOWNPAYMENT
  PACKAGE
  HMO
  GL
}

enum DiscountType {
  NONE
  PWD_SC
  CUSTOM
}

enum WalletAction {
  DEDUCTION
  RELOAD
  REWARD_EARN
  REWARD_SPEND
  AR_PAYMENT
  AR_PAYMENT_REVERSED
}

enum WalletType {
  PACKAGE
  VIP
  PREPAID_CARD
  DOWNPAYMENT
  ADVANCE
  HMO
  GL
}

model Referrer {
  id             String   @id @default(cuid())
  name           String
  affiliation    String?
  specialization String?
  isActive       Boolean  @default(true)
  createdById    String
  createdBy      User     @relation("ReferrerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@index([isActive])
  @@index([createdById])
}

model DigitalWallet {
  id            String      @id @default(cuid())
  patientId     String
  patientName   String
  patientEmail  String?
  barcode       String      @unique
  walletType    WalletType
  vipTier       String?     // PLATINUM, GOLD, SILVER — only for VIP wallets
  balance       Decimal     @default(0)
  rewardPoints  Int         @default(0)
  accountId     String?     // COA account (e.g., Accounts Receivable for HMO/GL)
  account       Account?    @relation("WalletAccount", fields: [accountId], references: [id], onDelete: SetNull)
  attachmentUrl String?     // Uploaded proof (e.g., GL document)
  agency        String?     // GL wallets: issuing agency (e.g., DSWD, PhilHealth, OWWA)
  dateObtained  DateTime?   // Date patient originally obtained the wallet/card
  paymentModeId String?     // How the initial load was paid
  paymentMode   PaymentMode? @relation("WalletPaymentMode", fields: [paymentModeId], references: [id], onDelete: SetNull)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  packages    WalletPackage[]
  logs        WalletLog[]
  payments    OrderPayment[]
  arPayments  ARPayment[]

  @@index([patientId, walletType])
  @@index([patientName])
  @@index([barcode])
  @@index([walletType])
  @@index([accountId])
  @@index([paymentModeId])
}

model WalletPackage {
  id                String        @id @default(cuid())
  walletId          String
  wallet            DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  serviceName       String
  serviceId         String?
  department        String?
  totalSessions     Int
  usedSessions      Int           @default(0)
  amountPaid        Decimal
  purchaseDate      DateTime      @default(now())
  expiresAt         DateTime?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())

  logs WalletLog[]

  @@index([walletId])
  @@index([isActive])
}

model WalletLog {
  id            String        @id @default(cuid())
  walletId      String
  wallet        DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  packageId     String?
  package       WalletPackage? @relation(fields: [packageId], references: [id])
  action        WalletAction
  description   String
  sessions      Int?
  pointsChange  Int?
  balanceBefore Int?
  balanceAfter  Int?
  createdById   String
  createdBy     User          @relation("WalletLogBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())

  @@index([walletId])
  @@index([packageId])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement())
  orderType       OrderType
  branch          String
  patientId       String?
  patientName     String?
  clinicianName   String?
  subtotal        Decimal
  discountAmount  Decimal     @default(0)
  discountType    DiscountType @default(NONE)
  discountLabel   String?
  netAmount       Decimal
  revenueType     String      @default("EARNED")
  queueItemId     String?
  referrerId      String?
  referrer        Referrer?   @relation(fields: [referrerId], references: [id])
  notes                  String?
  issuedOfficialInvoice  Boolean  @default(false)
  salesInvoiceNumber     String?
  status          OrderStatus @default(COMPLETED)
  transactionDate DateTime
  createdById     String
  createdBy       User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items          OrderItem[]
  payments       OrderPayment[]
  arPaymentItems ARPaymentItem[]

  @@index([orderType])
  @@index([branch])
  @@index([status])
  @@index([transactionDate])
  @@index([createdById])
  @@index([referrerId])
  @@index([queueItemId])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  name            String
  quantity        Int            @default(1)
  unitPrice       Decimal
  lineTotal       Decimal
  cogsCost        Decimal?       // FIFO cost of goods sold for this line item
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

model OrderPayment {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal
  walletId      String?
  wallet        DigitalWallet? @relation(fields: [walletId], references: [id])
  reference     String?
  paymentModeId String?        // Configured PaymentMode (carries deduction rules)
  paymentMode   PaymentMode?   @relation("OrderPaymentMode", fields: [paymentModeId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([orderId])
  @@index([method])
  @@index([walletId])
  @@index([paymentModeId])
}

model DiscountSetting {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("PERCENTAGE")
  value       Decimal
  branch      String?
  walletType  String?  // If set, links this discount to a wallet type (VIP, PREPAID_CARD, etc.)
  accountId   String?  // COA account for this discount (REVENUE accounts with DEBIT normal balance = contra-revenue)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("DiscountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules WalletDiscountRule[]

  @@index([isActive])
  @@index([branch])
  @@index([walletType])
  @@index([accountId])
}

model WalletDiscountRule {
  id                String          @id @default(cuid())
  discountSettingId String
  discountSetting   DiscountSetting @relation(fields: [discountSettingId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id])
  department        String?         // e.g. "OT", "SLP", "PT" — applies to all services in dept
  discountPercent   Decimal         // The discount percentage for this service/dept
  createdAt         DateTime        @default(now())

  @@index([discountSettingId])
  @@index([serviceId])
  @@index([department])
}

// ── Payment Mode Settings ─────────────────────────────────

model PaymentMode {
  id            String   @id @default(cuid())
  name          String   // "Cash - SBEA", "GCash", "Credit Card", etc.
  paymentMethod String?  // PaymentMethod enum key: CASH, GCASH, PAYMAYA, DEBIT, CREDIT_CARD, SHOPEE, LAZADA, TIKTOK
  branch        String?  // null = all branches, "SANDBOX_EAST", "SANDBOX_GREENHILLS"
  isActive      Boolean  @default(true)
  accountId     String?  // COA where NET amount is lodged (usually an asset account)
  account       Account? @relation("PaymentModeAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deductions    PaymentModeDeduction[]
  orderPayments OrderPayment[]          @relation("OrderPaymentMode")
  wallets       DigitalWallet[]         @relation("WalletPaymentMode")

  @@index([isActive])
}

model PaymentModeDeduction {
  id            String      @id @default(cuid())
  paymentModeId String
  paymentMode   PaymentMode @relation(fields: [paymentModeId], references: [id], onDelete: Cascade)
  name          String      // "Merchant Discount Rate", "Creditable Withholding Tax"
  rate          Decimal     // percentage — e.g. 2.2 means 2.2%
  accountId     String?     // COA where this deduction is lodged (expense or liability)
  account       Account?    @relation("DeductionAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([paymentModeId])
}

// ── Accounts Receivable Payments ─────────────────────────

model ARPayment {
  id                String        @id @default(cuid())
  walletId          String
  wallet            DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  paymentDate       DateTime
  amount            Decimal
  discount          Decimal       @default(0)
  discountAccountId String?
  discountAccount   Account?      @relation("ARPaymentDiscountAccount", fields: [discountAccountId], references: [id], onDelete: SetNull)
  cashAccountId     String?       // COA account to debit (cash/bank account)
  cashAccount       Account?      @relation("ARPaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  proofUrl          String?       // URL or file path to payment proof
  notes             String?
  branch            String?
  createdById       String
  createdBy         User          @relation("ARPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())

  items ARPaymentItem[]

  @@index([walletId])
  @@index([paymentDate])
  @@index([branch])
  @@index([createdById])
}

model ARPaymentItem {
  id        String    @id @default(cuid())
  paymentId String
  payment   ARPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@index([paymentId])
  @@index([orderId])
}

// ── Payroll ──────────────────────────────────────────────

model Consultant {
  id              String    @id @default(cuid())
  externalStaffId String?   @unique // Marketing site Staff.id
  name            String    // "LASTNAME, FIRSTNAME"
  department      String    // OT, PT, SLP, SPED, MD, PSYCHOLOGY, etc.
  branch          String    // SBEA, SBGH
  taxDeduction    String    @default("NONE") // "FIVE_PERCENT" or "NONE"
  monthlyRetainer Decimal   @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  unitPayRates    ConsultantUnitPay[]
  payrollEntries  PayrollEntry[]

  @@index([department])
  @@index([branch])
  @@index([isActive])
}

model UnitPay {
  id               String   @id @default(cuid())
  name             String   // e.g. "Basic PF", "Assessment PF"
  departments      Json     @default("[]") // JSON array of dept codes, or empty for all
  isActive         Boolean  @default(true)
  expenseAccountId String?
  expenseAccount   Account? @relation("UnitPayExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consultantRates ConsultantUnitPay[]
  services        Service[]

  @@index([isActive])
  @@index([expenseAccountId])
}

model ConsultantUnitPay {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  unitPayId    String
  unitPay      UnitPay    @relation(fields: [unitPayId], references: [id], onDelete: Cascade)
  amount           Decimal    // Per-unit amount for this consultant
  disabled         Boolean    @default(false) // When true, this unit pay is not applicable for this clinician
  thresholdEnabled Boolean    @default(false)
  thresholdAmount  Decimal?   // Min order netAmount to qualify for full rate
  reducedAmount    Decimal?   // Rate used when order netAmount is below threshold

  @@unique([consultantId, unitPayId])
  @@index([consultantId])
  @@index([unitPayId])
}

// ── Incentive Rules ───────────────────────────────────────────

model IncentiveRule {
  id           String   @id @default(cuid())
  name         String   // e.g. "Daily Patient Threshold Bonus"
  description  String?
  threshold    Int      // Minimum patients per day to trigger (e.g. 7)
  bonusPerUnit Decimal  // Bonus amount per patient when triggered (e.g. 20)
  departments  Json     @default("[]") // JSON array of dept codes; empty = all
  branch       String?  // null = all branches
  isActive     Boolean  @default(true)
  createdById  String
  createdBy    User     @relation("IncentiveCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([branch])
}

model PayrollEntry {
  id              String     @id @default(cuid())
  consultantId    String
  consultant      Consultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  cutoffPeriod    String     // e.g. "2026-03-1" or "2026-03-2"
  branch          String
  items           Json       // [{unitPayName, unitAmount, quantity, lineTotal}]
  grossPay        Decimal
  retainerAmount  Decimal    @default(0)
  taxAmount       Decimal    @default(0)
  netPay          Decimal
  status          String     @default("DRAFT") // DRAFT, FINAL
  taxRemitted     Boolean    @default(false)
  createdById     String
  createdBy       User       @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  taxPaymentEntries TaxPaymentEntry[]

  @@unique([consultantId, cutoffPeriod, branch])
  @@index([consultantId])
  @@index([cutoffPeriod])
  @@index([branch])
  @@index([status])
  @@index([taxRemitted])
}

model TaxPayment {
  id            String   @id @default(cuid())
  paymentDate   DateTime
  totalAmount   Decimal
  fromAccountId String
  fromAccount   Account  @relation("TaxPaymentFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  proofUrl      String?
  notes         String?
  paymentType   String   @default("CONSULTANT")
  status        String   @default("COMPLETED")
  createdById   String
  createdAt     DateTime @default(now())

  entries TaxPaymentEntry[]

  @@index([paymentDate])
  @@index([paymentType])
  @@index([createdById])
}

model TaxPaymentEntry {
  id             String       @id @default(cuid())
  taxPaymentId   String
  taxPayment     TaxPayment   @relation(fields: [taxPaymentId], references: [id], onDelete: Cascade)
  payrollEntryId String
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  taxAmount      Decimal

  @@index([taxPaymentId])
  @@index([payrollEntryId])
}

model PayrollTaxSettings {
  id                 String   @id @default(cuid())
  liabilityAccountId String?
  liabilityAccount   Account? @relation("TaxLiability", fields: [liabilityAccountId], references: [id], onDelete: SetNull)
  updatedAt          DateTime @updatedAt
}

// ── Employee Payroll ──────────────────────────────────────

enum RateType {
  DAILY
  MONTHLY
}

enum EmployeeRequestType {
  LEAVE
  OVERTIME
  UNDERTIME
  CHANGE_SCHEDULE
  CERTIFICATE_OF_EMPLOYMENT
}

enum LeaveType {
  VACATION
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  BEREAVEMENT
  UNPAID
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum TimekeepingSource {
  BIOMETRIC
  MANUAL
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

enum PayslipStatus {
  DRAFT
  FINAL
}

model Employee {
  id                String    @id @default(cuid())
  externalStaffId   String?   @unique  // Marketing site Staff.id (from Administration dept)
  employeeBioId     Int?      @unique  // Biometric device ID (column 1 in .dat file)
  firstName         String
  lastName          String
  email             String?
  department        String              // ADMIN, OPERATIONS, etc.
  branch            String              // SBEA, SBGH
  jobTitle          String?
  rateType          RateType  @default(DAILY)
  dailyRate         Decimal   @default(0)
  monthlyRate       Decimal   @default(0)
  sssNumber         String?
  philhealthNumber  String?
  pagibigNumber     String?
  tinNumber         String?
  dateHired         DateTime?
  regularizationDate DateTime?
  scheduleIn        String    @default("08:00")  // Default clock-in time HH:mm
  scheduleOut       String    @default("17:00")  // Default clock-out time HH:mm
  restDay           String    @default("SUNDAY") // e.g. "SUNDAY", "SATURDAY"
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  timekeepingRecords TimekeepingRecord[]
  requests           EmployeeRequest[]
  benefits           EmployeeBenefit[]
  payslips           EmployeePayslip[]

  @@index([branch])
  @@index([department])
  @@index([isActive])
  @@index([employeeBioId])
}

model EmployeeSettings {
  id                  String   @id @default(cuid())
  // Cutoff configuration
  cutoff1Start        Int      @default(1)    // Day of month for 1st cutoff start
  cutoff1End          Int      @default(15)   // Day of month for 1st cutoff end
  cutoff2Start        Int      @default(16)   // Day of month for 2nd cutoff start
  cutoff2EndLastDay   Boolean  @default(true) // true = use last day of month
  cutoff2End          Int      @default(30)   // Day if not using last day
  // Work hours
  standardHoursPerDay Decimal  @default(8)
  overtimeMultiplier  Decimal  @default(1.25) // Regular OT = 125%
  nightDiffMultiplier Decimal  @default(0.10) // 10% additional for 10pm-6am
  // Holiday multipliers (DOLE Philippines)
  regularHolidayRate      Decimal @default(2.0)  // 200% of daily rate
  specialHolidayRate      Decimal @default(1.3)  // 130% of daily rate
  regularHolidayOTRate    Decimal @default(2.6)  // 260% for OT on regular holiday
  specialHolidayOTRate    Decimal @default(1.69) // 169% for OT on special holiday
  restDayRate             Decimal @default(1.3)  // 130% for rest day
  restDayRegHolidayRate   Decimal @default(2.6)  // 260% for rest day + regular holiday
  restDaySpecHolidayRate  Decimal @default(1.5)  // 150% for rest day + special holiday
  // Deduction toggles
  sssEnabled          Boolean  @default(true)
  philhealthEnabled   Boolean  @default(true)
  pagibigEnabled      Boolean  @default(true)
  taxEnabled          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model EmployeeRequest {
  id           String              @id @default(cuid())
  employeeId   String
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestType  EmployeeRequestType
  leaveType    LeaveType?          // Only for LEAVE requests
  startDate    DateTime?
  endDate      DateTime?
  reason       String?
  attachment   String?             // File URL for supporting docs
  status       RequestStatus       @default(PENDING)
  reviewedById String?
  reviewNotes  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([requestType])
  @@index([startDate])
}

model TimekeepingUpload {
  id           String   @id @default(cuid())
  fileName     String
  uploadDate   DateTime @default(now())
  recordCount  Int      @default(0)
  branch       String?
  uploadedById String
  createdAt    DateTime @default(now())

  records TimekeepingRecord[]

  @@index([uploadDate])
  @@index([branch])
}

model TimekeepingRecord {
  id         String            @id @default(cuid())
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadId   String?
  upload     TimekeepingUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  date       DateTime          // The calendar date
  timeIn     DateTime?         // Clock-in timestamp
  timeOut    DateTime?         // Clock-out timestamp
  hoursWorked Decimal?         // Computed hours
  lateMinutes Int      @default(0)
  undertimeMinutes Int @default(0)
  overtimeMinutes  Int @default(0)
  isRestDay  Boolean   @default(false)
  isHoliday  Boolean   @default(false)
  holidayType String?  // REGULAR, SPECIAL_NON_WORKING, SPECIAL_WORKING
  source     TimekeepingSource @default(BIOMETRIC)
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([uploadId])
}

model EmployeeBenefit {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefitType     String   // SSS, PHILHEALTH, PAGIBIG, TAX
  employeeShare   Decimal  @default(0)  // Employee's monthly contribution
  employerShare   Decimal  @default(0)  // Employer's monthly contribution
  effectiveDate   DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([benefitType])
  @@index([isActive])
}

model Holiday {
  id          String      @id @default(cuid())
  name        String
  date        DateTime
  holidayType HolidayType
  branch      String?     // null = all branches
  isRecurring Boolean     @default(false)  // Repeats yearly
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([date, branch])
  @@index([date])
  @@index([holidayType])
}

model EmployeePayslip {
  id               String       @id @default(cuid())
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cutoffPeriod     String       // e.g. "2026-03-1" or "2026-03-2"
  branch           String
  // Earnings
  basicPay         Decimal      @default(0)
  overtimePay      Decimal      @default(0)
  holidayPay       Decimal      @default(0)
  nightDiffPay     Decimal      @default(0)
  restDayPay       Decimal      @default(0)
  allowances       Decimal      @default(0)
  grossPay         Decimal      @default(0)
  // Deductions
  sssDeduction     Decimal      @default(0)
  philhealthDeduction Decimal   @default(0)
  pagibigDeduction Decimal      @default(0)
  taxDeduction     Decimal      @default(0)
  lateDeduction    Decimal      @default(0)
  undertimeDeduction Decimal    @default(0)
  otherDeductions  Decimal      @default(0)
  totalDeductions  Decimal      @default(0)
  // Net
  netPay           Decimal      @default(0)
  // Details
  daysWorked       Decimal      @default(0)
  hoursWorked      Decimal      @default(0)
  overtimeHours    Decimal      @default(0)
  lateMinutes      Int          @default(0)
  undertimeMinutes Int          @default(0)
  details          Json?        // Additional breakdown data
  status           PayslipStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([employeeId, cutoffPeriod, branch])
  @@index([employeeId])
  @@index([cutoffPeriod])
  @@index([branch])
  @@index([status])
}
