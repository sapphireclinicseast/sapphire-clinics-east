generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  ACCOUNTANT
  VIEWER
  SBEA_ADMIN
  SBGH_ADMIN
  VERDANA_ADMIN
  SBEA_FRONTDESK
  SBGH_FRONTDESK
}

enum Branch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  VERDANA_STORE
  ALL
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// ── User ─────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(VIEWER)
  branch           Branch?
  avatar           String?
  resetToken       String?
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AuditLog[]
  accounts  Account[]

  servicesCreated       Service[]               @relation("ServiceCreatedBy")
  suppliersCreated      Supplier[]              @relation("SupplierCreatedBy")
  inventoryItems        InventoryItem[]         @relation("ItemCreatedBy")
  inventoryAdjustments  InventoryAdjustment[]   @relation("AdjustmentBy")
  transfersRequested    ConsignmentTransfer[]   @relation("TransferRequestedBy")
  transfersApproved     ConsignmentTransfer[]   @relation("TransferApprovedBy")

  referrersCreated      Referrer[]              @relation("ReferrerCreatedBy")
  walletLogs            WalletLog[]             @relation("WalletLogBy")
  ordersCreated         Order[]                 @relation("OrderCreatedBy")
  discountSettings      DiscountSetting[]       @relation("DiscountCreatedBy")

  @@index([email])
  @@index([role])
}

// ── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ── Chart of Accounts ──────────────────────────────────────

model Account {
  id            String        @id @default(cuid())
  accountNumber String        @unique
  accountTitle  String
  accountType   AccountType
  subType       String?
  normalBalance NormalBalance
  currency      String        @default("PHP")   // PHP, USD, CNY, EUR, JPY, etc.
  description   String?
  isActive      Boolean       @default(true)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([accountType])
  @@index([isActive])
  @@index([createdById])
}

// ── Services ───────────────────────────────────────────────

enum ServiceBranch {
  SANDBOX_EAST
  SANDBOX_GREENHILLS
  ALL
}

enum PriceType {
  FIXED
  ADJUSTABLE
}

enum RevenueType {
  EARNED
  UNEARNED
}

model Service {
  id                    String        @id @default(cuid())
  name                  String
  department            String
  branch                ServiceBranch
  price                 Decimal
  priceType             PriceType     @default(FIXED)
  revenueType           RevenueType   @default(EARNED)
  walletType            String?       // VIP, PACKAGE, PREPAID_CARD, DOWNPAYMENT, ADVANCE — only for UNEARNED
  vipTier               String?       // PLATINUM, GOLD, SILVER — only for VIP type
  packageSessions       Int?          // Number of sessions included (only for PACKAGE type)
  hasDoctorFee          Boolean       @default(false)
  doctorFee             Decimal?
  clinicFee             Decimal?
  pwdDiscountClinicOnly Boolean       @default(false)
  description           String?
  isActive              Boolean       @default(true)
  createdById           String
  createdBy             User          @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  orderItems          OrderItem[]
  walletDiscountRules WalletDiscountRule[]
  eligibleFor         ServiceEligibility[] @relation("ParentService")
  eligibleIn          ServiceEligibility[] @relation("EligibleService")

  @@index([department])
  @@index([branch])
  @@index([isActive])
  @@index([createdById])
}

// Links a package/VIP service to the earned services it covers
model ServiceEligibility {
  id                String   @id @default(cuid())
  parentServiceId   String   // The package or VIP service
  parentService     Service  @relation("ParentService", fields: [parentServiceId], references: [id], onDelete: Cascade)
  eligibleServiceId String   // The earned service that qualifies
  eligibleService   Service  @relation("EligibleService", fields: [eligibleServiceId], references: [id], onDelete: Cascade)
  discountPercent   Decimal? // For VIP: the discount % on this service
  createdAt         DateTime @default(now())

  @@unique([parentServiceId, eligibleServiceId])
  @@index([parentServiceId])
  @@index([eligibleServiceId])
}

// ── Inventory & Procurement ────────────────────────────────

enum AdjustmentType {
  SHRINKAGE
  INCREASE
}

enum TransferStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  RETURNED
  CANCELLED
}

model Supplier {
  id                  String    @id @default(cuid())
  supplierName        String
  email               String?
  contactNumber       String?
  isForeign           Boolean   @default(false)
  currency            String    @default("PHP")
  defaultExchangeRate Decimal?
  address             String?
  notes               String?
  isActive            Boolean   @default(true)
  createdById         String
  createdBy           User      @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inventoryItems InventoryItem[]

  @@index([isActive])
  @@index([createdById])
}

model InventoryItem {
  id                   String    @id @default(cuid())
  name                 String
  sku                  String    @unique
  skuDepartment        String
  skuCategory          String
  skuSubcategory       String
  skuSequence          Int
  barcode              String?
  branch               Branch
  accountSubType       String?
  unitCost             Decimal   @default(0)
  sellingPrice         Decimal?
  rewardPointsPrice    Int?      // Price in reward points (e.g., 1000 pts)
  quantity             Int       @default(0)
  reorderLevel         Int?
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id])
  supplierExchangeRate Decimal?
  isBundle             Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdById          String
  createdBy            User      @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  adjustments      InventoryAdjustment[]
  consignments     ConsignmentTransfer[]
  orderItems       OrderItem[]
  variants         InventoryVariant[]
  bundleComponents BundleComponent[]     @relation("BundleParent")
  componentOf      BundleComponent[]     @relation("BundleChild")

  @@index([branch])
  @@index([skuDepartment])
  @@index([supplierId])
  @@index([isActive])
  @@index([createdById])
  @@index([isBundle])
}

model BundleComponent {
  id           String        @id @default(cuid())
  bundleId     String
  bundle       InventoryItem @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  componentId  String
  component    InventoryItem @relation("BundleChild", fields: [componentId], references: [id], onDelete: Restrict)
  quantity     Int           @default(1)  // How many of this component per bundle
  createdAt    DateTime      @default(now())

  @@unique([bundleId, componentId])
  @@index([bundleId])
  @@index([componentId])
}

model InventoryVariant {
  id           String        @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variantType  String        @default("Color")  // e.g. "Color", "Size", "Material", "Flavor", "Scent"
  variantLabel String        // e.g. "Red", "Large", "Wood", "Strawberry"
  variantSku   String        @unique  // e.g. "OT-TOY-THE-001-RED"
  barcode      String?       @unique
  quantity     Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([itemId])
  @@index([variantType])
  @@index([variantLabel])
}

model InventoryAdjustment {
  id               String         @id @default(cuid())
  itemId           String
  item             InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type             AdjustmentType
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  adjustmentDate   DateTime
  remarks          String
  batchId          String?        // Groups adjustments from same bulk upload
  foreignCost      Decimal?       // Cost per unit in foreign currency
  foreignCurrency  String?        // e.g. CNY, USD
  exchangeRate     Decimal?       // Computed: localTotal / foreignTotal
  localCost        Decimal?       // Cost per unit in PHP (after exchange)
  freightAllocation Decimal?      // Pro-rated freight cost allocated to this item
  totalLandedCost  Decimal?       // localCost * qty + freightAllocation
  adjustedById     String
  adjustedBy       User           @relation("AdjustmentBy", fields: [adjustedById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([itemId])
  @@index([adjustedById])
  @@index([adjustmentDate])
  @@index([batchId])
}

model ConsignmentTransfer {
  id              String         @id @default(cuid())
  referenceNumber String?        // Groups multiple items in one batch transfer
  itemId          String
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromBranch      Branch
  toBranch        Branch
  quantity        Int
  status          TransferStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  requestedAt     DateTime       @default(now())
  approvedAt      DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([itemId])
  @@index([status])
  @@index([fromBranch])
  @@index([toBranch])
  @@index([requestedById])
  @@index([referenceNumber])
}

// ── POS System ─────────────────────────────────────────────

enum OrderType {
  SERVICE
  PRODUCT
}

enum OrderStatus {
  COMPLETED
  REOPENED
  VOIDED
}

enum PaymentMethod {
  CASH
  GCASH
  PAYMAYA
  DEBIT
  CREDIT_CARD
  VIP_CARD
  PREPAID_CARD
  REWARD_POINTS
  SHOPEE
  LAZADA
  TIKTOK
  DOWNPAYMENT
  PACKAGE
  HMO
  GL
}

enum DiscountType {
  NONE
  PWD_SC
  CUSTOM
}

enum WalletAction {
  DEDUCTION
  RELOAD
  REWARD_EARN
  REWARD_SPEND
}

enum WalletType {
  PACKAGE
  VIP
  PREPAID_CARD
  DOWNPAYMENT
  ADVANCE
  HMO
  GL
}

model Referrer {
  id             String   @id @default(cuid())
  name           String
  affiliation    String?
  specialization String?
  isActive       Boolean  @default(true)
  createdById    String
  createdBy      User     @relation("ReferrerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@index([isActive])
  @@index([createdById])
}

model DigitalWallet {
  id           String     @id @default(cuid())
  patientId    String
  patientName  String
  patientEmail String?
  barcode      String     @unique
  walletType   WalletType
  vipTier      String?    // PLATINUM, GOLD, SILVER — only for VIP wallets
  balance      Decimal    @default(0)
  rewardPoints Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  packages WalletPackage[]
  logs     WalletLog[]
  payments OrderPayment[]

  @@unique([patientId, walletType])
  @@index([patientName])
  @@index([barcode])
  @@index([walletType])
}

model WalletPackage {
  id                String        @id @default(cuid())
  walletId          String
  wallet            DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  serviceName       String
  serviceId         String?
  department        String?
  totalSessions     Int
  usedSessions      Int           @default(0)
  amountPaid        Decimal
  purchaseDate      DateTime      @default(now())
  expiresAt         DateTime?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())

  logs WalletLog[]

  @@index([walletId])
  @@index([isActive])
}

model WalletLog {
  id            String        @id @default(cuid())
  walletId      String
  wallet        DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  packageId     String?
  package       WalletPackage? @relation(fields: [packageId], references: [id])
  action        WalletAction
  description   String
  sessions      Int?
  pointsChange  Int?
  balanceBefore Int?
  balanceAfter  Int?
  createdById   String
  createdBy     User          @relation("WalletLogBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())

  @@index([walletId])
  @@index([packageId])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement())
  orderType       OrderType
  branch          String
  patientId       String?
  patientName     String?
  clinicianName   String?
  subtotal        Decimal
  discountAmount  Decimal     @default(0)
  discountType    DiscountType @default(NONE)
  discountLabel   String?
  netAmount       Decimal
  revenueType     String      @default("EARNED")
  queueItemId     String?
  referrerId      String?
  referrer        Referrer?   @relation(fields: [referrerId], references: [id])
  notes           String?
  status          OrderStatus @default(COMPLETED)
  transactionDate DateTime
  createdById     String
  createdBy       User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  payments OrderPayment[]

  @@index([orderType])
  @@index([branch])
  @@index([status])
  @@index([transactionDate])
  @@index([createdById])
  @@index([referrerId])
  @@index([queueItemId])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  name            String
  quantity        Int            @default(1)
  unitPrice       Decimal
  lineTotal       Decimal
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

model OrderPayment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal
  walletId  String?
  wallet    DigitalWallet? @relation(fields: [walletId], references: [id])
  reference String?
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([method])
  @@index([walletId])
}

model DiscountSetting {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("PERCENTAGE")
  value       Decimal
  branch      String?
  walletType  String?  // If set, links this discount to a wallet type (VIP, PREPAID_CARD, etc.)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("DiscountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules WalletDiscountRule[]

  @@index([isActive])
  @@index([branch])
  @@index([walletType])
}

model WalletDiscountRule {
  id                String          @id @default(cuid())
  discountSettingId String
  discountSetting   DiscountSetting @relation(fields: [discountSettingId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id])
  department        String?         // e.g. "OT", "SLP", "PT" — applies to all services in dept
  discountPercent   Decimal         // The discount percentage for this service/dept
  createdAt         DateTime        @default(now())

  @@index([discountSettingId])
  @@index([serviceId])
  @@index([department])
}
