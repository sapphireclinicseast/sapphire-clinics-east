{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sapphire-marketing-hub",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "accounting-hub",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd accounting-hub && npm run dev -- --port 3001"],
      "port": 3001
    },
    {
      "name": "verdana-store",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd verdana-store && npm run dev"],
      "port": 3002
    }
  ]
}
